{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",

  // Storage provider: "InMemory" | "SqlServer" | "PostgreSql"
  "StorageProvider": "PostgreSql",

  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=HangfireTest;Integrated Security=true;TrustServerCertificate=true;",
    "PostgreSql": "Host=localhost;Port=5432;Database=hangfire_test;Username=postgres;Password=12345;"
  }
}
