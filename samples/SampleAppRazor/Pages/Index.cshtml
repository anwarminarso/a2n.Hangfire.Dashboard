@page
@model SampleAppRazor.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SampleApp - Razor Pages</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<div class="container py-5">
    <h1 class="mb-3">SampleApp — Razor Pages</h1>
    <p class="text-muted mb-4">
        This sample demonstrates <code>a2n.Hangfire.Dashboard</code> running inside a standard ASP.NET Razor Pages application.
    </p>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Hangfire Dashboard</strong>
        </div>
        <div class="card-body">
            <a href="/hangfire" class="btn btn-primary" target="_blank">Open Dashboard</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Enqueue Background Jobs</strong>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @Model.Message
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" class="d-flex flex-wrap gap-2">
                <button type="submit" asp-page-handler="SimpleJob" class="btn btn-outline-primary">
                    Simple Job
                </button>
                <button type="submit" asp-page-handler="ConsoleJob" class="btn btn-outline-primary">
                    Console Job
                </button>
                <button type="submit" asp-page-handler="TaggedJob" class="btn btn-outline-primary">
                    Tagged Job
                </button>
                <button type="submit" asp-page-handler="FailingJob" class="btn btn-outline-danger">
                    Failing Job
                </button>
                <button type="submit" asp-page-handler="LongRunningJob" class="btn btn-outline-warning">
                    Long Running Job
                </button>
            </form>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
