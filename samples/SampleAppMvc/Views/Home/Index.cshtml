@{
    ViewData["Title"] = "Home";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SampleApp - MVC</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
<div class="container py-5">
    <h1 class="mb-3">SampleApp — ASP.NET MVC</h1>
    <p class="text-muted mb-4">
        This sample demonstrates <code>a2n.Hangfire.Dashboard</code> running inside a standard ASP.NET MVC application.
    </p>

    <div class="card mb-4">
        <div class="card-header">
            <strong>Hangfire Dashboard</strong>
        </div>
        <div class="card-body">
            <a href="/hangfire" class="btn btn-primary" target="_blank">Open Dashboard</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <strong>Enqueue Background Jobs</strong>
        </div>
        <div class="card-body">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="d-flex flex-wrap gap-2">
                <form method="post" asp-controller="Home" asp-action="EnqueueSimpleJob">
                    <button type="submit" class="btn btn-outline-primary">Simple Job</button>
                </form>
                <form method="post" asp-controller="Home" asp-action="EnqueueConsoleJob">
                    <button type="submit" class="btn btn-outline-primary">Console Job</button>
                </form>
                <form method="post" asp-controller="Home" asp-action="EnqueueTaggedJob">
                    <button type="submit" class="btn btn-outline-primary">Tagged Job</button>
                </form>
                <form method="post" asp-controller="Home" asp-action="EnqueueFailingJob">
                    <button type="submit" class="btn btn-outline-danger">Failing Job</button>
                </form>
                <form method="post" asp-controller="Home" asp-action="EnqueueLongRunningJob">
                    <button type="submit" class="btn btn-outline-warning">Long Running Job</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
