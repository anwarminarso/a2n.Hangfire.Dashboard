{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "StorageProvider": "InMemory",
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=HangfireTest;Integrated Security=true;TrustServerCertificate=true;",
    "PostgreSql": "Host=localhost;Port=5432;Database=hangfire_test;Username=postgres;Password=<your-password>"
  }
}
