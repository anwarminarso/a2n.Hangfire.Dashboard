<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- bunit 1.40 calls IHtmlCollection<T>.get_Item(int), which AngleSharp dropped from its
         net8+ builds in 1.4. bunit 2 is built against AngleSharp 1.8, so the pin both clears
         GHSA-pgww-w46g-26qg (vulnerable: < 1.5.0, which bunit 1 resolved as 1.2.0) and matches
         the test library. -->
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Hangfire.Core" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <!-- Cronos is ILMerged into Hangfire.Core, so the test needs a direct reference to compute the
         next-occurrence oracle for the CronPreview property tests (Property 18, Req 10.5/10.6). -->
    <PackageReference Include="Cronos" />
    <PackageReference Include="FsCheck.Xunit" />
    <PackageReference Include="Hangfire.InMemory" />
    <!-- FakeTimeProvider, so the refresh-loop tests (issue #64) step through intervals and back-off
         deterministically instead of sleeping. Test-only; the dashboard uses TimeProvider.System. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- In-memory ASP.NET Core pipeline host for the heatmap authorization integration test
         (task 21.2). Version is matched to each target framework's shared framework. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\a2n.Hangfire.Dashboard\a2n.Hangfire.Dashboard.csproj" />
    <!-- Storage adapters are referenced so their IStorageMetricsProvider implementations can be
         exercised by the DB integration tests (task 13.7). These bring Dapper / Microsoft.Data.SqlClient
         / Npgsql in transitively. The integration tests skip gracefully when no DB is configured, so
         this reference does not require a live database for the suite to build and pass in CI. -->
    <ProjectReference Include="..\..\src\a2n.Hangfire.Dashboard.SqlServer\a2n.Hangfire.Dashboard.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\a2n.Hangfire.Dashboard.PostgreSql\a2n.Hangfire.Dashboard.PostgreSql.csproj" />
  </ItemGroup>

</Project>
