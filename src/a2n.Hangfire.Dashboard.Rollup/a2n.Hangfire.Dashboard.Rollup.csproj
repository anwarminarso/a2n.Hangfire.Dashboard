<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>a2n.Hangfire.Dashboard.Rollup</RootNamespace>
    <PackageId>a2n.Hangfire.Dashboard.Rollup</PackageId>
    <Description>Rollup-based metrics adapter for a2n.Hangfire.Dashboard. Enables analytics and heatmap historical data on non-SQL Hangfire storages (Redis, in-memory, and other NoSQL backends) by incrementally aggregating execution metrics into storage-agnostic Hash/Set primitives.</Description>
    <PackageTags>hangfire;dashboard;rollup;metrics;redis;analytics;storage;aspnetcore;dotnet</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\a2n.Hangfire.Dashboard\a2n.Hangfire.Dashboard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="a2n.Hangfire.Dashboard.Rollup.Tests" />
    <None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
  </ItemGroup>
</Project>
