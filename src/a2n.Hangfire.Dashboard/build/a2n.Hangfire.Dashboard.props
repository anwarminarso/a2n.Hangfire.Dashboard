<Project>
  <!-- 
    This props file is automatically imported by consuming projects:
    - Via NuGet: through buildTransitive mechanism
    - Via ProjectReference: through Directory.Build.props or explicit import
    
    It sets RequiresAspNetWebAssets for the host's build. On .NET 10 that alone does NOT bring
    blazor.web.js into a host without .razor files: the script's package is chosen at restore, and
    NuGet doesn't import package props during restore (ExcludeRestorePackageImports). That's why
    the net10.0 build of the dashboard carries its own copy (see the csproj and
    FrameworkScriptMiddleware). A host that sets the property in its own .csproj gets its own copy.
  -->
  <PropertyGroup Condition="'$(UsingMicrosoftNETSdkWeb)' == 'true'">
    <RequiresAspNetWebAssets Condition="'$(RequiresAspNetWebAssets)' == ''">true</RequiresAspNetWebAssets>
  </PropertyGroup>
</Project>
