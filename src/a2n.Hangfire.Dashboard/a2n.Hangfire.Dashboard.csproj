<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>a2n.Hangfire.Dashboard</RootNamespace>
    <StaticWebAssetsEnabled>true</StaticWebAssetsEnabled>

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- NuGet metadata -->
    <PackageId>a2n.Hangfire.Dashboard</PackageId>
    <Description>A modern, open-source alternative dashboard for Hangfire. Built with Blazor Server, Bootstrap 5, Chart.js, and SignalR. Features realtime monitoring, global search with advanced filters, console log viewer, tag management, recurring job CRUD, dark/light theme, and responsive design. Drop-in replacement — zero code changes required.</Description>
    <PackageTags>hangfire;dashboard;blazor;monitoring;background-jobs;realtime;signalr;search;console;tags;recurring-jobs;bootstrap;chartjs;dark-mode;aspnetcore;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <InternalsVisibleTo Include="a2n.Hangfire.Dashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.*" />
    <!-- Cronos is ILMerged (internalized) into Hangfire.Core, so a direct reference is required to
         use its public API for cron parsing and next-occurrence previews (Job Builder schedule). -->
    <PackageReference Include="Cronos" Version="0.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.*" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\a2n.Hangfire.Console\a2n.Hangfire.Console.csproj" />
    <ProjectReference Include="..\a2n.Hangfire.Tags\a2n.Hangfire.Tags.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- All static assets embedded in the DLL -->
    <EmbeddedResource Include="Content\**\*" />
  </ItemGroup>

  <!--
    .NET 10 only: a fallback copy of _framework/blazor.web.js.
    In .NET 10 the Blazor script is no longer embedded in the framework; it comes from the
    Microsoft.AspNetCore.App.Internal.Assets package, which the SDK only restores for a host that
    has a .razor file or sets RequiresAspNetWebAssets. A package's props can't set that in time
    (NuGet doesn't import package props during restore), so a plain web host gets no script and the
    dashboard never goes interactive. FrameworkScriptMiddleware serves this copy only when the host
    doesn't serve its own. net8.0 and net9.0 don't need it (the script is embedded in their
    framework) and don't get it.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <BlazorWebScriptPackageVersion>10.0.12</BlazorWebScriptPackageVersion>
    <BlazorWebScriptPath>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))microsoft.aspnetcore.app.internal.assets/$(BlazorWebScriptPackageVersion)/_framework/blazor.web.js</BlazorWebScriptPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageDownload Include="Microsoft.AspNetCore.App.Internal.Assets" Version="[$(BlazorWebScriptPackageVersion)]" />
    <EmbeddedResource Include="$(BlazorWebScriptPath)" LogicalName="a2n.Hangfire.Dashboard.Framework.blazor.web.js"
                      Condition="Exists('$(BlazorWebScriptPath)')" />
    <AssemblyMetadata Include="BundledBlazorWebScriptVersion" Value="$(BlazorWebScriptPackageVersion)" />
  </ItemGroup>
  <!-- Fail the build rather than ship a net10.0 assembly without the fallback copy. -->
  <Target Name="EnsureBundledBlazorWebScript" BeforeTargets="CoreCompile"
          Condition="'$(TargetFramework)' == 'net10.0' and !Exists('$(BlazorWebScriptPath)')">
    <Error Text="The bundled blazor.web.js wasn't found at $(BlazorWebScriptPath). Restore the project (it downloads Microsoft.AspNetCore.App.Internal.Assets $(BlazorWebScriptPackageVersion))." />
  </Target>

  <!-- Include build props/targets in NuGet package for consumer projects -->
  <ItemGroup>
    <None Include="build\a2n.Hangfire.Dashboard.props" Pack="true" PackagePath="build\" />
    <None Include="build\a2n.Hangfire.Dashboard.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
