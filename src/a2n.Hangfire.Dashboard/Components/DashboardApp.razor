@attribute [System.ComponentModel.EditorBrowsable(System.ComponentModel.EditorBrowsableState.Never)]
@using a2n.Hangfire.Dashboard.Security
@using Microsoft.Extensions.Logging
@inject IHttpContextAccessor HttpContextAccessor
@inject DashboardUIOptions Options
@inject DashboardPermissionsState PermissionsState
@inject ILoggerFactory LoggerFactory

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@GetBaseHref()" />
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="_content/lib/bootstrap/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="_content/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <!-- Custom overrides (console viewer, charts) -->
    <link rel="stylesheet" href="_content/css/app.css?v=@V" />
    <link rel="icon" href="@GetFaviconHref()" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <script src="_content/js/theme.js?v=@V"></script>
    <script src="_content/js/prefs.js?v=@V"></script>
    <script src="_content/js/nav.js?v=@V"></script>
    <script src="_content/js/moment.min.js"></script>
    <script src="_content/js/chart.umd.min.js"></script>
    <script src="_content/js/chartjs-adapter-moment.min.js"></script>
    <script src="_content/js/chartjs-plugin-streaming.min.js"></script>
    <script src="_content/js/charts.js?v=@V"></script>
    <script src="_content/js/analyticsCharts.js?v=@V"></script>
    <script src="_content/js/heatmap.js?v=@V"></script>
    <script src="_content/js/search-presets.js?v=@V"></script>
    <DashboardRoutes Permissions="_permissions" @rendermode="PageRenderMode" />
    <script src="_content/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    private static readonly string V = typeof(DashboardApp).Assembly
        .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
        .OfType<System.Reflection.AssemblyInformationalVersionAttribute>()
        .FirstOrDefault()?.InformationalVersion
        ?? typeof(DashboardApp).Assembly.GetName().Version?.ToString()
        ?? "0.0.0";

    private static readonly IComponentRenderMode InteractiveServerNoPrerender =
        new InteractiveServerRenderMode(prerender: false);

    private IComponentRenderMode PageRenderMode =>
        Options.EnablePrerendering ? InteractiveServer : InteractiveServerNoPrerender;

    /// <summary>The request that renders this page. Set during the static render only.</summary>
    [CascadingParameter]
    private HttpContext HttpContext { get; set; }

    private DashboardPermissions _permissions;

    protected override void OnInitialized()
    {
        // The one place the permissions are evaluated: once per page load, from the request.
        // The prerender pass shares this scope; the circuit gets them as a DashboardRoutes parameter.
        _permissions = DashboardPermissionEvaluator.Evaluate(
            HttpContext ?? HttpContextAccessor?.HttpContext,
            Options,
            LoggerFactory.CreateLogger(DashboardPermissionEvaluator.LoggerCategory));
        PermissionsState.Initialize(_permissions);
    }

    private string GetBaseHref()
    {
        var pathBase = HttpContextAccessor?.HttpContext?.Request.PathBase.Value;
        if (string.IsNullOrEmpty(pathBase))
            return "/";
        return pathBase.TrimEnd('/') + "/";
    }

    private string GetFaviconHref()
    {
        if (!string.IsNullOrEmpty(Options.FaviconPath))
        {
            return Options.FaviconPath;
        }
        // Default: point to host app's root favicon so it inherits the host's icon
        return "/favicon.ico";
    }
}
