@page "/jobs/processing"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Processing Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Processing Jobs</h2>

    @if (_jobs is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_jobs.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">⚙️</span>
            <p>No jobs are being processed right now.</p>
        </div>
    }
    else
    {
        <div class="section-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Server</th>
                        <th>Job</th>
                        <th>Started</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td class="font-mono"><a href="/jobs/details/@job.Key" class="job-id-link">@ShortenId(job.Key)</a></td>
                            <td class="font-mono">@(job.Value?.ServerId ?? "N/A")</td>
                            <td>@GetJobName(job.Value)</td>
                            <td>
                                @if (job.Value?.StartedAt.HasValue == true)
                                {
                                    <RelativeTime UtcTime="@job.Value.StartedAt.Value" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-info">
            Showing @_jobs.Count of @_totalCount jobs
        </div>
    }
</div>

@code {
    private JobList<ProcessingJobDto>? _jobs;
    private long _totalCount;
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var newCount = Monitor.GetProcessingCount();
                if (newCount != _totalCount || newCount > 0)
                {
                    var jobs = Monitor.GetProcessingJobs(0, 20);
                    await InvokeAsync(() =>
                    {
                        _totalCount = newCount;
                        _jobs = jobs;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetProcessingCount();
            _jobs = Monitor.GetProcessingJobs(0, 20);
        });
    }

    private static string ShortenId(string id)
    {
        if (Guid.TryParse(id, out _))
            return id[..8] + "…";
        return $"#{id}";
    }

    private static string GetJobName(ProcessingJobDto? dto)
    {
        if (dto?.Job is null) return "Unknown";
        return $"{dto.Job.Type.Name}.{dto.Job.Method.Name}";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
