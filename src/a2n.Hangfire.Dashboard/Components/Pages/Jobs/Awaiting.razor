@page "/jobs/awaiting"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Awaiting Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Awaiting Jobs</h2>

    @if (_jobIds is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_jobIds.Count == 0)
    {
        <div class="card text-center py-5">
            <span class="fs-1">⏳</span>
            <p class="mt-2 mb-0">No awaiting jobs.</p>
            <p class="text-body-secondary">Jobs waiting for parent continuations to complete.</p>
        </div>
    }
    else
    {
        <div class="d-flex gap-2 mb-2">
            <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="EnqueueSelected">
                <i class="bi bi-play-fill"></i> Enqueue
            </button>
            <button class="btn btn-danger btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 2rem;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                                <th>Id</th>
                                <th>Job</th>
                                <th>Parent</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var jobId in _jobIds)
                            {
                                _jobInfo.TryGetValue(jobId, out var info);
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@IsSelected(jobId)" @onchange="() => ToggleJob(jobId)" />
                                    </td>
                                    <td class="font-monospace">
                                        <a href="/jobs/details/@jobId">@ShortenId(jobId)</a>
                                    </td>
                                    <td>@(info.jobName ?? "Unknown")</td>
                                    <td class="font-monospace">
                                        @if (!string.IsNullOrEmpty(info.parentId))
                                        {
                                            <a href="/jobs/details/@info.parentId">@ShortenId(info.parentId)</a>
                                        }
                                        else
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                    </td>
                                    <td><span class="badge bg-secondary">@(info.state ?? "Awaiting")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="text-body-secondary mt-2">@_jobIds.Count awaiting jobs</div>
    }
</div>

@code {
    private IReadOnlyList<string> _jobIds;
    private Dictionary<string, (string jobName, string state, string parentId)> _jobInfo = new();
    private HashSet<string> _selectedJobs = new();
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var newIds = Monitor.GetSetJobIds("awaiting", 0, 50);
                if (newIds.Count != (_jobIds?.Count ?? 0))
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _jobIds = Monitor.GetSetJobIds("awaiting", 0, 50);
            _jobInfo.Clear();
            if (_jobIds is not null)
            {
                foreach (var jobId in _jobIds)
                {
                    var detail = Monitor.GetJobDetails(jobId);
                    var jobName = detail?.Job is not null ? $"{detail.Job.Type.Name}.{detail.Job.Method.Name}" : null;
                    var state = detail?.History.FirstOrDefault()?.StateName;
                    string parentId = null;
                    detail?.Properties?.TryGetValue("ParentId", out parentId);
                    _jobInfo[jobId] = (jobName, state, parentId);
                }
            }
        });
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id) { if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id); }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobIds is null) return;
        if ((bool)(e.Value ?? false)) _selectedJobs = new(_jobIds);
        else _selectedJobs.Clear();
    }

    private async Task EnqueueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
