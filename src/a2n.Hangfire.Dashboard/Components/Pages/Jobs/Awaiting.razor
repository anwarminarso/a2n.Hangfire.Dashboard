@page "/jobs/awaiting"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Awaiting Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Awaiting Jobs</h2>

    @if (_jobIds is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_jobIds.Count == 0)
    {
        <EmptyState Icon="hourglass" Color="secondary"
                    Message="No awaiting jobs."
                    Subtitle="Jobs waiting for parent continuations to complete." />
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="EnqueueSelected">
                    <i class="bi bi-arrow-repeat"></i> Enqueue
                </button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
                    <i class="bi bi-x-lg"></i> Delete
                </button>
            </div>
            <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 40px;"><input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" /></th>
                                <th>Id</th>
                                <th>Job</th>
                                <th>Options</th>
                                <th>Parent</th>
                                <th class="text-end">Since</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var jobId in _jobIds)
                            {
                                _jobInfo.TryGetValue(jobId, out var info);
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@IsSelected(jobId)" @onchange="() => ToggleJob(jobId)" />
                                    </td>
                                    <td class="font-monospace">
                                        <a href="jobs/details/@jobId">@ShortenId(jobId)</a>
                                    </td>
                                    <td>@(info.jobName ?? "Unknown")</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(info.options))
                                        {
                                            <code>@info.options</code>
                                        }
                                        else
                                        {
                                            <em class="text-body-secondary">N/A</em>
                                        }
                                    </td>
                                    <td class="font-monospace">
                                        @if (!string.IsNullOrEmpty(info.parentId))
                                        {
                                            <a href="jobs/details/@info.parentId">
                                                @if (!string.IsNullOrEmpty(info.parentState))
                                                {
                                                    <span class="badge @GetParentStateBadgeClass(info.parentState)">@ShortenId(info.parentId)</span>
                                                }
                                                else
                                                {
                                                    @ShortenId(info.parentId)
                                                }
                                            </a>
                                        }
                                        else
                                        {
                                            <em class="text-body-secondary">N/A</em>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (info.createdAt.HasValue)
                                        {
                                            <RelativeTime UtcTime="@info.createdAt.Value" />
                                        }
                                        else
                                        {
                                            <em class="text-body-secondary">N/A</em>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
               OnPageChanged="HandlePageChanged" />
    }
</div>

@code {
    private IReadOnlyList<string> _jobIds;
    private Dictionary<string, (string jobName, string options, string parentId, string parentState, DateTime? createdAt)> _jobInfo = new();
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var count = Monitor.GetSetCount("awaiting");
                if (count != _totalCount)
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetSetCount("awaiting");
            _jobIds = Monitor.GetSetJobIds("awaiting", _from, _pageSize);
            _jobInfo.Clear();
            if (_jobIds is not null)
            {
                foreach (var jobId in _jobIds)
                {
                    var detail = Monitor.GetJobDetails(jobId);
                    var jobName = detail?.Job is not null ? $"{detail.Job.Type.Name}.{detail.Job.Method.Name}" : null;
                    string parentId = null;
                    string parentState = null;
                    string options = null;
                    DateTime? createdAt = detail?.CreatedAt;

                    // Get state data for Options and ParentId
                    var currentState = detail?.History?.FirstOrDefault();
                    if (currentState?.Data != null)
                    {
                        currentState.Data.TryGetValue("Options", out options);
                        if (currentState.Data.TryGetValue("ParentId", out parentId) && !string.IsNullOrEmpty(parentId))
                        {
                            var parentDetail = Monitor.GetJobDetails(parentId);
                            parentState = parentDetail?.History?.FirstOrDefault()?.StateName;
                        }
                    }

                    // Fallback: check Properties
                    if (string.IsNullOrEmpty(parentId))
                    {
                        detail?.Properties?.TryGetValue("ParentId", out parentId);
                    }

                    _jobInfo[jobId] = (jobName, options, parentId, parentState, createdAt);
                }
            }
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id)
    {
        if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id);
        _selectAll = _jobIds != null && _selectedJobs.Count == _jobIds.Count;
    }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobIds is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new(_jobIds);
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }

    private async Task EnqueueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";

    private static string GetParentStateBadgeClass(string state) => state switch
    {
        "Succeeded" => "bg-success",
        "Failed" => "bg-danger",
        "Processing" => "bg-primary",
        "Enqueued" => "bg-info",
        "Scheduled" => "bg-warning text-dark",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
