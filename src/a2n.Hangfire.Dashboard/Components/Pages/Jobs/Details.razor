@page "/jobs/details/{JobId}"
@inject HangfireMonitorService Monitor
@inject DashboardUIOptions Options
@implements IDisposable

<PageTitle>Job @JobId</PageTitle>

<div class="page-container">
    @if (_job is null && !_notFound)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_notFound)
    {
        <div class="card text-center py-5">
            <span class="fs-1">🔍</span>
            <p class="mt-2 mb-0">Job not found or expired.</p>
            <p class="text-body-secondary">Job ID: @JobId</p>
        </div>
    }
    else if (_job is not null)
    {
        <h2 class="page-title">@GetJobTitle()</h2>

        @* Job Status Banner *@
        var topState = _job.History.FirstOrDefault()?.StateName;
        var expiryInfo = GetExpiryInfo();
        if (!string.IsNullOrEmpty(expiryInfo))
        {
            <div class="alert @GetBannerAlertClass(topState) d-flex align-items-center" role="alert">
                <strong>The job is @(topState?.ToLowerInvariant()).</strong>&nbsp;@expiryInfo
            </div>
        }

        @* Tags *@
        <TagsViewer JobId="@JobId" />

        @* Continuations / dependency graph *@
        <JobGraphViewer JobId="@JobId" />

        @* Job Code Snippet *@
        if (_job.Job is not null)
        {
            <div class="card mb-3">
                <div class="card-body p-0">
                    <pre class="hf-code-block mb-0 p-3"><code><span class="code-comment">// Id: #@JobId</span>
<span class="code-keyword">using</span> <span class="code-namespace">@(_job.Job.Type.Namespace)</span>;

<span class="code-keyword">var</span> sampleJobs = Activate&lt;<span class="code-type">@(_job.Job.Type.Name)</span>&gt;();
sampleJobs.<span class="code-method">@(_job.Job.Method.Name)</span>(@((MarkupString)GetFormattedArguments()));</code></pre>
                </div>
            </div>
        }

        @* Parameters *@
        if (_job.Properties.Any(p => !p.Key.StartsWith("DBG_") && p.Key != "Continuations"))
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h6 class="mb-0">Parameters</h6>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var prop in _job.Properties.Where(p => !p.Key.StartsWith("DBG_") && p.Key != "Continuations"))
                            {
                                <tr>
                                    <td class="fw-semibold text-body-secondary" style="width: 200px;">@prop.Key</td>
                                    <td><code class="text-break">@prop.Value</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        @* Actions — aligned right *@
        <div class="d-flex gap-2 mb-3 justify-content-end">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Requeue" disabled="@_actionInProgress">
                <i class="bi bi-arrow-counterclockwise"></i> Requeue
            </button>
            <button class="btn btn-danger btn-sm" @onclick="ShowDeleteConfirm" disabled="@_actionInProgress">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>

        @* State Section *@
        var retrySummary = Helpers.RetrySummary.FromHistory(_job);
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 gap-2">
            <h6 class="fw-semibold mb-0">State History</h6>
            @if (retrySummary.ShouldDisplay)
            {
                <div class="hf-retry-summary small">
                    <i class="bi bi-arrow-repeat @(retrySummary.AllSameException && retrySummary.RetryCount >= 3 ? "text-warning" : "text-body-secondary")"></i>
                    <span class="fw-semibold ms-1">@(retrySummary.RetryCount == 1 ? "Retried once" : $"Retried {retrySummary.RetryCount} times")</span>
                    @if (retrySummary.DistinctExceptionTypes.Count > 0)
                    {
                        <span class="text-body-secondary"> · </span>
                        <span class="text-body-secondary"
                              title="@retrySummary.GetExceptionTooltip()">@retrySummary.GetExceptionPhrase()</span>
                    }
                </div>
            }
        </div>
                @* State cards — chronological (newest first), console embedded in Processing *@
                var attemptIndex = retrySummary.RetryCount > 0
                    ? BuildAttemptIndex(_job.History)
                    : null;
                <div class="d-flex flex-column gap-2">
                    @foreach (var state in _job.History)
                    {
                        <div class="card @GetStateCardBorderClass(state.StateName)">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <span class="fw-semibold">
                                    <i class="bi @GetStateIcon(state.StateName) @GetStateTextClass(state.StateName)"></i> @state.StateName
                                    @if (attemptIndex is not null && attemptIndex.TryGetValue(state, out var attemptNum))
                                    {
                                        <span class="badge text-bg-secondary ms-2 align-middle hf-attempt-badge"
                                              title="Attempt @attemptNum of @retrySummary.RetryCount">#@attemptNum</span>
                                    }
                                </span>
                                <small class="text-body-secondary"><RelativeTime UtcTime="@state.CreatedAt" /></small>
                            </div>

                            <div class="card-body py-2">
                                @* State metadata *@
                                @if (!string.IsNullOrWhiteSpace(state.Reason))
                                {
                                    <p class="text-body-secondary small mb-2">@state.Reason</p>
                                }

                                @* Show relevant data for each state type *@
                                @if (state.StateName == "Succeeded" && state.Data.Count > 0)
                                {
                                    <div class="row g-2">
                                        @if (state.Data.TryGetValue("Latency", out var latency))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">Latency:</span>
                                                <span class="small fw-semibold">@FormatDuration(latency)</span>
                                            </div>
                                        }
                                        @if (state.Data.TryGetValue("PerformanceDuration", out var perfDuration))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">Duration:</span>
                                                <span class="small fw-semibold">@FormatDuration(perfDuration)</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (state.StateName == "Failed" && state.Data.Count > 0)
                                {
                                    <div class="alert alert-danger mb-0 p-2">
                                        @if (state.Data.TryGetValue("ExceptionType", out var exType))
                                        {
                                            <div class="fw-bold small">@exType</div>
                                        }
                                        @if (state.Data.TryGetValue("ExceptionMessage", out var exMsg))
                                        {
                                            <div class="small">@exMsg</div>
                                        }
                                        @if (state.Data.TryGetValue("ExceptionDetails", out var exDetails))
                                        {
                                            <details class="mt-1">
                                                <summary class="small text-danger">Stack Trace</summary>
                                                <pre class="hf-stacktrace mt-1 mb-0">@((MarkupString)FormatStackTrace(exDetails))</pre>
                                            </details>
                                        }
                                    </div>
                                }
                                else if (state.StateName == "Processing")
                                {
                                    @* Show Server/Worker info *@
                                    <div class="row g-2 mb-2">
                                        @if (state.Data.TryGetValue("ServerId", out var serverId))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">Server:</span>
                                                <span class="small fw-semibold"><ServerLabel FullId="@serverId" /></span>
                                            </div>
                                        }
                                        @if (state.Data.TryGetValue("WorkerId", out var workerId))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">Worker:</span>
                                                <span class="small fw-semibold"><WorkerLabel FullId="@workerId" /></span>
                                            </div>
                                        }
                                    </div>

                                    @* Console output embedded in Processing card *@
                                    @if (state.Data.TryGetValue("StartedAt", out var startedAtStr))
                                    {
                                        var startedAt = global::Hangfire.Common.JobHelper.DeserializeDateTime(startedAtStr);
                                        var isLatestProcessing = _job.History.First(h => h.StateName == "Processing") == state;
                                        var isCurrentlyProcessing = _isProcessing && isLatestProcessing;

                                        @* Calculate duration for this session *@
                                        var stateIndex = _job.History.IndexOf(state);
                                        var sessionDuration = stateIndex > 0
                                            ? (double?)(_job.History[stateIndex - 1].CreatedAt - state.CreatedAt).TotalSeconds
                                            : null;

                                        @if (isLatestProcessing)
                                        {
                                            <ConsoleViewer JobId="@JobId"
                                                           StartedAt="@startedAt"
                                                           IsLive="@isCurrentlyProcessing"
                                                           ServerName="@(state.Data.TryGetValue("ServerId", out var sn2) ? sn2 : null)"
                                                           WorkerId="@(state.Data.TryGetValue("WorkerId", out var wi2) ? wi2 : null)"
                                                           DurationSeconds="@sessionDuration" />
                                        }
                                        else
                                        {
                                            @* Older sessions: collapsed by default, load on demand *@
                                            var sessionKey = $"session-{startedAt.Ticks}";
                                            var isExpanded = _expandedSessions.Contains(sessionKey);

                                            <div class="hf-console-collapsible-inline">
                                                <button class="hf-console-collapsible-header" @onclick="() => ToggleSessionByKey(sessionKey)">
                                                    <span class="hf-console-collapsible-icon">@(isExpanded ? "▼" : "▶")</span>
                                                    <span class="hf-console-collapsible-title">Show console output</span>
                                                </button>
                                                @if (isExpanded)
                                                {
                                                    <ConsoleViewer JobId="@JobId"
                                                                   StartedAt="@startedAt"
                                                                   IsLive="false"
                                                                   ServerName="@(state.Data.TryGetValue("ServerId", out var sn3) ? sn3 : null)"
                                                                   WorkerId="@(state.Data.TryGetValue("WorkerId", out var wi3) ? wi3 : null)"
                                                                   DurationSeconds="@sessionDuration" />
                                                }
                                            </div>
                                        }
                                    }
                                }
                                else if (state.StateName == "Scheduled" && state.Data.Count > 0)
                                {
                                    <div class="row g-2">
                                        @if (state.Data.TryGetValue("EnqueueAt", out var enqueueAt))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">Enqueue at:</span>
                                                <span class="small fw-semibold">@enqueueAt</span>
                                            </div>
                                        }
                                    </div>
                                }
                                else if (state.Data.Count > 0 && state.StateName != "Enqueued" && state.StateName != "Created")
                                {
                                    <div class="row g-2">
                                        @foreach (var kv in state.Data.Take(5))
                                        {
                                            <div class="col-auto">
                                                <span class="text-body-secondary small">@kv.Key:</span>
                                                <span class="small fw-semibold">@TruncateValue(kv.Value)</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
    }
</div>

<ConfirmModal Visible="@_showDeleteConfirm"
              Message="@($"Are you sure you want to delete job #{JobId}?")"
              OnConfirm="ConfirmDelete"
              OnCancel="CancelDelete" />

@code {
    [Parameter] public string JobId { get; set; } = "";

    private JobDetailsDto _job;
    private bool _notFound;
    private bool _isProcessing;
    private bool _actionInProgress;
    private Timer _autoRefreshTimer;
    private string _previousState;
    private HashSet<string> _expandedSessions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadJobData();
        StartAutoRefresh();
    }

    private async Task LoadJobData()
    {
        await Task.Run(() =>
        {
            _job = Monitor.GetJobDetails(JobId);
            _notFound = _job is null;
            UpdateProcessingState();
        });
    }

    private void UpdateProcessingState()
    {
        if (_job?.History is null) return;
        var currentState = _job.History.FirstOrDefault()?.StateName;
        _previousState = currentState;
        _isProcessing = currentState == "Processing";
    }

    private void StartAutoRefresh()
    {
        _autoRefreshTimer = new Timer(async _ =>
        {
            try
            {
                var job = Monitor.GetJobDetails(JobId);
                if (job is null) return;

                var currentState = job.History.FirstOrDefault()?.StateName;
                var stateChanged = currentState != _previousState;
                var isNowProcessing = currentState == "Processing";

                if (stateChanged || isNowProcessing)
                {
                    await InvokeAsync(() =>
                    {
                        _job = job;
                        UpdateProcessingState();
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void ToggleSessionByKey(string key)
    {
        if (!_expandedSessions.Remove(key))
            _expandedSessions.Add(key);
    }

    private string GetJobTitle()
    {
        if (_job is null) return $"Job #{JobId}";
        return Helpers.JobNameHelper.GetDisplayName(_job.Job, _job.InvocationData);
    }

    private string GetFormattedArguments()
    {
        if (_job?.Job?.Args is null || _job.Job.Args.Count == 0) return "";
        return string.Join(", ", _job.Job.Args.Select(a =>
        {
            if (a is null) return "<span class=\"code-keyword\">null</span>";
            if (a is string s) return $"<span class=\"code-string\">\"{System.Net.WebUtility.HtmlEncode(s)}\"</span>";
            return $"<span class=\"code-number\">{System.Net.WebUtility.HtmlEncode(a.ToString() ?? "")}</span>";
        }));
    }

    private string GetExpiryInfo()
    {
        if (_job?.Properties is null) return null;

        if (_job.Properties.TryGetValue("ExpireAt", out var expireAtStr) && !string.IsNullOrEmpty(expireAtStr))
        {
            try
            {
                var expireAt = global::Hangfire.Common.JobHelper.DeserializeDateTime(expireAtStr);
                var remaining = expireAt - DateTime.UtcNow;
                if (remaining.TotalSeconds > 0)
                {
                    if (remaining.TotalHours >= 1)
                        return $"It will be removed automatically in {(int)remaining.TotalHours} hours.";
                    if (remaining.TotalMinutes >= 1)
                        return $"It will be removed automatically in {(int)remaining.TotalMinutes} minutes.";
                    return "It will be removed automatically soon.";
                }
            }
            catch { }
        }

        var currentState = _job.History?.FirstOrDefault()?.StateName;
        return currentState switch
        {
            "Succeeded" => "It will be removed automatically in 24 hours.",
            "Deleted" => "It will be removed automatically in 24 hours.",
            _ => null
        };
    }

    private static string GetBannerAlertClass(string stateName) => stateName switch
    {
        "Succeeded" => "alert-success",
        "Failed" => "alert-danger",
        "Processing" => "alert-warning",
        "Deleted" => "alert-secondary",
        _ => "alert-info"
    };

    private static string GetStateCardBorderClass(string stateName) => stateName switch
    {
        "Succeeded" => "hf-state-border-succeeded",
        "Failed" => "hf-state-border-failed",
        "Processing" => "hf-state-border-processing",
        "Enqueued" => "hf-state-border-enqueued",
        "Scheduled" => "hf-state-border-scheduled",
        "Deleted" => "hf-state-border-deleted",
        "Created" => "hf-state-border-created",
        _ => ""
    };

    private static string GetStateBadgeClass(string stateName) => stateName switch
    {
        "Succeeded" => "bg-success",
        "Failed" => "bg-danger",
        "Processing" => "bg-warning text-dark",
        "Enqueued" => "bg-info text-dark",
        "Scheduled" => "bg-info text-dark",
        "Deleted" => "bg-secondary",
        "Created" => "bg-secondary",
        _ => "bg-secondary"
    };

    private static string GetStateTextClass(string stateName) => stateName switch
    {
        "Succeeded" => "text-success",
        "Failed" => "text-danger",
        "Processing" => "text-primary",
        "Enqueued" => "text-info",
        "Scheduled" => "text-warning",
        "Deleted" => "text-secondary",
        "Created" => "text-secondary",
        _ => "text-secondary"
    };

    private static string GetStateIcon(string stateName) => stateName switch
    {
        "Succeeded" => "bi-check-circle-fill",
        "Failed" => "bi-x-circle-fill",
        "Processing" => "bi-gear-fill",
        "Enqueued" => "bi-inbox-fill",
        "Scheduled" => "bi-clock-fill",
        "Deleted" => "bi-trash3-fill",
        "Created" => "bi-plus-circle-fill",
        "Awaiting" => "bi-hourglass-split",
        _ => "bi-circle-fill"
    };

    private static string FormatDuration(string millisOrValue)
    {
        if (string.IsNullOrEmpty(millisOrValue)) return "";
        if (double.TryParse(millisOrValue, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var ms))
        {
            var ts = TimeSpan.FromMilliseconds(ms);
            if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes:D2}m {ts.Seconds:D2}s";
            if (ts.TotalMinutes >= 1) return $"{(int)ts.TotalMinutes}m {ts.Seconds:D2}s";
            if (ts.TotalSeconds >= 1) return $"{ts.TotalSeconds:F2}s";
            return $"{ms:F0}ms";
        }
        return millisOrValue;
    }

    /// <summary>
    /// Formats a .NET stack trace with syntax highlighting and optional source-control links.
    /// </summary>
    private string FormatStackTrace(string stackTrace)
        => Helpers.StackTraceFormatter.Format(stackTrace, Options?.SourceLink);

    /// <summary>
    /// Numbers each Failed (and the immediately-preceding Processing) state with its retry attempt index.
    /// Returns null when there are no retries to number. The dictionary maps the original
    /// <see cref="StateHistoryDto"/> reference to its 1-based attempt number.
    /// </summary>
    private static Dictionary<StateHistoryDto, int> BuildAttemptIndex(IList<StateHistoryDto> history)
    {
        if (history is null || history.Count == 0) return null;

        // Walk in chronological order (history is stored newest-first) and assign attempt numbers
        // every time we encounter a Processing state. The matching Failed state inherits the same number.
        var chronological = history.Reverse().ToList();
        var index = new Dictionary<StateHistoryDto, int>();
        var attempt = 0;
        foreach (var entry in chronological)
        {
            if (entry.StateName == "Processing")
            {
                attempt++;
                index[entry] = attempt;
            }
            else if (entry.StateName == "Failed" && attempt > 0)
            {
                index[entry] = attempt;
            }
        }
        return index.Count > 0 ? index : null;
    }

    private async Task Requeue()
    {
        _actionInProgress = true;
        StateHasChanged();

        await Task.Run(() => Monitor.RequeueJob(JobId));
        await Task.Delay(500);
        await LoadJobData();

        _actionInProgress = false;
        StateHasChanged();
    }

    private async Task Delete()
    {
        _actionInProgress = true;
        StateHasChanged();

        await Task.Run(() => Monitor.DeleteJob(JobId));
        await Task.Delay(300);
        await LoadJobData();

        _actionInProgress = false;
        StateHasChanged();
    }

    private bool _showDeleteConfirm;
    private void ShowDeleteConfirm() => _showDeleteConfirm = true;
    private void CancelDelete() => _showDeleteConfirm = false;
    private async Task ConfirmDelete()
    {
        _showDeleteConfirm = false;
        await Delete();
    }

    private static string TruncateValue(string value) =>
        value.Length > 100 ? value[..100] + "…" : value;

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }

    public void Dispose()
    {
        _autoRefreshTimer?.Dispose();
    }
}
