@page "/jobs/enqueued"
@page "/jobs/enqueued/{QueueName}"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Enqueued Jobs</PageTitle>

<h2 class="fw-semibold mb-3">Enqueued Jobs</h2>

@if (_queues is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_queues.Count == 0)
{
    <EmptyState Icon="inbox" Color="secondary"
                Message="No queues found." />
}
else
{
    <ul class="nav nav-tabs mb-3">
        @foreach (var q in _queues)
        {
            <li class="nav-item">
                <a class="nav-link @(q.Name == _activeQueue ? "active" : "")"
                   href="jobs/enqueued/@q.Name">
                    @q.Name <span class="badge bg-secondary ms-1">@q.Length</span>
                </a>
            </li>
        }
    </ul>

    @if (_jobs is not null)
    {
        @if (_jobs.Count == 0)
        {
            <EmptyState Icon="inbox" Color="secondary"
                        Message="@($"No enqueued jobs in \"{_activeQueue}\" queue.")" />
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
                        <i class="bi bi-x-lg"></i> Delete
                    </button>
                </div>
                <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
            </div>

            <div class="card">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 40px;">
                                        <input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" />
                                    </th>
                                    <th>Id</th>
                                    <th>State</th>
                                    <th>Job</th>
                                    <th class="text-end">Enqueued</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var job in _jobs)
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" class="form-check-input" checked="@IsSelected(job.Key)"
                                                   @onchange="() => ToggleJob(job.Key)" />
                                        </td>
                                        <td class="font-monospace"><a href="jobs/details/@job.Key">@ShortenId(job.Key)</a></td>
                                        <td><span class="badge bg-secondary">@(job.Value?.State ?? "N/A")</span></td>
                                        <td>@GetJobName(job.Value)</td>
                                        <td class="text-end">
                                            @if (job.Value?.EnqueuedAt.HasValue == true)
                                            {
                                                <RelativeTime UtcTime="@job.Value.EnqueuedAt.Value" />
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
                   OnPageChanged="HandlePageChanged" />
        }
    }
}

@code {
    [Parameter] public string QueueName { get; set; }

    private IList<QueueWithTopEnqueuedJobsDto> _queues;
    private JobList<EnqueuedJobDto> _jobs;
    private string _activeQueue = "default";
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private Timer _refreshTimer;

    protected override async Task OnParametersSetAsync()
    {
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
        StartTimer();
    }

    private void StartTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var queues = Monitor.GetQueues();
                var totalCount = Monitor.GetEnqueuedCount(_activeQueue);
                var jobs = Monitor.GetEnqueuedJobs(_activeQueue, _from, _pageSize);
                await InvokeAsync(() =>
                {
                    _queues = queues;
                    _totalCount = totalCount;
                    _jobs = jobs;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _queues = Monitor.GetQueues();
            _activeQueue = QueueName ?? _queues.FirstOrDefault()?.Name ?? "default";
            _totalCount = Monitor.GetEnqueuedCount(_activeQueue);
            _jobs = Monitor.GetEnqueuedJobs(_activeQueue, _from, _pageSize);
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id)
    {
        if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id);
        _selectAll = _jobs != null && _selectedJobs.Count == _jobs.Count;
    }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new(_jobs.Select(j => j.Key));
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";
    private static string GetJobName(EnqueuedJobDto dto) =>
        dto is null ? "(unknown)" : Helpers.JobNameHelper.GetDisplayName(dto.Job, dto.InvocationData);

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
