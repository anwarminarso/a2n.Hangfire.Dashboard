@page "/jobs/enqueued"
@page "/jobs/enqueued/{QueueName}"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Enqueued Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Enqueued Jobs</h2>

    @if (_queues is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_queues.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📥</span>
            <p>No queues found.</p>
        </div>
    }
    else
    {
        <div class="queue-tabs">
            @foreach (var q in _queues)
            {
                <a class="queue-tab @(q.Name == _activeQueue ? "queue-tab--active" : "")"
                   href="/jobs/enqueued/@q.Name">
                    @q.Name <span class="queue-tab-count">@q.Length</span>
                </a>
            }
        </div>

        @if (_jobs is not null)
        {
            @if (_jobs.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <p>No enqueued jobs in "@_activeQueue" queue.</p>
                </div>
            }
            else
            {
                <div class="toolbar">
                    <button class="btn btn--primary" disabled="@(!_selectedJobs.Any())" @onclick="RequeueSelected">
                        🔄 Requeue
                    </button>
                    <button class="btn btn--danger" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
                        🗑️ Delete
                    </button>
                </div>

                <div class="section-card">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="col-check">
                                    <input type="checkbox" @onchange="ToggleAll" />
                                </th>
                                <th>Id</th>
                                <th>Job</th>
                                <th>State</th>
                                <th>Enqueued</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _jobs)
                            {
                                <tr>
                                    <td class="col-check">
                                        <input type="checkbox" checked="@IsSelected(job.Key)"
                                               @onchange="() => ToggleJob(job.Key)" />
                                    </td>
                                    <td class="font-mono"><a href="/jobs/details/@job.Key" class="job-id-link">@ShortenId(job.Key)</a></td>
                                    <td>@GetJobName(job.Value)</td>
                                    <td><span class="badge">@(job.Value?.State ?? "N/A")</span></td>
                                    <td>
                                        @if (job.Value?.EnqueuedAt.HasValue == true)
                                        {
                                            <RelativeTime UtcTime="@job.Value.EnqueuedAt.Value" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
                       OnPageChanged="HandlePageChanged" />
            }
        }
    }
</div>

@code {
    [Parameter] public string QueueName { get; set; }

    private IList<QueueWithTopEnqueuedJobsDto> _queues;
    private JobList<EnqueuedJobDto> _jobs;
    private string _activeQueue = "default";
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private HashSet<string> _selectedJobs = new();
    private Timer _refreshTimer;

    protected override async Task OnParametersSetAsync()
    {
        _from = 0;
        _selectedJobs.Clear();
        await LoadData();
        StartTimer();
    }

    private void StartTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var queues = Monitor.GetQueues();
                var totalCount = Monitor.GetEnqueuedCount(_activeQueue);
                var jobs = Monitor.GetEnqueuedJobs(_activeQueue, _from, _pageSize);
                await InvokeAsync(() =>
                {
                    _queues = queues;
                    _totalCount = totalCount;
                    _jobs = jobs;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _queues = Monitor.GetQueues();
            _activeQueue = QueueName ?? _queues.FirstOrDefault()?.Name ?? "default";
            _totalCount = Monitor.GetEnqueuedCount(_activeQueue);
            _jobs = Monitor.GetEnqueuedJobs(_activeQueue, _from, _pageSize);
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        await LoadData();
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id) { if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id); }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false)) _selectedJobs = new(_jobs.Select(j => j.Key));
        else _selectedJobs.Clear();
    }
    private async Task RequeueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";
    private static string GetJobName(EnqueuedJobDto dto) =>
        dto?.Job is null ? "Unknown" : $"{dto.Job.Type.Name}.{dto.Job.Method.Name}";

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
