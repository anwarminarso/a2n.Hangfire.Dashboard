@page "/jobs/failed"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Failed Jobs</PageTitle>

<h2 class="fw-semibold mb-3">Failed Jobs</h2>

@if (_jobs is null)
{
    <p class="text-muted">Loading...</p>
}
else if (_jobs.Count == 0)
{
    <EmptyState Icon="check-circle" Color="success"
                Message="No failed jobs. Everything is running smoothly." />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="RequeueSelected">
                <i class="bi bi-arrow-repeat"></i> Requeue
            </button>
            <button class="btn btn-danger btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="ShowDeleteConfirm">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
        <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" />
                            </th>
                            <th>Id</th>
                            <th>Job</th>
                            <SortableHeader Label="Failed" CssClass="text-end" IsActive="@_order.NewestFirst.HasValue"
                                            Descending="@(_order.NewestFirst == true)" OnSort="ToggleOrder" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobs)
                        {
                            <tr class="@(IsSelected(job.Key) ? "table-active" : "")">
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@IsSelected(job.Key)"
                                           @onchange="() => ToggleJob(job.Key)" />
                                </td>
                                <td class="font-monospace"><a href="jobs/details/@job.Key">@ShortenId(job.Key)</a></td>
                                <td>
                                    <JobNameDisplay Job="@job.Value?.Job" InvocationData="@job.Value?.InvocationData" />
                                    @if (!string.IsNullOrEmpty(job.Value?.Reason))
                                    {
                                        <div class="text-muted small">@TruncateReason(job.Value.Reason)</div>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (job.Value?.FailedAt.HasValue == true)
                                    {
                                        <RelativeTime UtcTime="@job.Value.FailedAt.Value" />
                                    }
                                </td>
                            </tr>
                            @if (job.Value?.ExceptionMessage is not null)
                            {
                                <tr>
                                    <td></td>
                                    <td colspan="3">
                                        <div class="alert alert-danger py-2 px-3 mb-0 small hf-exception">
                                            <strong>@job.Value.ExceptionType</strong>
                                            <p class="mb-0 mt-1 hf-exception-message">@job.Value.ExceptionMessage</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
           OnPageChanged="HandlePageChanged" />
}

<ConfirmModal Visible="@_showDeleteConfirm"
              Message="@($"Are you sure you want to delete {_selectedJobs.Count} selected job(s)?")"
              OnConfirm="ConfirmDelete"
              OnCancel="CancelDelete" />

@code {
    private JobList<FailedJobDto> _jobs;
    private long _totalCount;
    private readonly ReversibleOrder _order = new();
    private int _from = 0;
    private int _pageSize = 20;
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var newCount = Monitor.GetFailedCount();
                if (newCount != _totalCount)
                {
                    var jobs = FetchPage(newCount);
                    await InvokeAsync(() =>
                    {
                        _totalCount = newCount;
                        _jobs = jobs;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetFailedCount();
            _jobs = FetchPage(_totalCount);
        });
    }

    private JobList<FailedJobDto> FetchPage(long total) =>
        _order.Fetch(Monitor.GetFailedJobs, total, _from, _pageSize, j => j.FailedAt);

    private async Task ToggleOrder()
    {
        _order.Toggle();
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool IsSelected(string jobId) => _selectedJobs.Contains(jobId);

    private void ToggleJob(string jobId)
    {
        if (!_selectedJobs.Remove(jobId)) _selectedJobs.Add(jobId);
        _selectAll = _jobs != null && _selectedJobs.Count == _jobs.Count;
    }

    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new HashSet<string>(_jobs.Select(j => j.Key));
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }

    private async Task RequeueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool _showDeleteConfirm;
    private void ShowDeleteConfirm() => _showDeleteConfirm = true;
    private void CancelDelete() => _showDeleteConfirm = false;
    private async Task ConfirmDelete()
    {
        _showDeleteConfirm = false;
        await DeleteSelected();
    }

    private static string ShortenId(string id)
    {
        if (Guid.TryParse(id, out _))
            return id[..8] + "…";
        return $"#{id}";
    }


    private static string TruncateReason(string reason)
    {
        if (reason is null) return null;
        return reason.Length > 80 ? reason[..80] + "…" : reason;
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
