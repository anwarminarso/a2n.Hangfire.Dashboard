@page "/jobs/succeeded"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Succeeded Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Succeeded Jobs</h2>

    @if (_jobs is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_jobs.Count == 0)
    {
        <div class="card text-center py-5">
            <span class="fs-1">✅</span>
            <p class="mt-2 mb-0">No succeeded jobs recorded yet.</p>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div class="d-flex gap-2">
                <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="RequeueSelected">
                    <i class="bi bi-arrow-repeat"></i> Requeue
                </button>
            </div>
            <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 40px;">
                                    <input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" />
                                </th>
                                <th>Id</th>
                                <th>Job</th>
                                <th>Duration</th>
                                <th>Latency</th>
                                <th class="text-end">Succeeded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _jobs)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@IsSelected(job.Key)"
                                               @onchange="() => ToggleJob(job.Key)" />
                                    </td>
                                    <td class="font-monospace"><a href="jobs/details/@job.Key">@ShortenId(job.Key)</a></td>
                                    <td>@GetJobName(job.Value)</td>
                                    <td>@GetPerformanceDuration(job.Value)</td>
                                    <td>@GetLatency(job.Value)</td>
                                    <td class="text-end">
                                        @if (job.Value?.SucceededAt.HasValue == true)
                                        {
                                            <RelativeTime UtcTime="@job.Value.SucceededAt.Value" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
               OnPageChanged="HandlePageChanged" />
    }
</div>

@code {
    private JobList<SucceededJobDto> _jobs;
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var newCount = Monitor.GetSucceededListCount();
                if (newCount != _totalCount)
                {
                    var jobs = Monitor.GetSucceededJobs(_from, _pageSize);
                    await InvokeAsync(() =>
                    {
                        _totalCount = newCount;
                        _jobs = jobs;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetSucceededListCount();
            _jobs = Monitor.GetSucceededJobs(_from, _pageSize);
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id)
    {
        if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id);
        _selectAll = _jobs != null && _selectedJobs.Count == _jobs.Count;
    }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new(_jobs.Select(j => j.Key));
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }

    private async Task RequeueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private static string ShortenId(string id)
    {
        if (Guid.TryParse(id, out _)) return id[..8] + "…";
        return $"#{id}";
    }

    private static string GetJobName(SucceededJobDto dto)
    {
        if (dto?.Job is null) return "Unknown";
        return $"{dto.Job.Type.Name}.{dto.Job.Method.Name}";
    }

    private static string GetPerformanceDuration(SucceededJobDto dto)
    {
        if (dto?.StateData == null) return FormatMs(dto?.TotalDuration);
        if (dto.StateData.TryGetValue("PerformanceDuration", out var duration) &&
            long.TryParse(duration, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var ms))
        {
            return FormatMs(ms);
        }
        return FormatMs(dto.TotalDuration);
    }

    private static string GetLatency(SucceededJobDto dto)
    {
        if (dto?.StateData == null) return "—";
        if (dto.StateData.TryGetValue("Latency", out var latency) &&
            long.TryParse(latency, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var ms))
        {
            return FormatMs(ms);
        }
        return "—";
    }

    private static string FormatMs(long? ms)
    {
        if (ms is null) return "—";
        var ts = TimeSpan.FromMilliseconds(ms.Value);
        if (ts.TotalSeconds < 1) return $"{ms} ms";
        if (ts.TotalMinutes < 1) return $"{ts.TotalSeconds:F1} s";
        return $"{(int)ts.TotalMinutes} min {ts.Seconds} sec";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
