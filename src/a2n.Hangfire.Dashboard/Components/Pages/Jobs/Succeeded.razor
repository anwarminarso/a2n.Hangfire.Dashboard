@page "/jobs/succeeded"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Succeeded Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Succeeded Jobs</h2>

    @if (_jobs is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else if (_jobs.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">✅</span>
            <p>No succeeded jobs recorded yet.</p>
        </div>
    }
    else
    {
        <div class="section-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Job</th>
                        <th>Duration</th>
                        <th>Succeeded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in _jobs)
                    {
                        <tr>
                            <td class="font-mono"><a href="/jobs/details/@job.Key" class="job-id-link">@ShortenId(job.Key)</a></td>
                            <td>@GetJobName(job.Value)</td>
                            <td>@FormatDuration(job.Value?.TotalDuration)</td>
                            <td>
                                @if (job.Value?.SucceededAt.HasValue == true)
                                {
                                    <RelativeTime UtcTime="@job.Value.SucceededAt.Value" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination-info">
            Showing @_jobs.Count of @_totalCount succeeded jobs
        </div>

        <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
               OnPageChanged="HandlePageChanged" />
    }
</div>

@code {
    private JobList<SucceededJobDto>? _jobs;
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var newCount = Monitor.GetSucceededListCount();
                if (newCount != _totalCount)
                {
                    var jobs = Monitor.GetSucceededJobs(_from, _pageSize);
                    await InvokeAsync(() =>
                    {
                        _totalCount = newCount;
                        _jobs = jobs;
                        StateHasChanged();
                    });
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetSucceededListCount();
            _jobs = Monitor.GetSucceededJobs(_from, _pageSize);
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        await LoadData();
    }

    private static string ShortenId(string id)
    {
        if (Guid.TryParse(id, out _)) return id[..8] + "…";
        return $"#{id}";
    }

    private static string GetJobName(SucceededJobDto? dto)
    {
        if (dto?.Job is null) return "Unknown";
        return $"{dto.Job.Type.Name}.{dto.Job.Method.Name}";
    }

    private static string FormatDuration(long? ms)
    {
        if (ms is null) return "—";
        var ts = TimeSpan.FromMilliseconds(ms.Value);
        if (ts.TotalSeconds < 1) return $"{ms}ms";
        if (ts.TotalMinutes < 1) return $"{ts.TotalSeconds:F1}s";
        return $"{(int)ts.TotalMinutes}m {ts.Seconds}s";
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
