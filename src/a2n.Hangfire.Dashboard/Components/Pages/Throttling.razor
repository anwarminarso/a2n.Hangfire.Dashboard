@page "/throttling"
@using a2n.Hangfire.Dashboard.Models
@implements IDisposable
@inject ThrottlingSnapshotCache Snapshots
@inject DashboardUIOptions Options

<PageTitle>Throttling</PageTitle>

@if (_semaphores is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_semaphores.Count == 0 && _mutexRows.Count == 0 && _windows.Count == 0)
{
    @* No throttling data in storage — the host application likely does not use Hangfire.Throttling.
       Follows the AnalyticsNotAvailable pattern: explain the dependency instead of a bare empty state. *@
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <i class="bi bi-sliders text-warning fs-3 me-3"></i>
                        <h4 class="card-title mb-0">Throttling Requires Hangfire.Throttling</h4>
                    </div>

                    <p class="text-body-secondary">
                        This page shows the concurrency primitives — semaphores, mutexes, and rate-limit
                        windows — written by the
                        <a href="https://docs.hangfire.io/en/latest/extensions/throttling.html" target="_blank" rel="noopener">Hangfire.Throttling</a>
                        package: each semaphore's limit and live occupancy, and which jobs currently hold each mutex.
                        No throttling data was found in storage.
                    </p>

                    <hr />

                    <h5 class="mb-3">Configuration</h5>

                    <pre class="bg-body-tertiary p-3 rounded"><code>GlobalConfiguration.Configuration
    .UseThrottling(ThrottlingAction.RetryJob, TimeSpan.FromSeconds(15));

var manager = new ThrottlingManager();
manager.AddOrUpdateSemaphore("newsletter", new SemaphoreOptions(maxCount: 10));</code></pre>

                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>
                        Once the host application registers semaphores or jobs acquire mutexes, they appear
                        here automatically — no dashboard configuration is required.
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-body-secondary">
            @_semaphores.Count semaphore@(_semaphores.Count != 1 ? "s" : ""),
            @_mutexRows.Count held mutex@(_mutexRows.Count != 1 ? "es" : "")@(_windows.Count > 0 ? $", {_windows.Count} window{(_windows.Count != 1 ? "s" : "")}" : "")
        </small>
        <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshNowAsync">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </div>

    @if (_semaphores.Count > 0)
    {
        <h6 class="text-body-secondary mt-3 mb-2">Semaphores</h6>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <SortableHeader Label="Id" Style="width: 22%;"
                                                IsActive="@_semaphoreSort.IsActive(SemaphoreSort.Id)" Descending="@_semaphoreSort.Descending"
                                                OnSort="() => _semaphoreSort.Toggle(SemaphoreSort.Id)" />
                                <th>Description</th>
                                <SortableHeader Label="Usage" CssClass="pe-4" Style="width: 240px;"
                                                IsActive="@_semaphoreSort.IsActive(SemaphoreSort.Usage)" Descending="@_semaphoreSort.Descending"
                                                OnSort="() => _semaphoreSort.Toggle(SemaphoreSort.Usage)" />
                                <SortableHeader Label="Holders" Style="width: 24%; min-width: 160px;"
                                                IsActive="@_semaphoreSort.IsActive(SemaphoreSort.Holders)" Descending="@_semaphoreSort.Descending"
                                                OnSort="() => _semaphoreSort.Toggle(SemaphoreSort.Holders)" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var semaphore in SortedSemaphores)
                            {
                                <tr>
                                    <td class="font-monospace">
                                        <a href="throttling/semaphores/@Uri.EscapeDataString(semaphore.Id)">@semaphore.Id</a>
                                    </td>
                                    <td>
                                        @if (semaphore.Description is null)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            @semaphore.Description
                                        }
                                    </td>
                                    <td class="pe-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height: 6px; min-width: 100px;">
                                                <div class="progress-bar @GetUsageBarClass(semaphore)"
                                                     style="width: @GetUsagePercent(semaphore)%"></div>
                                            </div>
                                            <small class="text-body-secondary text-nowrap">
                                                @semaphore.HolderJobIds.Count / @semaphore.MaxCount
                                            </small>
                                        </div>
                                    </td>
                                    <td>
                                        @if (semaphore.HolderJobIds.Count == 0)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            @foreach (var jobId in semaphore.HolderJobIds)
                                            {
                                                <a href="jobs/details/@jobId" class="font-monospace me-2">@ShortenId(jobId)</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <h6 class="text-body-secondary mt-3 mb-2">Held Mutexes</h6>

    @if (_mutexRows.Count > 0)
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <SortableHeader Label="Id"
                                                IsActive="@_mutexSort.IsActive(MutexSort.Id)" Descending="@_mutexSort.Descending"
                                                OnSort="() => _mutexSort.Toggle(MutexSort.Id)" />
                                <SortableHeader Label="Held By" Style="width: 14%; min-width: 120px;"
                                                IsActive="@_mutexSort.IsActive(MutexSort.HeldBy)" Descending="@_mutexSort.Descending"
                                                OnSort="() => _mutexSort.Toggle(MutexSort.HeldBy)" />
                                <SortableHeader Label="State" Style="width: 12%;"
                                                IsActive="@_mutexSort.IsActive(MutexSort.State)" Descending="@_mutexSort.Descending"
                                                OnSort="() => _mutexSort.Toggle(MutexSort.State)" />
                                <SortableHeader Label="Server" Style="width: 18%;"
                                                IsActive="@_mutexSort.IsActive(MutexSort.Server)" Descending="@_mutexSort.Descending"
                                                OnSort="() => _mutexSort.Toggle(MutexSort.Server)" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in SortedMutexRows)
                            {
                                <tr>
                                    <td class="font-monospace">@row.MutexId</td>
                                    <td>
                                        @if (row.Holder is null)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            <a href="jobs/details/@row.Holder.JobId" class="font-monospace">@ShortenId(row.Holder.JobId)</a>
                                        }
                                    </td>
                                    <td>
                                        @if (row.Holder?.StateName is null)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            <span class="badge @GetStateBadgeClass(row.Holder.StateName)">@row.Holder.StateName</span>
                                        }
                                        @* Orphaned holders may have no server at all — an expired job, or one that
                                           reached a final state without releasing — so the badge lives here. *@
                                        @if (row.Holder?.IsOrphaned == true)
                                        {
                                            <span class="badge bg-danger ms-2" title="@row.Holder.OrphanReason">orphaned</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.Holder?.ServerId is null)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            <ServerLabel FullId="@row.Holder.ServerId" />
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-body-secondary"><small>No mutexes are currently held. Mutex entries appear here only while a job holds them.</small></p>
    }

    @if (_windows.Count > 0)
    {
        <h6 class="text-body-secondary mt-3 mb-2">Rate-Limit Windows</h6>
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <SortableHeader Label="Type" Style="width: 10%;"
                                                IsActive="@_windowSort.IsActive(WindowSort.Type)" Descending="@_windowSort.Descending"
                                                OnSort="() => _windowSort.Toggle(WindowSort.Type)" />
                                <SortableHeader Label="Id" Style="width: 22%;"
                                                IsActive="@_windowSort.IsActive(WindowSort.Id)" Descending="@_windowSort.Descending"
                                                OnSort="() => _windowSort.Toggle(WindowSort.Id)" />
                                <th>Description</th>
                                <SortableHeader Label="Limit" CssClass="text-end" Style="width: 12%;"
                                                IsActive="@_windowSort.IsActive(WindowSort.Limit)" Descending="@_windowSort.Descending"
                                                OnSort="() => _windowSort.Toggle(WindowSort.Limit)" />
                                <SortableHeader Label="Interval" CssClass="text-end" Style="width: 12%;"
                                                IsActive="@_windowSort.IsActive(WindowSort.Interval)" Descending="@_windowSort.Descending"
                                                OnSort="() => _windowSort.Toggle(WindowSort.Interval)" />
                                <SortableHeader Label="Current Count" CssClass="text-end" Style="width: 14%;"
                                                IsActive="@_windowSort.IsActive(WindowSort.Count)" Descending="@_windowSort.Descending"
                                                OnSort="() => _windowSort.Toggle(WindowSort.Count)" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var window in SortedWindows)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@window.Type</span></td>
                                    <td class="font-monospace">@window.Id</td>
                                    <td>
                                        @if (window.Description is null)
                                        {
                                            <span class="text-body-secondary">—</span>
                                        }
                                        else
                                        {
                                            @window.Description
                                        }
                                    </td>
                                    <td class="text-end">@(window.Limit?.ToString() ?? "—")</td>
                                    <td class="text-end">@FormatInterval(window.IntervalSeconds)</td>
                                    <td class="text-end">@(window.Counter?.ToString() ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

}

@code {
    private IReadOnlyList<SemaphoreDto> _semaphores;
    private List<MutexRow> _mutexRows = [];
    private IReadOnlyList<ThrottleWindowDto> _windows = [];
    private Timer _refreshTimer;

    /// <summary>How often the page re-reads the shared snapshot. Slightly longer than its TTL.</summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(6);

    private sealed class MutexRow
    {
        public string MutexId { get; set; }
        public ThrottleHolderDto Holder { get; set; }
    }

    private enum SemaphoreSort { None, Id, Usage, Holders }
    private enum MutexSort { None, Id, HeldBy, State, Server }
    private enum WindowSort { None, Type, Id, Limit, Interval, Count }

    private readonly GridSortState<SemaphoreSort> _semaphoreSort = new();
    private readonly GridSortState<MutexSort> _mutexSort = new();
    private readonly GridSortState<WindowSort> _windowSort = new();

    private IEnumerable<SemaphoreDto> SortedSemaphores => GridSort.Apply(_semaphores, _semaphoreSort, column => column switch
    {
        SemaphoreSort.Id => s => s.Id,
        SemaphoreSort.Usage => s => s.MaxCount > 0 ? (double)s.HolderJobIds.Count / s.MaxCount : null,
        SemaphoreSort.Holders => s => s.HolderJobIds.Count,
        _ => null
    }, s => s.Id);

    private IEnumerable<MutexRow> SortedMutexRows => GridSort.Apply(_mutexRows, _mutexSort, column => column switch
    {
        MutexSort.Id => r => r.MutexId,
        MutexSort.HeldBy => r => r.Holder?.JobId,
        MutexSort.State => r => r.Holder?.StateName,
        MutexSort.Server => r => r.Holder?.ServerId,
        _ => null
    }, r => r.MutexId);

    private IEnumerable<ThrottleWindowDto> SortedWindows => GridSort.Apply(_windows, _windowSort, column => column switch
    {
        WindowSort.Type => w => w.Type,
        WindowSort.Id => w => w.Id,
        WindowSort.Limit => w => w.Limit,
        WindowSort.Interval => w => w.IntervalSeconds,
        WindowSort.Count => w => w.Counter,
        _ => null
    }, w => w.Id);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // Occupancy is the fastest-moving thing on this page — holders come and go as jobs acquire
        // and release — so a load-once snapshot goes stale while the operator is still reading it.
        // The reads themselves are shared through ThrottlingSnapshotCache, so this timer costs one
        // storage pass per TTL across every open tab rather than one per tab per tick.
        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                await LoadDataAsync();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }, null, RefreshInterval, RefreshInterval);
    }

    private async Task LoadDataAsync()
    {
        var snapshot = await Snapshots.GetAsync();

        _semaphores = snapshot.Semaphores;
        _windows = snapshot.Windows;
        _mutexRows = snapshot.Mutexes
            .Select(x => new MutexRow { MutexId = x.MutexId, Holder = x.Holder })
            .ToList();
    }

    /// <summary>Bypasses the TTL so the button reflects storage now, not up to one TTL ago.</summary>
    private async Task RefreshNowAsync()
    {
        await Snapshots.GetAsync(forceRefresh: true);
        await LoadDataAsync();
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private static int GetUsagePercent(SemaphoreDto semaphore)
    {
        if (semaphore.MaxCount <= 0) return 0;
        var percent = (int)Math.Round(100.0 * semaphore.HolderJobIds.Count / semaphore.MaxCount);
        return Math.Min(percent, 100);
    }

    private static string GetUsageBarClass(SemaphoreDto semaphore)
    {
        var percent = GetUsagePercent(semaphore);
        return percent switch
        {
            >= 100 => "bg-danger",
            >= 75 => "bg-warning",
            _ => "bg-success",
        };
    }

    private static string GetStateBadgeClass(string state)
    {
        return state?.ToLowerInvariant() switch
        {
            "succeeded" => "bg-success",
            "failed" => "bg-danger",
            "processing" => "bg-warning text-dark",
            "enqueued" => "bg-info text-dark",
            "scheduled" => "bg-info text-dark",
            "deleted" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static string FormatInterval(int? seconds)
    {
        if (seconds is null) return "—";
        if (seconds % 3600 == 0) return $"{seconds / 3600}h";
        if (seconds % 60 == 0) return $"{seconds / 60}m";
        return $"{seconds}s";
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";
}
