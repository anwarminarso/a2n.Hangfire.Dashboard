@page "/recurring"
@using global::Hangfire.Storage
@inject HangfireMonitorService Monitor
@inject DashboardUIOptions Options
@implements IDisposable

<PageTitle>Recurring Jobs</PageTitle>

<h2 class="mb-3">Recurring Jobs</h2>

@if (!string.IsNullOrEmpty(_successMessage))
{
    @* Deletion confirmation — also shown after deleting from the edit form via the ?deleted= query. *@
    <div class="alert alert-success alert-dismissible d-flex align-items-center gap-2" role="status">
        <i class="bi bi-check2-circle"></i>
        <span>@_successMessage</span>
        <button type="button" class="btn-close ms-auto" aria-label="Dismiss"
                @onclick="() => _successMessage = null"></button>
    </div>
}

@if (_jobs is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
            @if (Options.EnableJobManagement)
            {
                <a class="btn btn-success btn-sm" href="recurring/create">
                    <i class="bi bi-plus-lg"></i> Create Job
                </a>
            }
            <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="TriggerSelected">
                <i class="bi bi-play-circle"></i> Trigger
            </button>
            <button class="btn btn-danger btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="ShowDeleteConfirm">
                <i class="bi bi-trash"></i> Delete
            </button>
        </div>
        <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
    </div>

    @* Stopped Jobs Section *@
    @if (Options.EnableJobManagement && _stoppedJobs.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Stopped Jobs</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Cron</th>
                                <th>Time Zone</th>
                                <th>Job</th>
                                <th>Stopped At</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var stopped in _stoppedJobs)
                            {
                                <tr class="table-secondary">
                                    <td class="font-monospace">@stopped.Id</td>
                                    <td><code class="font-monospace">@stopped.Cron</code></td>
                                    <td>@(stopped.TimeZone ?? "UTC")</td>
                                    <td>@stopped.TypeName.@stopped.MethodName</td>
                                    <td>
                                        @if (stopped.StoppedAt.HasValue)
                                        {
                                            <RelativeTime UtcTime="@stopped.StoppedAt.Value" />
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-primary btn-sm" @onclick="() => StartJob(stopped.Id)">
                                            <i class="bi bi-play-fill"></i> Start
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (_jobs.Count == 0 && _stoppedJobs.Count == 0)
    {
        <EmptyState Icon="arrow-repeat" Color="secondary"
                    Message="No recurring jobs configured." />
    }
    else if (_jobs.Count > 0)
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th style="width: 2rem;"><input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" /></th>
                                <th>Id</th>
                                <th>Cron</th>
                                <th>Time Zone</th>
                                <th>Job</th>
                                <th class="text-end">Next Execution</th>
                                <th class="text-end">Last Execution</th>
                                <th class="text-end">Created</th>
                                @if (Options.EnableJobManagement)
                                {
                                    <th>Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _jobs)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" class="form-check-input" checked="@IsSelected(job.Id)" @onchange="() => ToggleJob(job.Id)" />
                                    </td>
                                    <td class="font-monospace">@job.Id</td>
                                    <td><code class="font-monospace">@job.Cron</code></td>
                                    <td>@(job.TimeZoneId ?? "UTC")</td>
                                    <td>@GetJobName(job)</td>
                                    <td class="text-end">
                                        @if (job.NextExecution.HasValue)
                                        {
                                            <RelativeTime UtcTime="@job.NextExecution.Value" IsFuture="true" />
                                        }
                                        else if (job.Error is not null)
                                        {
                                            <span class="badge bg-danger">Error</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Disabled</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (job.LastExecution.HasValue)
                                        {
                                            <span class="@GetLastStateClass(job.LastJobState)">
                                                <RelativeTime UtcTime="@job.LastExecution.Value" />
                                            </span>
                                        }
                                        else
                                        {
                                            <em class="text-body-secondary">N/A</em>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (job.CreatedAt.HasValue)
                                        {
                                            <RelativeTime UtcTime="@job.CreatedAt.Value" />
                                        }
                                        else
                                        {
                                            <em class="text-body-secondary">N/A</em>
                                        }
                                    </td>
                                    <td>
                                        @if (Options.EnableJobManagement)
                                        {
                                            <a class="btn btn-outline-secondary btn-sm" href="recurring/edit/@Uri.EscapeDataString(job.Id)" title="Edit this recurring job">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-outline-secondary btn-sm" @onclick="() => StopJob(job.Id)" title="Stop this recurring job">
                                                <i class="bi bi-stop-fill"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                                @if (job.Error is not null)
                                {
                                    <tr>
                                        <td></td>
                                        <td colspan="@(Options.EnableJobManagement ? 8 : 7)">
                                            <div class="alert alert-danger py-2 mb-0">
                                                <small>@job.Error</small>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Delete Confirmation Modal *@
    <ConfirmModal Visible="@_showDeleteConfirm"
                  Title="Confirm Delete"
                  Message="@($"Are you sure you want to delete {_selectedJobs.Count} recurring job(s)?")"
                  OnConfirm="ConfirmDelete"
                  OnCancel="CancelDelete" />
}

@code {
    private IReadOnlyList<RecurringJobDto> _jobs;
    private List<StoppedJobInfo> _stoppedJobs = new();
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private bool _showDeleteConfirm;
    private int _pageSize = 20;
    private Timer _refreshTimer;
    private string _successMessage;

    // Carries the deleted job id when arriving from the edit-form delete so a confirmation can be
    // shown on the list (Issue #10 — success message on delete).
    [Parameter, SupplyParameterFromQuery(Name = "deleted")]
    public string DeletedJobId { get; set; }

    private class StoppedJobInfo
    {
        public string Id { get; set; } = "";
        public string Cron { get; set; } = "";
        public string Queue { get; set; } = "default";
        public string TimeZone { get; set; }
        public string TypeName { get; set; } = "";
        public string MethodName { get; set; } = "";
        public DateTime? StoppedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(DeletedJobId))
        {
            // Arrived from the edit form after a successful delete (Issue #10).
            _successMessage = $"Recurring job '{DeletedJobId}' deleted successfully.";
        }

        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                await LoadData();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _jobs = Monitor.GetRecurringJobs();
            LoadStoppedJobs();
        });
    }

    private void LoadStoppedJobs()
    {
        _stoppedJobs.Clear();
        var stoppedIds = Monitor.GetStoppedRecurringJobIds();
        foreach (var id in stoppedIds)
        {
            var config = Monitor.GetStoppedJobConfig(id);
            if (config is null || config.ContainsKey("_deleted")) continue;

            DateTime? stoppedAt = null;
            if (config.TryGetValue("StoppedAt", out var stoppedAtStr) &&
                DateTime.TryParse(stoppedAtStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            {
                stoppedAt = parsed;
            }

            _stoppedJobs.Add(new StoppedJobInfo
            {
                Id = id,
                Cron = config.GetValueOrDefault("Cron") ?? "",
                Queue = config.GetValueOrDefault("Queue") ?? "default",
                TimeZone = config.GetValueOrDefault("TimeZoneId"),
                TypeName = config.GetValueOrDefault("TypeName") ?? "Unknown",
                MethodName = config.GetValueOrDefault("MethodName") ?? "Unknown",
                StoppedAt = stoppedAt
            });
        }
    }

    private async Task StopJob(string jobId)
    {
        await Task.Run(() => Monitor.StopRecurringJob(jobId));
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartJob(string jobId)
    {
        await Task.Run(() => Monitor.StartRecurringJob(jobId));
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private void HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _selectedJobs.Clear();
        _selectAll = false;
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id)
    {
        if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id);
        _selectAll = _jobs != null && _selectedJobs.Count == _jobs.Count;
    }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new(_jobs.Select(j => j.Id));
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }
    private async Task TriggerSelected()
    {
        await Task.Run(() => Monitor.TriggerRecurringJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private void ShowDeleteConfirm()
    {
        _showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        _showDeleteConfirm = false;
    }

    private async Task ConfirmDelete()
    {
        _showDeleteConfirm = false;
        var count = _selectedJobs.Count;
        await Task.Run(() => Monitor.RemoveRecurringJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        _successMessage = $"{count} recurring job(s) deleted successfully.";
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private static string GetJobName(RecurringJobDto dto) =>
        dto?.Job is null ? "(unknown)" : JobNameHelper.GetDisplayName(dto.Job, null);

    private static string GetLastStateClass(string state) => state switch
    {
        "Succeeded" => "text-success",
        "Failed" => "text-danger",
        _ => ""
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
