@page "/recurring"
@using global::Hangfire.Storage
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Recurring Jobs</PageTitle>

<div class="page-container">
    <h2 class="page-title">Recurring Jobs</h2>

    @if (_jobs is null)
    {
        <p class="text-muted">Loading...</p>
    }
    else
    {
        <div class="toolbar">
            <a class="btn btn--primary" href="/recurring/create">➕ Create Job</a>
            <button class="btn" disabled="@(!_selectedJobs.Any())" @onclick="TriggerSelected">
                ▶️ Trigger Now
            </button>
            <button class="btn btn--danger" disabled="@(!_selectedJobs.Any())" @onclick="RemoveSelected">
                🗑️ Remove
            </button>
        </div>

        @* Stopped Jobs Section *@
        @if (_stoppedJobs.Count > 0)
        {
            <div class="section-card section-card--muted">
                <h3>Stopped Jobs</h3>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Cron</th>
                            <th>Job</th>
                            <th>Queue</th>
                            <th>Stopped At</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stopped in _stoppedJobs)
                        {
                            <tr class="row-muted">
                                <td class="font-mono">@stopped.Id</td>
                                <td><code class="cron-badge">@stopped.Cron</code></td>
                                <td>@stopped.TypeName.@stopped.MethodName</td>
                                <td><span class="badge">@stopped.Queue</span></td>
                                <td>
                                    @if (stopped.StoppedAt.HasValue)
                                    {
                                        <RelativeTime UtcTime="@stopped.StoppedAt.Value" />
                                    }
                                </td>
                                <td>
                                    <button class="btn btn--sm btn--primary" @onclick="() => StartJob(stopped.Id)">
                                        ▶️ Start
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (_jobs.Count == 0 && _stoppedJobs.Count == 0)
        {
            <div class="empty-state">
                <span class="empty-icon">🔄</span>
                <p>No recurring jobs configured.</p>
            </div>
        }
        else if (_jobs.Count > 0)
        {
            <div class="section-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="col-check"><input type="checkbox" @onchange="ToggleAll" /></th>
                            <th>Id</th>
                            <th>Cron</th>
                            <th>Job</th>
                            <th>Queue</th>
                            <th>Next Execution</th>
                            <th>Last Execution</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in _jobs)
                        {
                            <tr>
                                <td class="col-check">
                                    <input type="checkbox" checked="@IsSelected(job.Id)" @onchange="() => ToggleJob(job.Id)" />
                                </td>
                                <td class="font-mono">@job.Id</td>
                                <td><code class="cron-badge">@job.Cron</code></td>
                                <td>@GetJobName(job)</td>
                                <td><span class="badge">@(job.Queue ?? "default")</span></td>
                                <td>
                                    @if (job.NextExecution.HasValue)
                                    {
                                        <RelativeTime UtcTime="@job.NextExecution.Value" IsFuture="true" />
                                    }
                                    else if (job.Error is not null)
                                    {
                                        <span class="badge badge--danger">Error</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge--muted">Disabled</span>
                                    }
                                </td>
                                <td>
                                    @if (job.LastExecution.HasValue)
                                    {
                                        <span class="@GetLastStateClass(job.LastJobState)">
                                            <RelativeTime UtcTime="@job.LastExecution.Value" />
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Never</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn--sm btn--warning" @onclick="() => StopJob(job.Id)" title="Stop this recurring job">
                                        ⏹️ Stop
                                    </button>
                                </td>
                            </tr>
                            @if (job.Error is not null)
                            {
                                <tr class="detail-row">
                                    <td></td>
                                    <td colspan="7">
                                        <div class="exception-detail">
                                            <p>@job.Error</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<RecurringJobDto>? _jobs;
    private List<StoppedJobInfo> _stoppedJobs = new();
    private HashSet<string> _selectedJobs = new();
    private Timer? _refreshTimer;

    private class StoppedJobInfo
    {
        public string Id { get; set; } = "";
        public string Cron { get; set; } = "";
        public string Queue { get; set; } = "default";
        public string TypeName { get; set; } = "";
        public string MethodName { get; set; } = "";
        public DateTime? StoppedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                await LoadData();
                await InvokeAsync(StateHasChanged);
            }
            catch { }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _jobs = Monitor.GetRecurringJobs();
            LoadStoppedJobs();
        });
    }

    private void LoadStoppedJobs()
    {
        _stoppedJobs.Clear();
        var stoppedIds = Monitor.GetStoppedRecurringJobIds();
        foreach (var id in stoppedIds)
        {
            var config = Monitor.GetStoppedJobConfig(id);
            if (config is null || config.ContainsKey("_deleted")) continue;

            DateTime? stoppedAt = null;
            if (config.TryGetValue("StoppedAt", out var stoppedAtStr) &&
                DateTime.TryParse(stoppedAtStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            {
                stoppedAt = parsed;
            }

            _stoppedJobs.Add(new StoppedJobInfo
            {
                Id = id,
                Cron = config.GetValueOrDefault("Cron") ?? "",
                Queue = config.GetValueOrDefault("Queue") ?? "default",
                TypeName = config.GetValueOrDefault("TypeName") ?? "Unknown",
                MethodName = config.GetValueOrDefault("MethodName") ?? "Unknown",
                StoppedAt = stoppedAt
            });
        }
    }

    private async Task StopJob(string jobId)
    {
        await Task.Run(() => Monitor.StopRecurringJob(jobId));
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartJob(string jobId)
    {
        await Task.Run(() => Monitor.StartRecurringJob(jobId));
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id) { if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id); }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobs is null) return;
        if ((bool)(e.Value ?? false)) _selectedJobs = new(_jobs.Select(j => j.Id));
        else _selectedJobs.Clear();
    }
    private async Task TriggerSelected()
    {
        await Task.Run(() => Monitor.TriggerRecurringJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveSelected()
    {
        await Task.Run(() => Monitor.RemoveRecurringJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
        await InvokeAsync(StateHasChanged);
    }

    private static string GetJobName(RecurringJobDto dto) =>
        dto.Job is null ? "Unknown" : $"{dto.Job.Type.Name}.{dto.Job.Method.Name}";

    private static string GetLastStateClass(string? state) => state switch
    {
        "Succeeded" => "text-success",
        "Failed" => "text-danger",
        _ => ""
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
