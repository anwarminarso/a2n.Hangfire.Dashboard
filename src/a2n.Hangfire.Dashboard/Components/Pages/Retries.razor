@page "/retries"
@inject HangfireMonitorService Monitor
@implements IDisposable

<PageTitle>Retries</PageTitle>

<h2 class="fw-semibold mb-3">Retries</h2>

@if (_jobIds is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_jobIds.Count == 0)
{
    <EmptyState Icon="arrow-clockwise" Color="secondary"
                Message="No jobs in retry."
                Subtitle="Jobs scheduled for retry after failure will appear here." />
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="EnqueueSelected">
                <i class="bi bi-arrow-repeat"></i> Enqueue
            </button>
            <button class="btn btn-outline-secondary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
                <i class="bi bi-x-lg"></i> Delete
            </button>
        </div>
        <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;"><input type="checkbox" class="form-check-input" checked="@_selectAll" @onchange="ToggleAll" /></th>
                            <th>Id</th>
                            <th>State</th>
                            <th>Job</th>
                            <th>Reason</th>
                            <th class="text-end">Retry</th>
                            <th class="text-end">Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jobId in _jobIds)
                        {
                            _jobInfo.TryGetValue(jobId, out var info);
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@IsSelected(jobId)" @onchange="() => ToggleJob(jobId)" />
                                </td>
                                <td>
                                    <a href="jobs/details/@jobId" class="font-monospace">@ShortenId(jobId)</a>
                                </td>
                                <td><span class="badge bg-secondary">@(info.state ?? "Scheduled")</span></td>
                                <td>@(info.jobName ?? "Unknown")</td>
                                <td class="text-body-secondary">@(info.reason ?? "")</td>
                                <td class="text-end">
                                    @if (info.retryAt.HasValue)
                                    {
                                        <RelativeTime UtcTime="@info.retryAt.Value" IsFuture="true" />
                                    }
                                </td>
                                <td class="text-end">
                                    @if (info.createdAt.HasValue)
                                    {
                                        <RelativeTime UtcTime="@info.createdAt.Value" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <Pager TotalCount="@_totalCount" PageSize="@_pageSize" From="@_from"
           OnPageChanged="HandlePageChanged" />
}

@code {
    private IReadOnlyList<string> _jobIds;
    private Dictionary<string, (string jobName, string state, string reason, DateTime? retryAt, DateTime? createdAt)> _jobInfo = new();
    private HashSet<string> _selectedJobs = new();
    private bool _selectAll;
    private long _totalCount;
    private int _from = 0;
    private int _pageSize = 20;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var count = Monitor.GetSetCount("retries");
                if (count != _totalCount)
                {
                    await LoadData();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _totalCount = Monitor.GetSetCount("retries");
            _jobIds = Monitor.GetSetJobIds("retries", _from, _pageSize);
            _jobInfo.Clear();
            if (_jobIds is not null)
            {
                foreach (var jobId in _jobIds)
                {
                    var detail = Monitor.GetJobDetails(jobId);
                    var jobName = detail is not null
                        ? Helpers.JobNameHelper.GetDisplayName(detail.Job, detail.InvocationData)
                        : null;
                    var currentState = detail?.History?.FirstOrDefault();
                    var state = currentState?.StateName;
                    var reason = currentState?.Reason;
                    DateTime? retryAt = null;
                    DateTime? createdAt = detail?.CreatedAt;

                    // Try to get EnqueueAt from state data
                    if (currentState?.Data != null && currentState.Data.TryGetValue("EnqueueAt", out var enqueueAtStr))
                    {
                        if (DateTime.TryParse(enqueueAtStr, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
                        {
                            retryAt = parsed;
                        }
                    }

                    _jobInfo[jobId] = (jobName, state, reason, retryAt, createdAt);
                }
            }
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id)
    {
        if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id);
        _selectAll = _jobIds != null && _selectedJobs.Count == _jobIds.Count;
    }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobIds is null) return;
        if ((bool)(e.Value ?? false))
        {
            _selectedJobs = new(_jobIds);
            _selectAll = true;
        }
        else
        {
            _selectedJobs.Clear();
            _selectAll = false;
        }
    }

    private async Task EnqueueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        _selectAll = false;
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
