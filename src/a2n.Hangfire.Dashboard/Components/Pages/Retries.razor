@page "/retries"
@inject HangfireMonitorService Monitor

<PageTitle>Retries</PageTitle>

@if (_jobIds is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_jobIds.Count == 0)
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-arrow-clockwise fs-1 text-body-secondary"></i>
            <p class="mt-3 mb-1">No jobs in retry.</p>
            <p class="text-body-secondary">Jobs scheduled for retry after failure will appear here.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex gap-2 mb-2">
        <button class="btn btn-primary btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="EnqueueSelected">
            <i class="bi bi-play-fill me-1"></i>Enqueue Now
        </button>
        <button class="btn btn-danger btn-sm" disabled="@(!_selectedJobs.Any())" @onclick="DeleteSelected">
            <i class="bi bi-trash me-1"></i>Delete
        </button>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th style="width: 40px;"><input type="checkbox" class="form-check-input" @onchange="ToggleAll" /></th>
                            <th>Id</th>
                            <th>Job</th>
                            <th>State</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var jobId in _jobIds)
                        {
                            _jobInfo.TryGetValue(jobId, out var info);
                            <tr>
                                <td>
                                    <input type="checkbox" class="form-check-input" checked="@IsSelected(jobId)" @onchange="() => ToggleJob(jobId)" />
                                </td>
                                <td>
                                    <a href="/jobs/details/@jobId" class="text-decoration-none font-monospace">@ShortenId(jobId)</a>
                                </td>
                                <td>@(info.jobName ?? "Unknown")</td>
                                <td><span class="badge bg-secondary">@(info.state ?? "Scheduled")</span></td>
                                <td class="text-body-secondary">@(info.reason ?? "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="text-body-secondary mt-2 small">@_jobIds.Count jobs in retry</div>
}

@code {
    private IReadOnlyList<string> _jobIds;
    private Dictionary<string, (string jobName, string state, string reason)> _jobInfo = new();
    private HashSet<string> _selectedJobs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _jobIds = Monitor.GetSetJobIds("retries", 0, 50);
            _jobInfo.Clear();
            if (_jobIds is not null)
            {
                foreach (var jobId in _jobIds)
                {
                    var detail = Monitor.GetJobDetails(jobId);
                    var jobName = detail?.Job is not null ? $"{detail.Job.Type.Name}.{detail.Job.Method.Name}" : null;
                    var state = detail?.History.FirstOrDefault()?.StateName;
                    var reason = detail?.History.FirstOrDefault()?.Reason;
                    _jobInfo[jobId] = (jobName, state, reason);
                }
            }
        });
    }

    private bool IsSelected(string id) => _selectedJobs.Contains(id);
    private void ToggleJob(string id) { if (!_selectedJobs.Remove(id)) _selectedJobs.Add(id); }
    private void ToggleAll(ChangeEventArgs e)
    {
        if (_jobIds is null) return;
        if ((bool)(e.Value ?? false)) _selectedJobs = new(_jobIds);
        else _selectedJobs.Clear();
    }

    private async Task EnqueueSelected()
    {
        await Task.Run(() => Monitor.RequeueJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private async Task DeleteSelected()
    {
        await Task.Run(() => Monitor.DeleteJobs(_selectedJobs));
        _selectedJobs.Clear();
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";
}
