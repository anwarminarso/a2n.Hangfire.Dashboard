@*
    Recurring create/edit route (Req 11.1, 11.4).

    This page is now a thin host: it owns the routes `/recurring/create` and
    `/recurring/edit/{JobId}` and delegates the entire job-construction form to the shared
    JobBuilder component running in Recurring mode (Req 11.1). The prior hand-rolled form
    (class/method/parameter/cron/queue/time-zone fields + Save logic) has been removed; JobBuilder
    is the sole job-construction surface and handles submit + navigation back to the recurring jobs
    list on success (Req 11.4).

    For edit mode this page loads the existing recurring job and feeds JobBuilder its Initial*
    parameters so pre-fill is preserved (Req 3.x): the Parameter_JSON is rebuilt positionally from
    the stored Args exactly as the previous form did, and cron/queue/time-zone come from the stored
    definition. The recurring-admin-disabled guard is preserved — JobBuilder renders the disabled
    banner and makes the mutating controls inert.
*@
@page "/recurring/create"
@page "/recurring/edit/{JobId}"
@inject HangfireMonitorService Monitor

<PageTitle>@(_isEdit ? "Edit" : "Create") Recurring Job</PageTitle>

<div style="max-width: 720px;">
    <h2 class="mb-3">@(_isEdit ? "Edit" : "Create") Recurring Job</h2>

    @if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger">@_loadError</div>
    }

    @* JobBuilder is the sole job-construction form (Req 11.1). It renders the read-only and
       recurring-admin-disabled banners, gates the mutating controls, and on success navigates to
       the recurring jobs list (Req 4.x, 11.4). Initial* values preserve edit pre-fill (Req 3.x). *@
    <JobBuilder Mode="JobBuilderMode.Recurring"
                JobId="@JobId"
                InitialTypeName="@_initialTypeName"
                InitialMethodName="@_initialMethodName"
                InitialParameterJson="@_initialParameterJson"
                InitialCron="@_initialCron"
                InitialQueue="@_initialQueue"
                InitialTimeZoneId="@_initialTimeZoneId" />
</div>

@code {
    [Parameter] public string JobId { get; set; }

    private bool _isEdit => !string.IsNullOrEmpty(JobId);

    // Initial values passed to JobBuilder for edit pre-fill (Req 3.x). Empty for create.
    private string _initialTypeName = "";
    private string _initialMethodName = "";
    private string _initialParameterJson = "[]";
    private string _initialCron = "";
    private string _initialQueue = "";
    private string _initialTimeZoneId = "";
    private string _loadError;

    protected override void OnInitialized()
    {
        if (_isEdit)
        {
            // Load the existing recurring job and feed its values to JobBuilder so the edit form is
            // pre-filled (Req 3.3): cron/queue/time-zone come from the stored definition; absent
            // fields stay empty rather than substituting a placeholder (Req 3.4).
            var jobs = Monitor.GetRecurringJobs();
            var existing = jobs.FirstOrDefault(j => j.Id == JobId);
            if (existing is not null)
            {
                // Target type/method drive the Method Picker's edit pre-selection so the parameter
                // form renders and the stored Args pre-fill (Req 3.1, 3.3, 11.2). Absent fields stay
                // empty rather than substituting a placeholder (Req 3.4).
                _initialTypeName = existing.Job?.Type?.FullName ?? "";
                _initialMethodName = existing.Job?.Method?.Name ?? "";

                _initialCron = existing.Cron ?? "";
                _initialQueue = existing.Queue ?? "";
                _initialTimeZoneId = existing.TimeZoneId ?? "";

                // Pre-fill the Parameter_JSON positionally from the stored Args (Req 3.1, 3.2, 3.5).
                _initialParameterJson = BuildParameterJson(existing.Job?.Args);
            }
        }
    }

    /// <summary>
    /// Builds the operator-facing Parameter_JSON from a recurring job's stored <c>Args</c>.
    /// The stored Args are positional over ALL declared parameters (injected slots stored as null),
    /// so they are serialized one-to-one into a JSON array (Req 3.1). An absent or empty Args
    /// yields an empty array <c>[]</c> (Req 3.2). When the stored Args cannot be serialized, the
    /// best-effort representation is preserved and an interpretation error is shown (Req 3.5).
    /// </summary>
    private string BuildParameterJson(IReadOnlyList<object> args)
    {
        if (args is null || args.Count == 0)
            return "[]";

        try
        {
            return System.Text.Json.JsonSerializer.Serialize(args);
        }
        catch (Exception ex)
        {
            _loadError = "The stored arguments could not be interpreted as valid parameter JSON: " + ex.Message;
            // Preserve the stored arguments unchanged for the operator to review (Req 3.5).
            return "[" + string.Join(", ", args.Select(a => a?.ToString() ?? "null")) + "]";
        }
    }
}
