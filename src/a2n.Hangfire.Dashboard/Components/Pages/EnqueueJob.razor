@*
    Enqueue Job page (Req 12.1, 12.2) — a thin host that renders the JobBuilder composite in
    Enqueue mode. In this mode the JobBuilder hides the Schedule_Builder entirely and requires no
    cron (Req 12.1), presents the Method_Picker and Parameter_Builder, and exposes a queue selector
    defaulting to "default" (Req 12.2).

    Access: the page is gated behind EnableJobManagement. When job management is disabled the route
    must behave as if it does not exist — it renders a Not Found surface and never shows the builder
    (Req 6). Read-only gating is handled by the JobBuilder itself, which renders its own persistent
    read-only banner and disables the mutating controls (Req 4.1, 4.2).
*@
@page "/jobs/enqueue"
@inject DashboardUIOptions Options

<PageTitle>@(_available ? "Enqueue Job" : "Not Found")</PageTitle>

@if (!_available)
{
    @* Job management is disabled — present the route as Not Found (Req 6). *@
    <div class="text-center py-5">
        <i class="bi bi-question-circle display-1 text-body-secondary"></i>
        <h1 class="h3 mt-3">Page not found</h1>
        <p class="text-body-secondary">The page you requested is not available.</p>
        <a class="btn btn-outline-secondary" href="jobs/enqueued">
            <i class="bi bi-arrow-left"></i> Back to Enqueued jobs
        </a>
    </div>
}
else
{
    <div style="max-width: 720px;">
        <h2 class="mb-3">Enqueue Job</h2>

        <JobBuilder Mode="JobBuilderMode.Enqueue" />
    </div>
}

@code {
    // Captured once on init so the gate decision is stable for the lifetime of the page.
    private bool _available;

    protected override void OnInitialized() => _available = Options.EnableJobManagement;
}
