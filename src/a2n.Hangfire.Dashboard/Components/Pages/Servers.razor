@page "/servers"
@inject HangfireMonitorService Monitor

<PageTitle>Servers</PageTitle>

@if (_servers is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_servers.Count == 0)
{
    <EmptyState Icon="hdd-stack" Color="warning"
                Message="No active servers found."
                Subtitle="Jobs will not be processed until a server is started." />
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Workers</th>
                            <th>Queues</th>
                            <th>Started</th>
                            <th>Heartbeat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in _servers)
                        {
                            <tr>
                                <td>
                                    @if (IsServerHealthy(server))
                                    {
                                        <span class="d-inline-block rounded-circle bg-success me-2" style="width: 8px; height: 8px;"></span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-block rounded-circle bg-danger me-2" style="width: 8px; height: 8px;"></span>
                                    }
                                    <ServerLabel FullId="@server.Name" />
                                </td>
                                <td>@server.WorkersCount</td>
                                <td>
                                    @foreach (var queue in server.Queues)
                                    {
                                        <span class="badge bg-secondary me-1">@queue</span>
                                    }
                                </td>
                                <td>@FormatRelativeTime(server.StartedAt)</td>
                                <td>
                                    @if (server.Heartbeat.HasValue)
                                    {
                                        @FormatRelativeTime(server.Heartbeat.Value)
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private IList<ServerDto> _servers;

    protected override async Task OnInitializedAsync()
    {
        await Task.Run(() => { _servers = Monitor.GetServers(); });
    }

    private static bool IsServerHealthy(ServerDto server)
    {
        if (!server.Heartbeat.HasValue) return false;
        return (DateTime.UtcNow - server.Heartbeat.Value).TotalMinutes < 2;
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }
}
