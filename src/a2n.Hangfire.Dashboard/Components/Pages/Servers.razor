@page "/servers"
@inject HangfireMonitorService Monitor

<PageTitle>Servers</PageTitle>

@if (_servers is null)
{
    <p class="text-body-secondary">Loading...</p>
}
else if (_servers.Count == 0)
{
    <EmptyState Icon="hdd-stack" Color="warning"
                Message="No active servers found."
                Subtitle="Jobs will not be processed until a server is started." />
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <SortableHeader Label="Name" IsActive="@_sort.IsActive(ServerSortColumn.Name)"
                                            Descending="@_sort.Descending" OnSort="() => _sort.Toggle(ServerSortColumn.Name)" />
                            <SortableHeader Label="Workers" IsActive="@_sort.IsActive(ServerSortColumn.Workers)"
                                            Descending="@_sort.Descending" OnSort="() => _sort.Toggle(ServerSortColumn.Workers)" />
                            <th>Queues</th>
                            <SortableHeader Label="Started" IsActive="@_sort.IsActive(ServerSortColumn.Started)"
                                            Descending="@_sort.Descending" OnSort="() => _sort.Toggle(ServerSortColumn.Started)" />
                            <SortableHeader Label="Heartbeat" IsActive="@_sort.IsActive(ServerSortColumn.Heartbeat)"
                                            Descending="@_sort.Descending" OnSort="() => _sort.Toggle(ServerSortColumn.Heartbeat)" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in SortedServers)
                        {
                            <tr>
                                <td>
                                    @if (IsServerHealthy(server))
                                    {
                                        <span class="d-inline-block rounded-circle bg-success me-2" style="width: 8px; height: 8px;"></span>
                                    }
                                    else
                                    {
                                        <span class="d-inline-block rounded-circle bg-danger me-2" style="width: 8px; height: 8px;"></span>
                                    }
                                    <ServerLabel FullId="@server.Name" />
                                </td>
                                <td>@server.WorkersCount</td>
                                <td>
                                    @foreach (var queue in server.Queues)
                                    {
                                        <QueueBadge Queue="@queue" CssClass="me-1" />
                                    }
                                </td>
                                <td>@FormatRelativeTime(server.StartedAt)</td>
                                <td>
                                    @if (server.Heartbeat.HasValue)
                                    {
                                        @FormatRelativeTime(server.Heartbeat.Value)
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary">N/A</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private IList<ServerDto> _servers;

    private enum ServerSortColumn { None, Name, Workers, Started, Heartbeat }

    private readonly GridSortState<ServerSortColumn> _sort = new();

    private IEnumerable<ServerDto> SortedServers
    {
        get
        {
            var descending = _sort.Descending;
            IOrderedEnumerable<ServerDto> ordered = _sort.Column switch
            {
                ServerSortColumn.Name =>
                    GridSort.By(_servers, s => s.Name, s => !string.IsNullOrEmpty(s.Name), StringComparer.OrdinalIgnoreCase, descending),
                ServerSortColumn.Workers =>
                    GridSort.By(_servers, s => s.WorkersCount, _ => true, Comparer<int>.Default, descending),
                ServerSortColumn.Started =>
                    GridSort.By(_servers, s => s.StartedAt, _ => true, Comparer<DateTime>.Default, descending),
                ServerSortColumn.Heartbeat =>
                    GridSort.By(_servers, s => s.Heartbeat, s => s.Heartbeat.HasValue, Comparer<DateTime?>.Default, descending),
                _ => null
            };
            return ordered?.ThenBy(s => s.Name, StringComparer.OrdinalIgnoreCase) ?? (IEnumerable<ServerDto>)_servers;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.Run(() => { _servers = Monitor.GetServers(); });
    }

    private static bool IsServerHealthy(ServerDto server)
    {
        if (!server.Heartbeat.HasValue) return false;
        return (DateTime.UtcNow - server.Heartbeat.Value).TotalMinutes < 2;
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }
}
