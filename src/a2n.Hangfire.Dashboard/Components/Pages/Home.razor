@page "/"
@inject HangfireMonitorService Monitor
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-home">
    @if (_stats is not null)
    {
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-value">@_stats.Servers</div>
                <div class="stat-label">Servers</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_stats.Recurring</div>
                <div class="stat-label">Recurring</div>
            </div>
            <div class="stat-card stat-card--info">
                <div class="stat-value">@_stats.Enqueued</div>
                <div class="stat-label">Enqueued</div>
            </div>
            <div class="stat-card stat-card--warning">
                <div class="stat-value">@_stats.Processing</div>
                <div class="stat-label">Processing</div>
            </div>
            <div class="stat-card stat-card--success">
                <div class="stat-value">@FormatCount(_stats.Succeeded)</div>
                <div class="stat-label">Succeeded</div>
            </div>
            <div class="stat-card stat-card--danger">
                <div class="stat-value">@_stats.Failed</div>
                <div class="stat-label">Failed</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_stats.Scheduled</div>
                <div class="stat-label">Scheduled</div>
            </div>
            <div class="stat-card">
                <div class="stat-value">@_stats.Deleted</div>
                <div class="stat-label">Deleted</div>
            </div>
        </div>
    }
    else
    {
        <div class="stats-grid">
            @for (var i = 0; i < 8; i++)
            {
                <div class="stat-card stat-card--loading">
                    <div class="stat-value skeleton">&nbsp;</div>
                    <div class="stat-label skeleton">&nbsp;</div>
                </div>
            }
        </div>
    }

    <div class="charts-section">
        <div class="chart-card">
            <h3>Realtime <span class="chart-legend"><span class="legend-dot legend-dot--success"></span>Succeeded <span class="legend-dot legend-dot--danger"></span>Failed</span></h3>
            <canvas id="realtimeChart" style="width:100%; height:180px;"></canvas>
        </div>
        <div class="chart-card">
            <h3>History (24h) <span class="chart-legend"><span class="legend-dot legend-dot--success"></span>Succeeded <span class="legend-dot legend-dot--danger"></span>Failed</span></h3>
            <canvas id="historyChart" style="width:100%; height:180px;"></canvas>
        </div>
    </div>

    @if (_servers is not null && _servers.Count > 0)
    {
        <div class="section-card">
            <h3>Servers</h3>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Workers</th>
                        <th>Queues</th>
                        <th>Started</th>
                        <th>Heartbeat</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var server in _servers)
                    {
                        <tr>
                            <td class="font-mono">@ShortenServerId(server.Name)</td>
                            <td>@server.WorkersCount</td>
                            <td>@string.Join(", ", server.Queues)</td>
                            <td>@FormatRelativeTime(server.StartedAt)</td>
                            <td>
                                @if (server.Heartbeat.HasValue)
                                {
                                    <span class="status-dot status-dot--active"></span>
                                    @FormatRelativeTime(server.Heartbeat.Value)
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private StatisticsDto? _stats;
    private IList<ServerDto>? _servers;
    private Timer? _refreshTimer;
    private long _prevSucceeded;
    private long _prevFailed;
    private bool _chartsInitialized;

    protected override async Task OnInitializedAsync()
    {
        await Task.Run(() =>
        {
            _stats = Monitor.GetStatistics();
            _servers = Monitor.GetServers();
        });

        if (_stats is not null)
        {
            _prevSucceeded = _stats.Succeeded;
            _prevFailed = _stats.Failed;
        }

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var stats = Monitor.GetStatistics();
                var servers = Monitor.GetServers();

                var deltaSucceeded = Math.Max(0, stats.Succeeded - _prevSucceeded);
                var deltaFailed = Math.Max(0, stats.Failed - _prevFailed);
                _prevSucceeded = stats.Succeeded;
                _prevFailed = stats.Failed;

                await InvokeAsync(async () =>
                {
                    _stats = stats;
                    _servers = servers;
                    StateHasChanged();

                    if (_chartsInitialized)
                    {
                        await JS.InvokeVoidAsync("dashboardCharts.updateRealtimeChart", deltaSucceeded, deltaFailed);
                    }
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chartsInitialized = true;
            await JS.InvokeVoidAsync("dashboardCharts.initRealtimeChart", "realtimeChart");

            // Load history data
            try
            {
                var hourlySucceeded = Monitor.GetHourlySucceededJobs();
                var hourlyFailed = Monitor.GetHourlyFailedJobs();

                var succeededValues = hourlySucceeded.Values.ToArray();
                var failedValues = hourlyFailed.Values.ToArray();

                await JS.InvokeVoidAsync("dashboardCharts.initHistoryChart", "historyChart", succeededValues, failedValues);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private static string FormatCount(long count)
    {
        return count switch
        {
            >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
            >= 1_000 => $"{count / 1_000.0:F1}K",
            _ => count.ToString("N0")
        };
    }

    private static string ShortenServerId(string serverId)
    {
        var parts = serverId.Split(':');
        return parts.Length > 1
            ? string.Join(":", parts.Take(parts.Length - 1))
            : serverId;
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }
}
