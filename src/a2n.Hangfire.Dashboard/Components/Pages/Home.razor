@page "/"
@inject HangfireMonitorService Monitor
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

@if (_stats is not null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-hdd-stack fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Servers</div>
                        <small class="text-body-secondary">Servers</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-arrow-repeat fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Recurring</div>
                        <small class="text-body-secondary">Recurring</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-info">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-inbox fs-4 text-info"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Enqueued</div>
                        <small class="text-body-secondary">Enqueued</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-warning">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-gear fs-4 text-warning"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Processing</div>
                        <small class="text-body-secondary">Processing</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-success">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle fs-4 text-success"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@FormatCount(_stats.Succeeded)</div>
                        <small class="text-body-secondary">Succeeded</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card border-danger">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-x-circle fs-4 text-danger"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Failed</div>
                        <small class="text-body-secondary">Failed</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-clock fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Scheduled</div>
                        <small class="text-body-secondary">Scheduled</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-trash fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Deleted</div>
                        <small class="text-body-secondary">Deleted</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @for (var i = 0; i < 8; i++)
        {
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="placeholder col-2"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-4 placeholder-lg"></span>
                            <span class="placeholder col-6 placeholder-sm"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title mb-3">Realtime Graph</h6>
                <div style="position: relative; height:40vh; width:100%">
                    <canvas id="realtimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="card-title mb-0">History Graph</h6>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-secondary active" disabled>Day</button>
                        <button type="button" class="btn btn-outline-secondary" disabled>Week</button>
                    </div>
                </div>
                <div style="position: relative; height:40vh; width:100%">
                    <canvas id="historyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_servers is not null && _servers.Count > 0)
{
    <div class="card">
        <div class="card-body">
            <h6 class="card-title">Servers</h6>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Workers</th>
                            <th>Queues</th>
                            <th>Started</th>
                            <th>Heartbeat</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in _servers)
                        {
                            <tr>
                                <td class="font-monospace">@ShortenServerId(server.Name)</td>
                                <td>@server.WorkersCount</td>
                                <td>@string.Join(", ", server.Queues)</td>
                                <td>@FormatRelativeTime(server.StartedAt)</td>
                                <td>
                                    @if (server.Heartbeat.HasValue)
                                    {
                                        <span class="d-inline-block rounded-circle bg-success me-1" style="width:8px;height:8px;"></span>
                                        @FormatRelativeTime(server.Heartbeat.Value)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private StatisticsDto _stats;
    private IList<ServerDto> _servers;
    private Timer _refreshTimer;
    private long _prevSucceeded;
    private long _prevDeleted;
    private long _prevFailed;
    private bool _chartsInitialized;

    protected override async Task OnInitializedAsync()
    {
        await Task.Run(() =>
        {
            _stats = Monitor.GetStatistics();
            _servers = Monitor.GetServers();
        });

        if (_stats is not null)
        {
            _prevSucceeded = _stats.Succeeded;
            _prevFailed = _stats.Failed;
        }

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var stats = Monitor.GetStatistics();
                var servers = Monitor.GetServers();

                var deltaSucceeded = Math.Max(0, stats.Succeeded - _prevSucceeded);
                var deltaFailed = Math.Max(0, stats.Failed - _prevFailed);
                var deltaDeleted = Math.Max(0, stats.Deleted - _prevDeleted);
                _prevSucceeded = stats.Succeeded;
                _prevFailed = stats.Failed;
                _prevDeleted = stats.Deleted;

                await InvokeAsync(async () =>
                {
                    _stats = stats;
                    _servers = servers;
                    StateHasChanged();

                    if (_chartsInitialized)
                    {
                        await JS.InvokeVoidAsync("dashboardCharts.updateRealtimeChart", deltaSucceeded, deltaFailed, deltaDeleted);
                    }
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _chartsInitialized = true;
            await JS.InvokeVoidAsync("dashboardCharts.initRealtimeChart", "realtimeChart");

            // Load history data
            try
            {
                var hourlySucceeded = Monitor.GetHourlySucceededJobs();
                var hourlyFailed = Monitor.GetHourlyFailedJobs();

                var succeededValues = hourlySucceeded.Values.ToArray();
                var failedValues = hourlyFailed.Values.ToArray();

                await JS.InvokeVoidAsync("dashboardCharts.initHistoryChart", "historyChart", succeededValues, failedValues);
            }
            catch { }
        }
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }

    private static string FormatCount(long count)
    {
        return count switch
        {
            >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
            >= 1_000 => $"{count / 1_000.0:F1}K",
            _ => count.ToString("N0")
        };
    }

    private static string ShortenServerId(string serverId)
    {
        var parts = serverId.Split(':');
        return parts.Length > 1
            ? string.Join(":", parts.Take(parts.Length - 1))
            : serverId;
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }
}
