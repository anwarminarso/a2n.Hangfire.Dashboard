@page "/"
@inject HangfireMonitorService Monitor
@inject DashboardMetricsFeed MetricsFeed
@inject DashboardPolling Polling
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

@* When the metrics shown were read (UTC ticks), changing on every realtime update, so a browser test
   can tell an update arrived even when no count changed. Not displayed. *@
<span hidden data-testid="metrics-snapshot" data-snapshot-at="@_snapshotAtTicks"></span>

<HealthHeroCard />

@if (_stats is not null)
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <button type="button"
                class="hf-stats-toggle @(_statsExpanded ? "hf-stats-toggle--expanded" : "")"
                @onclick="ToggleStats"
                aria-expanded="@_statsExpanded.ToString().ToLowerInvariant()"
                aria-controls="hf-detailed-metrics">
            <i class="bi bi-chevron-right"></i>
            <span>Detailed metrics</span>
            <span class="hf-stats-toggle-count">8</span>
        </button>
    </div>
}

@if (_stats is null)
{
    @* Initial load — show skeleton until first data arrives *@
    <div class="row g-3 mb-4">
        @for (var i = 0; i < 8; i++)
        {
            <div class="col-6 col-md-4 col-xl-3">
                <div class="card">
                    <div class="card-body d-flex align-items-center gap-3">
                        <span class="placeholder col-2"></span>
                        <div class="flex-grow-1">
                            <span class="placeholder col-4 placeholder-lg"></span>
                            <span class="placeholder col-6 placeholder-sm"></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (_statsExpanded)
{
    <div class="row g-3 mb-4" id="hf-detailed-metrics">
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-secondary">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-hdd-stack fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Servers</div>
                        <small class="text-body-secondary">Servers</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-secondary">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-arrow-repeat fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Recurring</div>
                        <small class="text-body-secondary">Recurring</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-info">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-inbox fs-4 text-info"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Enqueued</div>
                        <small class="text-body-secondary">Enqueued</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-warning">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-gear fs-4 text-warning"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Processing</div>
                        <small class="text-body-secondary">Processing</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-success">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-check-circle fs-4 text-success"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@FormatCount(_stats.Succeeded)</div>
                        <small class="text-body-secondary">Succeeded</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-danger">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-x-circle fs-4 text-danger"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Failed</div>
                        <small class="text-body-secondary">Failed</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-warning">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-clock fs-4 text-warning"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Scheduled</div>
                        <small class="text-body-secondary">Scheduled</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-3">
            <div class="card hf-stat-border-secondary">
                <div class="card-body d-flex align-items-center gap-3">
                    <i class="bi bi-trash fs-4 text-secondary"></i>
                    <div>
                        <div class="fs-5 fw-semibold">@_stats.Deleted</div>
                        <small class="text-body-secondary">Deleted</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <h6 class="card-title mb-3">Realtime Graph</h6>
                <div style="position: relative; height:40vh; width:100%">
                    <canvas id="realtimeChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <h6 class="card-title mb-0">History Graph</h6>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn @GetHistoryBtnClass("day")"
                                @onclick="OnDayClick">Day</button>
                        <button type="button" class="btn @GetHistoryBtnClass("week")"
                                @onclick="OnWeekClick">Week</button>
                    </div>
                </div>
                <div style="position: relative; height:40vh; width:100%">
                    <canvas id="historyChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@if (_servers is not null && _servers.Count > 0)
{
    <div class="card">
        <div class="card-body">
            <h6 class="card-title">Servers</h6>
            <div class="table-responsive hf-grid">
                <table class="table table-hover table-sm mb-0 hf-stack">
                    <thead>
                        <tr>
                            <SortableHeader Label="Name" IsActive="@_serverSort.IsActive(ServerSort.Name)"
                                            Descending="@_serverSort.Descending" OnSort="() => _serverSort.Toggle(ServerSort.Name)" />
                            <SortableHeader Label="Workers" IsActive="@_serverSort.IsActive(ServerSort.Workers)"
                                            Descending="@_serverSort.Descending" OnSort="() => _serverSort.Toggle(ServerSort.Workers)" />
                            <th>Queues</th>
                            <SortableHeader Label="Started" CssClass="hf-col-p1" IsActive="@_serverSort.IsActive(ServerSort.Started)"
                                            Descending="@_serverSort.Descending" OnSort="() => _serverSort.Toggle(ServerSort.Started)" />
                            <SortableHeader Label="Heartbeat" IsActive="@_serverSort.IsActive(ServerSort.Heartbeat)"
                                            Descending="@_serverSort.Descending" OnSort="() => _serverSort.Toggle(ServerSort.Heartbeat)" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var server in SortedServers)
                        {
                            <tr>
                                <td class="hf-cell-title"><ServerLabel FullId="@server.Name" /></td>
                                <td class="hf-cell-meta" data-label="Workers">@server.WorkersCount</td>
                                <td class="hf-cell-meta" data-label="Queues">@string.Join(", ", server.Queues)</td>
                                <td class="hf-cell-meta hf-nowrap hf-col-p1" data-label="Started">@FormatRelativeTime(server.StartedAt)</td>
                                <td class="hf-cell-meta hf-nowrap" data-label="Heartbeat">
                                    @if (server.Heartbeat.HasValue)
                                    {
                                        <span class="d-inline-block rounded-circle bg-success me-1" style="width:8px;height:8px;"></span>
                                        @FormatRelativeTime(server.Heartbeat.Value)
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private StatisticsDto _stats;
    private IReadOnlyList<ServerDto> _servers;

    private enum ServerSort { None, Name, Workers, Started, Heartbeat }

    private readonly GridSortState<ServerSort> _serverSort = new();

    private IEnumerable<ServerDto> SortedServers => GridSort.Apply(_servers, _serverSort, column => column switch
    {
        ServerSort.Name => s => s.Name,
        ServerSort.Workers => s => s.WorkersCount,
        ServerSort.Started => s => s.StartedAt,
        ServerSort.Heartbeat => s => s.Heartbeat,
        _ => null
    }, s => s.Name);
    private IDisposable _metricsSubscription;
    private long _snapshotAtTicks;
    private long _prevSucceeded;
    private long _prevDeleted;
    private long _prevFailed;
    private bool _chartsInitialized;
    private string _historyPeriod = "day";

    // Cancels the history reads' wait when the page goes away.
    private readonly CancellationTokenSource _disposed = new();
    // Detailed metrics grid is expanded by default. The user's choice is persisted to
    // localStorage (see prefs.js) and restored on first render, mirroring the theme preference.
    private bool _statsExpanded = true;
    private const string StatsExpandedPrefKey = "home.statsExpanded";

    private string GetHistoryBtnClass(string period) =>
        _historyPeriod == period ? "btn-secondary" : "btn-outline-secondary";

    private Task OnDayClick() => SwitchHistoryPeriod("day");
    private Task OnWeekClick() => SwitchHistoryPeriod("week");

    private async Task ToggleStats()
    {
        _statsExpanded = !_statsExpanded;
        try
        {
            await JS.InvokeVoidAsync("dashboardPrefs.setBool", StatsExpandedPrefKey, _statsExpanded);
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        // Shared snapshot: reused across tabs and between the prerender and the interactive render
        // while it is fresh, so opening the page doesn't add a storage read per render.
        var snapshot = await MetricsFeed.GetMetricsAsync();
        _stats = snapshot.Statistics;
        _servers = snapshot.Servers;
        _snapshotAtTicks = snapshot.CapturedAtUtc.Ticks;
        _prevSucceeded = _stats.Succeeded;
        _prevFailed = _stats.Failed;
        _prevDeleted = _stats.Deleted;
    }

    // Realtime updates from the in-process feed. The payload already carries statistics and
    // servers, so no storage read happens here.
    private Task OnMetricsAsync(DashboardMetricsSnapshot snapshot) => InvokeAsync(async () =>
    {
        var stats = snapshot.Statistics;
        var deltaSucceeded = Math.Max(0, stats.Succeeded - _prevSucceeded);
        var deltaFailed = Math.Max(0, stats.Failed - _prevFailed);
        var deltaDeleted = Math.Max(0, stats.Deleted - _prevDeleted);
        _prevSucceeded = stats.Succeeded;
        _prevFailed = stats.Failed;
        _prevDeleted = stats.Deleted;

        _stats = stats;
        _servers = snapshot.Servers;
        _snapshotAtTicks = snapshot.CapturedAtUtc.Ticks;
        StateHasChanged();

        if (_chartsInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("dashboardCharts.updateRealtimeChart", deltaSucceeded, deltaFailed, deltaDeleted);
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Subscribe only once interactive: OnAfterRender never runs during prerendering, so
            // the prerender pass does no subscription work.
            _metricsSubscription ??= MetricsFeed.SubscribeMetrics(OnMetricsAsync);

            // Restore the persisted "Detailed metrics" expand/collapse preference (default: expanded).
            try
            {
                var expanded = await JS.InvokeAsync<bool>("dashboardPrefs.getBool", StatsExpandedPrefKey, true);
                if (expanded != _statsExpanded)
                {
                    _statsExpanded = expanded;
                    StateHasChanged();
                }
            }
            catch { }

            _chartsInitialized = true;
            await JS.InvokeVoidAsync("dashboardCharts.initRealtimeChart", "realtimeChart");

            // Load history data
            try
            {
                var (succeededValues, failedValues) = await ReadHistoryAsync("day");
                await JS.InvokeVoidAsync("dashboardCharts.initHistoryChart", "historyChart", succeededValues, failedValues);
            }
            catch { }
        }
    }

    // Through the storage gate, off the circuit's thread: called synchronously here, a slow storage
    // blocked one thread-pool thread and the circuit per open Home tab (issue #64).
    private Task<(long[] Succeeded, long[] Failed)> ReadHistoryAsync(string period)
        => Polling.ReadAsync(() => period == "week"
            ? (Monitor.GetSucceededByDatesCount().Values.ToArray(), Monitor.GetFailedByDatesCount().Values.ToArray())
            : (Monitor.GetHourlySucceededJobs().Values.ToArray(), Monitor.GetHourlyFailedJobs().Values.ToArray()),
            _disposed.Token);

    public async ValueTask DisposeAsync()
    {
        _disposed.Cancel();
        _disposed.Dispose();
        _metricsSubscription?.Dispose();

        // Destroy Chart.js instances to stop streaming plugin from updating removed canvases
        if (_chartsInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("dashboardCharts.destroyCharts");
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
    }

    private async Task SwitchHistoryPeriod(string period)
    {
        if (_historyPeriod == period) return;
        _historyPeriod = period;

        try
        {
            var (succeededValues, failedValues) = await ReadHistoryAsync(period);
            await JS.InvokeVoidAsync("dashboardCharts.initHistoryChart", "historyChart", succeededValues, failedValues,
                period == "week" ? "week" : "day");
        }
        catch { }
    }

    private static string FormatCount(long count)
    {
        return count switch
        {
            >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
            >= 1_000 => $"{count / 1_000.0:F1}K",
            _ => count.ToString("N0")
        };
    }

    private static string FormatRelativeTime(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }
}
