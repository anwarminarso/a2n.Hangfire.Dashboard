@page "/tags"
@page "/tags/{SearchTag}"
@inject TagsDataReader TagsReader
@inject HangfireMonitorService Monitor
@inject NavigationManager Navigation

<PageTitle>Tags</PageTitle>

@if (_allTags is null)
{
    <p class="text-muted">Loading...</p>
}
else if (string.IsNullOrEmpty(SearchTag))
{
    @* Tag Cloud / Search *@
    @if (_allTags.Length == 0)
    {
        <EmptyState Icon="tags" Color="secondary"
                    Message="No tags found yet."
                    Subtitle="Tags will appear here when jobs are tagged." />
    }
    else
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var tag in _allTags)
            {
                <a class="badge text-decoration-none px-3 py-2 fs-6 rounded-pill"
                   style="@GetTagStyle(tag)" href="@GetTagUrl(tag)">@tag</a>
            }
        </div>
    }
}
else
{
    @* Jobs filtered by tag *@
    <div class="d-flex gap-2 mb-2 align-items-center">
        <a class="badge text-decoration-none px-3 py-2 fs-6 rounded-pill"
           style="@GetTagStyle(SearchTag!)" href="@GetTagUrl(SearchTag!)">@SearchTag</a>
        <a class="btn btn-sm btn-outline-secondary" href="@GetTagsBaseUrl()">← All Tags</a>
    </div>

    @if (_taggedJobs is null || _taggedJobs.Count == 0)
    {
        <EmptyState Icon="tag" Color="secondary"
                    Message="@($"No jobs found with tag \"{SearchTag}\".")" />
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Job</th>
                                <th>State</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var jobId in _taggedJobs)
                            {
                                _jobDetails.TryGetValue(jobId, out var details);
                                <tr>
                                    <td class="font-monospace">
                                        <a href="jobs/details/@jobId">@ShortenId(jobId)</a>
                                    </td>
                                    <td>@(details.jobName ?? "Unknown")</td>
                                    <td>
                                        @if (details.state is not null)
                                        {
                                            <span class="badge bg-secondary">@details.state</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager TotalCount="@_totalTaggedJobs" PageSize="@_pageSize" From="@_from"
               OnPageChanged="HandlePageChanged" />
    }
}

@code {
    [Parameter] public string SearchTag { get; set; }

    private string[] _allTags;
    private IReadOnlyList<string> _taggedJobs;
    private long _totalTaggedJobs;
    private int _from = 0;
    private int _pageSize = 20;
    private Dictionary<string, (string jobName, string state)> _jobDetails = new();

    protected override async Task OnParametersSetAsync()
    {
        _from = 0;
        await LoadData();
    }

    private async Task LoadData()
    {
        await Task.Run(() =>
        {
            _allTags = TagsReader.GetAllTags();

            if (!string.IsNullOrEmpty(SearchTag))
            {
                _totalTaggedJobs = TagsReader.GetJobCountByTag(SearchTag);
                _taggedJobs = TagsReader.GetJobsByTag(SearchTag, _from, _pageSize);
                _jobDetails.Clear();

                foreach (var jobId in _taggedJobs)
                {
                    var detail = Monitor.GetJobDetails(jobId);
                    var jobName = detail?.Job is not null
                        ? $"{detail.Job.Type.Name}.{detail.Job.Method.Name}"
                        : null;
                    var state = detail?.History.FirstOrDefault()?.StateName;
                    _jobDetails[jobId] = (jobName, state);
                }
            }
        });
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";

    private string GetTagUrl(string tag) => Navigation.ToAbsoluteUri($"tags/{tag}").PathAndQuery;
    private string GetTagsBaseUrl() => Navigation.ToAbsoluteUri("tags").PathAndQuery;

    /// <summary>
    /// Generates a unique pastel color style for each tag using HSL hashing.
    /// Same tag always gets the same hue. Colors are soft and readable in both light/dark mode.
    /// </summary>
    private static string GetTagStyle(string tag)
    {
        // Generate a stable hue (0-360) from the tag name
        var hash = (uint)tag.GetHashCode(StringComparison.OrdinalIgnoreCase);
        var hue = hash % 360;

        // Pastel palette: moderate saturation, high lightness for bg, low lightness for text
        // Light mode: bg hsl(h, 55%, 88%), text hsl(h, 60%, 30%)
        // We use CSS variables approach but since we can't detect theme in C#,
        // use a middle-ground that works well in both modes:
        // Semi-transparent background + solid text
        return $"background-color: hsl({hue}, 55%, 82%); color: hsl({hue}, 70%, 25%); border: 1px solid hsl({hue}, 45%, 72%);";
    }
}
