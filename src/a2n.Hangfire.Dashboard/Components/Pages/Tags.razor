@page "/tags"
@page "/tags/{SearchTag}"
@using a2n.Hangfire.Dashboard.Interfaces
@using a2n.Hangfire.Dashboard.Models
@inject IStorageQueryProvider QueryProvider
@inject NavigationManager Navigation

<PageTitle>Tags</PageTitle>

@if (_loading)
{
    <p class="text-muted">Loading...</p>
}
else if (string.IsNullOrEmpty(SearchTag))
{
    @* Tag Cloud *@
    @if (_tagCloud is null || _tagCloud.Count == 0)
    {
        <EmptyState Icon="tags" Color="secondary"
                    Message="No tags found yet."
                    Subtitle="Tags will appear here when jobs are tagged." />
    }
    else
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var tag in _tagCloud.Where(t => !IsNumericTag(t.Tag)))
            {
                <a class="badge text-decoration-none px-3 py-2 fs-6 rounded-pill"
                   style="@GetTagStyle(tag.Tag)" href="@GetTagUrl(tag.Tag)">
                    @tag.Tag <span class="ms-1 opacity-75">(@tag.Count)</span>
                </a>
            }
        </div>
    }
}
else
{
    @* Jobs filtered by tag *@
    <div class="d-flex gap-2 mb-2 align-items-center">
        <a class="badge text-decoration-none px-3 py-2 fs-6 rounded-pill"
           style="@GetTagStyle(SearchTag!)" href="@GetTagUrl(SearchTag!)">@SearchTag</a>
        <a class="btn btn-sm btn-outline-secondary" href="@GetTagsBaseUrl()">← All Tags</a>
    </div>

    @if (_taggedJobs is null || _taggedJobs.Items.Count == 0)
    {
        <EmptyState Icon="tag" Color="secondary"
                    Message="@($"No jobs found with tag \"{SearchTag}\".")" />
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small class="text-body-secondary">
                @_taggedJobs.TotalCount job@(_taggedJobs.TotalCount != 1 ? "s" : "") tagged
            </small>
            <PageSizeSelector PageSize="@_pageSize" OnPageSizeChanged="HandlePageSizeChanged" />
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Job</th>
                                <th>State</th>
                                <th class="text-end">Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var job in _taggedJobs.Items)
                            {
                                <tr>
                                    <td class="font-monospace">
                                        <a href="jobs/details/@job.JobId">@ShortenId(job.JobId)</a>
                                    </td>
                                    <td>@(job.JobName ?? "Unknown")</td>
                                    <td>
                                        <span class="badge @GetStateBadgeClass(job.State)">@(job.State ?? "Unknown")</span>
                                    </td>
                                    <td class="text-end">
                                        @if (job.CreatedAt.HasValue)
                                        {
                                            <RelativeTime UtcTime="@job.CreatedAt.Value" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <Pager TotalCount="@_taggedJobs.TotalCount" PageSize="@_pageSize" From="@_from"
               OnPageChanged="HandlePageChanged" />
    }
}

@code {
    [Parameter] public string SearchTag { get; set; }

    private bool _loading = true;
    private IReadOnlyList<TagCountDto> _tagCloud;
    private PagedResult<JobSummaryDto> _taggedJobs;
    private int _from = 0;
    private int _pageSize = 20;

    protected override async Task OnParametersSetAsync()
    {
        _from = 0;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;

        if (string.IsNullOrEmpty(SearchTag))
        {
            _tagCloud = await QueryProvider.GetTagCloudAsync(CancellationToken.None);
        }
        else
        {
            var page = (_from / _pageSize) + 1;
            _taggedJobs = await QueryProvider.GetJobsByTagAsync(SearchTag, page, _pageSize, CancellationToken.None);
        }

        _loading = false;
    }

    private async Task HandlePageChanged((int From, int PageSize) args)
    {
        _from = args.From;
        _pageSize = args.PageSize;
        await LoadData();
    }

    private async Task HandlePageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _from = 0;
        await LoadData();
    }

    private static string ShortenId(string id) => Guid.TryParse(id, out _) ? id[..8] + "…" : $"#{id}";

    private string GetTagUrl(string tag) => Navigation.ToAbsoluteUri($"tags/{tag}").PathAndQuery;
    private string GetTagsBaseUrl() => Navigation.ToAbsoluteUri("tags").PathAndQuery;

    private static string GetStateBadgeClass(string state)
    {
        return state?.ToLowerInvariant() switch
        {
            "succeeded" => "bg-success",
            "failed" => "bg-danger",
            "processing" => "bg-warning text-dark",
            "enqueued" => "bg-info text-dark",
            "scheduled" => "bg-info text-dark",
            "deleted" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static string GetTagStyle(string tag)
    {
        var hash = (uint)tag.GetHashCode(StringComparison.OrdinalIgnoreCase);
        var hue = hash % 360;
        return $"background-color: hsl({hue}, 55%, 82%); color: hsl({hue}, 70%, 25%); border: 1px solid hsl({hue}, 45%, 72%);";
    }

    /// <summary>
    /// Filters out numeric-only "tags" which are actually job IDs stored in the set table,
    /// not real user-defined tags.
    /// </summary>
    private static bool IsNumericTag(string tag)
    {
        if (string.IsNullOrEmpty(tag)) return true;
        foreach (var c in tag)
        {
            if (!char.IsDigit(c)) return false;
        }
        return true;
    }
}
