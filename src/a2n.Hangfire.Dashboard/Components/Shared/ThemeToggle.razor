@inject IJSRuntime JS

<div class="theme-toggle">
    <button class="theme-btn @(_theme == "auto" ? "theme-btn--active" : "")"
            @onclick="SetAuto" title="System preference">
        @IconAuto
    </button>
    <button class="theme-btn @(_theme == "light" ? "theme-btn--active" : "")"
            @onclick="SetLight" title="Light mode">
        @IconSun
    </button>
    <button class="theme-btn @(_theme == "dark" ? "theme-btn--active" : "")"
            @onclick="SetDark" title="Dark mode">
        @IconMoon
    </button>
</div>

@code {
    private string _theme = "auto";

    private static MarkupString IconSun => new("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2\"/><path d=\"M12 20v2\"/><path d=\"m4.93 4.93 1.41 1.41\"/><path d=\"m17.66 17.66 1.41 1.41\"/><path d=\"M2 12h2\"/><path d=\"M20 12h2\"/><path d=\"m6.34 17.66-1.41 1.41\"/><path d=\"m19.07 4.93-1.41 1.41\"/></svg>");
    private static MarkupString IconMoon => new("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z\"/></svg>");
    private static MarkupString IconAuto => new("<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"3\" rx=\"2\"/><line x1=\"8\" x2=\"16\" y1=\"21\" y2=\"21\"/><line x1=\"12\" x2=\"12\" y1=\"17\" y2=\"21\"/></svg>");

    private Task SetAuto() => SetTheme("auto");
    private Task SetLight() => SetTheme("light");
    private Task SetDark() => SetTheme("dark");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("themeManager.get") ?? "auto";
            StateHasChanged();
        }
    }

    private async Task SetTheme(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("themeManager.set", theme);
    }
}
