@inject IJSRuntime JS

<div class="btn-group btn-group-sm" role="group">
    <button type="button"
            class="btn @(_theme == "auto" ? "btn-primary" : "btn-outline-secondary")"
            @onclick="SetAuto" title="System preference">
        <i class="bi bi-display"></i>
    </button>
    <button type="button"
            class="btn @(_theme == "light" ? "btn-primary" : "btn-outline-secondary")"
            @onclick="SetLight" title="Light mode">
        <i class="bi bi-sun"></i>
    </button>
    <button type="button"
            class="btn @(_theme == "dark" ? "btn-primary" : "btn-outline-secondary")"
            @onclick="SetDark" title="Dark mode">
        <i class="bi bi-moon"></i>
    </button>
</div>

@code {
    private string _theme = "auto";

    private Task SetAuto() => SetTheme("auto");
    private Task SetLight() => SetTheme("light");
    private Task SetDark() => SetTheme("dark");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _theme = await JS.InvokeAsync<string>("themeManager.get") ?? "auto";
            StateHasChanged();
        }
    }

    private async Task SetTheme(string theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("themeManager.set", theme);
    }
}
