@*
    Empty state component with Bootstrap Icon watermark.
    Displays a large, low-opacity icon as visual background with a message below.
    Used across all grid/list pages when no data is available.
*@

<div class="card text-center py-4">
    <div class="card-body">
        <i class="bi bi-@Icon" style="font-size: 3rem; opacity: 0.5; color: var(--bs-@Color);"></i>
        <p class="mt-2 mb-0 text-body-secondary">@Message</p>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="small text-body-tertiary mt-1 mb-0">@Subtitle</p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// Bootstrap Icon name (without "bi-" prefix). E.g., "check-circle", "inbox".
    /// </summary>
    [Parameter] public string Icon { get; set; } = "inbox";

    /// <summary>
    /// Primary message displayed below the icon.
    /// </summary>
    [Parameter] public string Message { get; set; } = "";

    /// <summary>
    /// Optional secondary description in smaller, muted text.
    /// </summary>
    [Parameter] public string Subtitle { get; set; }

    /// <summary>
    /// Bootstrap color name for the icon (e.g., "success", "secondary", "warning").
    /// Default: "secondary".
    /// </summary>
    [Parameter] public string Color { get; set; } = "secondary";
}
