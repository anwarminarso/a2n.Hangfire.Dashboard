@using a2n.Hangfire.Dashboard.Interfaces
@using a2n.Hangfire.Dashboard.Models
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services
@implements IDisposable

<div class="card mb-3">
    <div class="card-header d-flex align-items-center justify-content-between py-2">
        <button class="btn btn-sm btn-link text-decoration-none p-0 d-flex align-items-center gap-1"
                @onclick="TogglePanel" aria-expanded="@_isExpanded" aria-controls="filter-panel-body">
            <i class="bi @(_isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
            <i class="bi bi-funnel"></i>
            <span>Advanced Filters</span>
        </button>
        @if (GetActiveFilterCount() > 0)
        {
            <span class="badge bg-primary">@GetActiveFilterCount() active</span>
        }
    </div>

    @if (_isExpanded)
    {
        <div class="card-body" id="filter-panel-body">
            <div class="row g-3">
                @* Date Range Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small">Date Range</label>
                    <div class="d-flex flex-column gap-2">
                        <div>
                            <label class="form-label small text-body-secondary mb-0">From</label>
                            <input type="datetime-local" class="form-control form-control-sm"
                                   value="@FormatDateTime(_dateFrom)"
                                   @onchange="HandleDateFromChanged" />
                        </div>
                        <div>
                            <label class="form-label small text-body-secondary mb-0">To</label>
                            <input type="datetime-local" class="form-control form-control-sm"
                                   value="@FormatDateTime(_dateTo)"
                                   @onchange="HandleDateToChanged" />
                        </div>
                        @if (_dateRangeError is not null)
                        {
                            <div class="text-danger small">
                                <i class="bi bi-exclamation-circle"></i> @_dateRangeError
                            </div>
                        }
                    </div>
                </div>

                @* State Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                        State
                        @if (_selectedStates.Count > 0)
                        {
                            <span class="badge bg-primary">@_selectedStates.Count</span>
                        }
                    </label>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var state in _allStates)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="state-@state"
                                       checked="@_selectedStates.Contains(state)"
                                       @onchange="e => HandleStateChanged(state, (bool)e.Value)" />
                                <label class="form-check-label small" for="state-@state">@state</label>
                            </div>
                        }
                    </div>
                </div>

                @* Server Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small">Server</label>
                    @if (Options?.Servers is not null && Options.Servers.Count > 0)
                    {
                        <select class="form-select form-select-sm"
                                value="@_selectedServer"
                                @onchange="HandleServerChanged">
                            <option value="">All servers</option>
                            @foreach (var server in Options.Servers)
                            {
                                <option value="@server">@server</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" disabled>
                            <option>No servers available</option>
                        </select>
                    }
                </div>

                @* Duration Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small">Duration (seconds)</label>
                    <div class="d-flex gap-2">
                        <div class="flex-fill">
                            <input type="number" class="form-control form-control-sm"
                                   placeholder="Min" min="0" max="86400"
                                   value="@_minDuration"
                                   @onchange="HandleMinDurationChanged" />
                        </div>
                        <div class="flex-fill">
                            <input type="number" class="form-control form-control-sm"
                                   placeholder="Max" min="0" max="86400"
                                   value="@_maxDuration"
                                   @onchange="HandleMaxDurationChanged" />
                        </div>
                    </div>
                    @if (_durationError is not null)
                    {
                        <div class="text-danger small mt-1">
                            <i class="bi bi-exclamation-circle"></i> @_durationError
                        </div>
                    }
                </div>

                @* Queue Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small">Queue</label>
                    @if (Options?.Queues is not null && Options.Queues.Count > 0)
                    {
                        <select class="form-select form-select-sm"
                                value="@_selectedQueue"
                                @onchange="HandleQueueChanged">
                            <option value="">All queues</option>
                            @foreach (var queue in Options.Queues.OrderBy(q => q))
                            {
                                <option value="@queue">@queue</option>
                            }
                        </select>
                    }
                    else
                    {
                        <select class="form-select form-select-sm" disabled>
                            <option>No queues available</option>
                        </select>
                    }
                </div>

                @* Tags Filter (conditional) *@
                @if (Options?.TagsFeatureAvailable == true)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <label class="form-label fw-semibold small d-flex align-items-center gap-1">
                            Tags
                            @if (_selectedTags.Count > 0)
                            {
                                <span class="badge bg-primary">@_selectedTags.Count</span>
                            }
                        </label>
                        @if (_tagsError)
                        {
                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control form-control-sm" disabled
                                       placeholder="Error loading tags" />
                                <span class="input-group-text text-danger">
                                    <i class="bi bi-exclamation-triangle"></i>
                                </span>
                            </div>
                        }
                        else if (Options?.Tags is null || Options.Tags.Count == 0)
                        {
                            <input type="text" class="form-control form-control-sm" disabled
                                   placeholder="No tags available" />
                        }
                        else
                        {
                            <div class="position-relative">
                                <input type="text" class="form-control form-control-sm"
                                       placeholder="Type to filter tags..."
                                       @bind="_tagSearchText"
                                       @bind:event="oninput"
                                       @onfocus="() => _showTagDropdown = true" />
                                @if (_showTagDropdown)
                                {
                                    <div class="dropdown-menu show w-100 overflow-auto" style="max-height: 200px; position: absolute; z-index: 1050;">
                                        @{ var filteredTags = GetFilteredTags(); }
                                        @if (filteredTags.Count == 0)
                                        {
                                            <div class="dropdown-item-text text-muted small">No matching tags</div>
                                        }
                                        else
                                        {
                                            @foreach (var tag in filteredTags)
                                            {
                                                <label class="dropdown-item d-flex align-items-center gap-2 py-1">
                                                    <input type="checkbox" class="form-check-input m-0"
                                                           checked="@_selectedTags.Contains(tag)"
                                                           @onchange="e => HandleTagChanged(tag, (bool)e.Value)" />
                                                    <span class="small">@tag</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            @if (_selectedTags.Count > 0)
                            {
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var tag in _selectedTags)
                                    {
                                        <span class="badge rounded-pill d-inline-flex align-items-center gap-1"
                                              style="@GetTagStyle(tag)">
                                            @tag
                                            <button type="button" class="btn-close ms-1" style="font-size: 0.5em;"
                                                    @onclick="() => RemoveTag(tag)" aria-label="Remove tag @tag"></button>
                                        </span>
                                    }
                                </div>
                            }
                        }
                    </div>
                }

                @* Recurring Job ID Filter *@
                <div class="col-12 col-md-6 col-lg-4">
                    <label class="form-label fw-semibold small">Recurring Job</label>
                    @if (Options?.RecurringJobIds is not null && Options.RecurringJobIds.Count > 0)
                    {
                        <div class="position-relative">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Type to search recurring jobs..."
                                   value="@_recurringJobSearchText"
                                   @oninput="HandleRecurringJobSearchInput"
                                   @onfocus="() => _showRecurringJobDropdown = true" />
                            @if (_showRecurringJobDropdown)
                            {
                                <div class="dropdown-menu show w-100 overflow-auto" style="max-height: 200px; position: absolute; z-index: 1050;">
                                    @{ var filteredJobs = GetFilteredRecurringJobs(); }
                                    @if (filteredJobs.Count == 0)
                                    {
                                        <div class="dropdown-item-text text-muted small">No matching recurring jobs</div>
                                    }
                                    else
                                    {
                                        @if (!string.IsNullOrEmpty(_selectedRecurringJobId))
                                        {
                                            <button class="dropdown-item small text-body-secondary" @onclick="ClearRecurringJob">
                                                <i class="bi bi-x-circle"></i> Clear selection
                                            </button>
                                            <div class="dropdown-divider"></div>
                                        }
                                        @foreach (var jobId in filteredJobs)
                                        {
                                            <button class="dropdown-item small @(jobId == _selectedRecurringJobId ? "active" : "")"
                                                    @onclick="() => SelectRecurringJob(jobId)">
                                                @jobId
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_selectedRecurringJobId))
                        {
                            <div class="mt-1">
                                <span class="badge bg-info d-inline-flex align-items-center gap-1">
                                    @_selectedRecurringJobId
                                    <button type="button" class="btn-close btn-close-white ms-1" style="font-size: 0.5em;"
                                            @onclick="ClearRecurringJob" aria-label="Clear recurring job selection"></button>
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <input type="text" class="form-control form-control-sm" disabled
                               placeholder="No recurring jobs available" />
                    }
                </div>

                @* Exception Filter: needs a storage provider that groups failed jobs *@
                @if (ShowExceptionFilter)
                {
                    var entries = ExceptionEntries;
                    var selectedListed = entries.Any(g => g.Fingerprint == _selectedFingerprint);
                    <div class="col-12">
                        <label class="form-label fw-semibold small" for="search-exception">
                            <i class="bi bi-bug"></i> Exception
                        </label>
                        @if (string.IsNullOrEmpty(_selectedFingerprint) && (_exceptionGroupsStatus != LoadStatus.Loaded || entries.Count == 0))
                        {
                            @* Nothing to choose from yet, or at all. *@
                            <select class="form-select form-select-sm" id="search-exception" disabled data-testid="exception-filter">
                                <option>@ExceptionPlaceholder</option>
                            </select>
                        }
                        else
                        {
                            <select class="form-select form-select-sm" id="search-exception" data-testid="exception-filter"
                                    value="@_selectedFingerprint" @onchange="HandleExceptionChanged">
                                <option value="">All exceptions</option>
                                @foreach (var group in entries)
                                {
                                    <option value="@group.Fingerprint" title="@ExceptionOptionTitle(group)">@ExceptionOptionText(group)</option>
                                }
                                @if (!string.IsNullOrEmpty(_selectedFingerprint) && !selectedListed)
                                {
                                    @* From the URL, but not listed: every failed job of that group may have been
                                       requeued since, and Search still finds those jobs. *@
                                    <option value="@_selectedFingerprint">Exception @_selectedFingerprint</option>
                                }
                            </select>
                        }
                        <div class="form-text small" data-testid="exception-filter-hint">@ExceptionHint</div>
                    </div>
                }

                @* Arguments Search *@
                <div class="col-12">
                    <label class="form-label fw-semibold small" for="search-arguments">
                        <i class="bi bi-braces"></i> Arguments
                    </label>
                    <input type="text" class="form-control form-control-sm" id="search-arguments"
                           placeholder="Search in job arguments (e.g. an order id or e-mail address)..."
                           value="@_argumentsQuery"
                           @oninput="HandleArgumentsQueryInput" />
                    <div class="form-text small">
                        Matches the serialized arguments only — not the job type or method name.
                    </div>
                </div>

                @* Content Search *@
                <div class="col-12">
                    <label class="form-label fw-semibold small">
                        <i class="bi bi-file-text"></i> Content Search
                    </label>
                    <div class="row g-2">
                        <div class="col-12 col-md-8">
                            <input type="text" class="form-control form-control-sm"
                                   placeholder="Search in stack trace / console output (min 3 chars)..."
                                   value="@_contentQuery"
                                   @oninput="HandleContentQueryInput" />
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-center gap-3">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="search-stacktrace"
                                       checked="@_searchStackTrace"
                                       @onchange="e => HandleSearchScopeChanged(true, (bool)e.Value)" />
                                <label class="form-check-label small" for="search-stacktrace">Stack Trace</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="search-console"
                                       checked="@_searchConsoleOutput"
                                       @onchange="e => HandleSearchScopeChanged(false, (bool)e.Value)" />
                                <label class="form-check-label small" for="search-console">Console Output</label>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_contentQuery) && _contentQuery.Trim().Length < 3 && (_searchStackTrace || _searchConsoleOutput))
                    {
                        <div class="text-warning small mt-1">
                            <i class="bi bi-info-circle"></i> Minimum 3 characters required for content search
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_contentQuery) && _contentQuery.Trim().Length >= 3 && !_searchStackTrace && !_searchConsoleOutput)
                    {
                        <div class="text-body-secondary small mt-1">
                            <i class="bi bi-info-circle"></i> Content search inactive — tick at least one scope checkbox
                        </div>
                    }
                </div>
            </div>

            @* Clear All Filters button *@
            @if (GetActiveFilterCount() > 0)
            {
                <div class="mt-3 pt-2 border-top">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllFilters">
                        <i class="bi bi-x-lg"></i> Clear All Filters
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public FilterOptions Options { get; set; }
    [Parameter] public SearchRequest CurrentRequest { get; set; }
    [Parameter] public EventCallback<SearchRequest> OnFilterChanged { get; set; }
    [Parameter] public bool TagsError { get; set; }

    private bool _isExpanded = false;
    private bool _tagsError;

    // Date range
    private DateTime? _dateFrom;
    private DateTime? _dateTo;
    private string _dateRangeError;

    // State
    private static readonly string[] _allStates = { "Enqueued", "Processing", "Scheduled", "Succeeded", "Failed", "Deleted", "Awaiting" };
    private HashSet<string> _selectedStates = new();

    // Server
    private string _selectedServer = "";

    // Duration
    private int? _minDuration;
    private int? _maxDuration;
    private string _durationError;

    // Queue
    private string _selectedQueue = "";

    // Tags
    private string _tagSearchText = "";
    private bool _showTagDropdown = false;
    private HashSet<string> _selectedTags = new();

    // Recurring Job ID
    private string _recurringJobSearchText = "";
    private bool _showRecurringJobDropdown = false;
    private string _selectedRecurringJobId = "";

    // Arguments Search
    private string _argumentsQuery = "";
    private bool _argumentsQueryInitialized = false;

    // Exception: groups from the provider's grouping, loaded the first time the panel opens so that
    // GetFilterOptions() doesn't wait for them.
    private enum LoadStatus { NotLoaded, Loading, Loaded, TimedOut, Failed }

    private string _selectedFingerprint = "";
    private IStorageQueryProvider _queryProvider;
    private DashboardUIOptions _uiOptions;
    private FailureGroupsResult _exceptionGroups = new();
    private LoadStatus _exceptionGroupsStatus = LoadStatus.NotLoaded;
    private CancellationTokenSource _exceptionGroupsCts;

    // Content Search
    private string _contentQuery = "";
    private bool _searchStackTrace = false;
    private bool _searchConsoleOutput = false;
    private bool _contentQueryInitialized = false;

    // The text-search values this panel last sent to the parent. The request sent up is not the
    // raw input (arguments text is trimmed; content text under 3 characters is sent as null), so
    // copying it back on every render would rewrite text still being typed. A parent value that
    // differs from what was sent is an outside change, such as a cleared badge (Issue #44).
    private string _sentArgumentsQuery;
    private string _sentContentQuery;

    protected override void OnInitialized()
    {
        _queryProvider = Services.GetService<IStorageQueryProvider>();
        _uiOptions = Services.GetService<DashboardUIOptions>() ?? new DashboardUIOptions();
    }

    protected override void OnParametersSet()
    {
        _tagsError = TagsError;

        if (CurrentRequest is not null)
        {
            _dateFrom = CurrentRequest.DateFrom;
            _dateTo = CurrentRequest.DateTo;
            _selectedStates = new HashSet<string>(CurrentRequest.States ?? new List<string>());
            _selectedServer = CurrentRequest.Server ?? "";
            _minDuration = CurrentRequest.MinDurationSeconds;
            _maxDuration = CurrentRequest.MaxDurationSeconds;
            _selectedQueue = CurrentRequest.Queue ?? "";
            _selectedTags = new HashSet<string>(CurrentRequest.Tags ?? new List<string>());
            _selectedRecurringJobId = CurrentRequest.RecurringJobId ?? "";
            _recurringJobSearchText = _selectedRecurringJobId;
            _selectedFingerprint = FailureFingerprint.IsCurrentVersion(CurrentRequest.ExceptionFingerprint)
                ? CurrentRequest.ExceptionFingerprint : "";
            if (!_argumentsQueryInitialized || CurrentRequest.ArgumentsQuery != _sentArgumentsQuery)
            {
                _argumentsQuery = CurrentRequest.ArgumentsQuery ?? "";
                _sentArgumentsQuery = CurrentRequest.ArgumentsQuery;
                _argumentsQueryInitialized = true;
            }
            if (!_contentQueryInitialized)
            {
                _contentQuery = CurrentRequest.ContentQuery ?? "";
                _sentContentQuery = CurrentRequest.ContentQuery;
                _searchStackTrace = CurrentRequest.SearchStackTrace;
                _searchConsoleOutput = CurrentRequest.SearchConsoleOutput;
                _contentQueryInitialized = true;
            }
            else if (CurrentRequest.ContentQuery != _sentContentQuery)
            {
                // Clearing the content badge clears the text; the scope checkboxes stay as chosen.
                _contentQuery = CurrentRequest.ContentQuery ?? "";
                _sentContentQuery = CurrentRequest.ContentQuery;
            }
        }
    }

    private async Task TogglePanel()
    {
        _isExpanded = !_isExpanded;
        if (_isExpanded && _exceptionGroupsStatus is not (LoadStatus.Loading or LoadStatus.Loaded))
            await LoadExceptionGroups();
    }

    private int GetActiveFilterCount()
    {
        int count = 0;
        if (_dateFrom.HasValue || _dateTo.HasValue) count++;
        if (_selectedStates.Count > 0) count++;
        if (!string.IsNullOrEmpty(_selectedServer)) count++;
        if (_minDuration.HasValue || _maxDuration.HasValue) count++;
        if (!string.IsNullOrEmpty(_selectedQueue)) count++;
        if (_selectedTags.Count > 0) count++;
        if (!string.IsNullOrEmpty(_selectedRecurringJobId)) count++;
        if (!string.IsNullOrEmpty(_selectedFingerprint)) count++;
        if (!string.IsNullOrWhiteSpace(_argumentsQuery)) count++;
        if (IsContentSearchActive()) count++;
        return count;
    }

    // --- Date Range ---

    private string FormatDateTime(DateTime? dt)
    {
        return dt?.ToString("yyyy-MM-ddTHH:mm:ss") ?? "";
    }

    private void HandleDateFromChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _dateFrom = string.IsNullOrWhiteSpace(value) ? null : DateTime.Parse(value);
        ValidateDateRange();
        if (_dateRangeError is null) NotifyFilterChanged();
    }

    private void HandleDateToChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _dateTo = string.IsNullOrWhiteSpace(value) ? null : DateTime.Parse(value);
        ValidateDateRange();
        if (_dateRangeError is null) NotifyFilterChanged();
    }

    private void ValidateDateRange()
    {
        if (_dateFrom.HasValue && _dateTo.HasValue && _dateFrom.Value > _dateTo.Value)
        {
            _dateRangeError = "From must be before To";
        }
        else
        {
            _dateRangeError = null;
        }
    }

    // --- State ---

    private void HandleStateChanged(string state, bool isChecked)
    {
        if (isChecked)
            _selectedStates.Add(state);
        else
            _selectedStates.Remove(state);

        NotifyFilterChanged();
    }

    // --- Server ---

    private void HandleServerChanged(ChangeEventArgs e)
    {
        _selectedServer = e.Value?.ToString() ?? "";
        NotifyFilterChanged();
    }

    // --- Duration ---

    private void HandleMinDurationChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _minDuration = string.IsNullOrWhiteSpace(value) ? null : int.TryParse(value, out var v) ? v : null;
        ValidateDuration();
        if (_durationError is null) NotifyFilterChanged();
    }

    private void HandleMaxDurationChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _maxDuration = string.IsNullOrWhiteSpace(value) ? null : int.TryParse(value, out var v) ? v : null;
        ValidateDuration();
        if (_durationError is null) NotifyFilterChanged();
    }

    private void ValidateDuration()
    {
        if (_minDuration.HasValue && (_minDuration.Value < 0 || _minDuration.Value > 86400))
        {
            _durationError = "Value must be 0-86400";
            return;
        }
        if (_maxDuration.HasValue && (_maxDuration.Value < 0 || _maxDuration.Value > 86400))
        {
            _durationError = "Value must be 0-86400";
            return;
        }
        if (_minDuration.HasValue && _maxDuration.HasValue && _minDuration.Value > _maxDuration.Value)
        {
            _durationError = "Min must be ≤ Max";
            return;
        }
        _durationError = null;
    }

    // --- Queue ---

    private void HandleQueueChanged(ChangeEventArgs e)
    {
        _selectedQueue = e.Value?.ToString() ?? "";
        NotifyFilterChanged();
    }

    // --- Tags ---

    private List<string> GetFilteredTags()
    {
        if (Options?.Tags is null) return new List<string>();

        var tags = Options.Tags.OrderBy(t => t).ToList();
        if (!string.IsNullOrWhiteSpace(_tagSearchText))
        {
            tags = tags.Where(t => t.Contains(_tagSearchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        return tags;
    }

    private void HandleTagChanged(string tag, bool isChecked)
    {
        if (isChecked)
            _selectedTags.Add(tag);
        else
            _selectedTags.Remove(tag);

        NotifyFilterChanged();
    }

    private void RemoveTag(string tag)
    {
        _selectedTags.Remove(tag);
        NotifyFilterChanged();
    }

    // --- Recurring Job ID ---

    private void HandleRecurringJobSearchInput(ChangeEventArgs e)
    {
        _recurringJobSearchText = e.Value?.ToString() ?? "";
        _showRecurringJobDropdown = true;
    }

    private List<string> GetFilteredRecurringJobs()
    {
        if (Options?.RecurringJobIds is null) return new List<string>();

        var jobs = Options.RecurringJobIds.OrderBy(j => j).ToList();
        if (!string.IsNullOrWhiteSpace(_recurringJobSearchText))
        {
            jobs = jobs.Where(j => j.Contains(_recurringJobSearchText, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        return jobs;
    }

    private void SelectRecurringJob(string jobId)
    {
        _selectedRecurringJobId = jobId;
        _recurringJobSearchText = jobId;
        _showRecurringJobDropdown = false;
        NotifyFilterChanged();
    }

    private void ClearRecurringJob()
    {
        _selectedRecurringJobId = "";
        _recurringJobSearchText = "";
        _showRecurringJobDropdown = false;
        NotifyFilterChanged();
    }

    // --- Exception ---

    private bool ShowExceptionFilter => _queryProvider is { SupportsFailureGrouping: true } && _exceptionGroups.IsSupported;

    // Only a stored fingerprint can match, so groups without one aren't offered. The generic provider
    // (Redis and others) can't tell stored from computed fingerprints; there every labeled group is
    // offered, and it matches the jobs whose failure the filter recorded.
    private List<FailureGroupDto> ExceptionEntries => _exceptionGroupsStatus != LoadStatus.Loaded
        ? new List<FailureGroupDto>()
        : _exceptionGroups.Groups
            .Where(g => g.IsLabeled && (!_exceptionGroups.UsesStoredFingerprints || g.StoredCount > 0))
            .ToList();

    private string ExceptionPlaceholder => _exceptionGroupsStatus switch
    {
        LoadStatus.Loading or LoadStatus.NotLoaded => "Loading exceptions…",
        LoadStatus.TimedOut or LoadStatus.Failed => "Exceptions could not be loaded",
        _ => "No exceptions to filter by",
    };

    private string ExceptionHint => _exceptionGroupsStatus switch
    {
        LoadStatus.TimedOut => _uiOptions.SearchTimeoutSeconds > 0
            ? $"Loading the exceptions took longer than {_uiOptions.SearchTimeoutSeconds} {(_uiOptions.SearchTimeoutSeconds == 1 ? "second" : "seconds")} and was stopped."
            : "Loading the exceptions was stopped.",
        LoadStatus.Failed => "The exceptions could not be loaded.",
        LoadStatus.Loaded when ExceptionEntries.Count == 0 && _exceptionGroups.UsesStoredFingerprints
            => "No failed job has a stored exception fingerprint. Register UseDashboardFailureFingerprintFilter() on the Hangfire servers to filter by exception.",
        _ => "Finds jobs in any state whose failure was recorded by UseDashboardFailureFingerprintFilter(), including ones requeued or deleted since.",
    };

    // The parts the Failed page's Exception filter shows, on one line: a native option has no layout.
    private string ExceptionOptionText(FailureGroupDto group)
    {
        var parts = new List<string> { FailureGroupLabels.ShortTypeName(group) };
        if (!string.IsNullOrEmpty(group.NormalizedMessage))
            parts.Add(FailureGroupLabels.Truncate(group.NormalizedMessage, 80));
        if (!string.IsNullOrEmpty(group.TopFrame))
            parts.Add(group.TopFrame);
        return $"{string.Join(" · ", parts)} ({FailureGroupLabels.CountText(group, _exceptionGroups.IsPartial)} failed)";
    }

    private static string ExceptionOptionTitle(FailureGroupDto group)
        => string.Join("\n", new[] { FailureGroupLabels.FullTypeName(group), group.NormalizedMessage, group.TopFrame }
            .Where(p => !string.IsNullOrEmpty(p)));

    private async Task LoadExceptionGroups()
    {
        if (_queryProvider is not { SupportsFailureGrouping: true })
            return;

        _exceptionGroupsCts?.Cancel();
        using var cts = new CancellationTokenSource();
        if (_uiOptions.SearchTimeoutSeconds > 0)
            cts.CancelAfter(TimeSpan.FromSeconds(_uiOptions.SearchTimeoutSeconds));
        _exceptionGroupsCts = cts;
        _exceptionGroupsStatus = LoadStatus.Loading;
        StateHasChanged();

        FailureGroupsResult result = null;
        var status = LoadStatus.Loaded;
        try
        {
            // Off the render thread: a provider may do its work before its first await.
            result = await Task.Run(() => _queryProvider.GetFailureGroupsAsync(FailureGroupsResult.DefaultLabelCount, cts.Token));
        }
        catch (Exception)
        {
            // SqlClient reports a cancelled command as a SqlException, so the token tells a timeout
            // apart from a real error.
            status = cts.IsCancellationRequested ? LoadStatus.TimedOut : LoadStatus.Failed;
        }

        // A newer load, or disposal, has taken over.
        if (!ReferenceEquals(_exceptionGroupsCts, cts))
            return;
        _exceptionGroupsCts = null;

        if (status == LoadStatus.Loaded)
            _exceptionGroups = result ?? FailureGroupsResult.Unsupported();
        _exceptionGroupsStatus = status;
        StateHasChanged();
    }

    private void HandleExceptionChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _selectedFingerprint = FailureFingerprint.IsCurrentVersion(value) ? value : "";
        NotifyFilterChanged();
    }

    public void Dispose()
    {
        _exceptionGroupsCts?.Cancel();
        _exceptionGroupsCts = null;
    }

    // --- Arguments Search ---

    private void HandleArgumentsQueryInput(ChangeEventArgs e)
    {
        _argumentsQuery = e.Value?.ToString() ?? "";
        NotifyFilterChanged();
    }

    // --- Content Search ---

    private void HandleContentQueryInput(ChangeEventArgs e)
    {
        _contentQuery = e.Value?.ToString() ?? "";
        NotifyFilterChanged();
    }

    private void HandleSearchScopeChanged(bool isStackTrace, bool isChecked)
    {
        if (isStackTrace)
            _searchStackTrace = isChecked;
        else
            _searchConsoleOutput = isChecked;

        // User can untick both — content search will be ignored in that case
        NotifyFilterChanged();
    }

    // --- Clear All ---

    private void ClearAllFilters()
    {
        _dateFrom = null;
        _dateTo = null;
        _dateRangeError = null;
        _selectedStates.Clear();
        _selectedServer = "";
        _minDuration = null;
        _maxDuration = null;
        _durationError = null;
        _selectedQueue = "";
        _selectedTags.Clear();
        _tagSearchText = "";
        _selectedRecurringJobId = "";
        _recurringJobSearchText = "";
        _selectedFingerprint = "";
        _argumentsQuery = "";
        _argumentsQueryInitialized = false;
        _contentQuery = "";
        _searchStackTrace = false;
        _searchConsoleOutput = false;
        _contentQueryInitialized = false;
        NotifyFilterChanged();
    }

    // --- Notify Parent ---

    private void NotifyFilterChanged()
    {
        if (HasValidationErrors()) return;

        var request = new SearchRequest
        {
            Query = CurrentRequest?.Query ?? "",
            From = 0, // Reset to first page on filter change
            PageSize = CurrentRequest?.PageSize ?? 20,
            DateFrom = _dateFrom,
            DateTo = _dateTo,
            States = _selectedStates.ToList(),
            Server = string.IsNullOrEmpty(_selectedServer) ? null : _selectedServer,
            MinDurationSeconds = _minDuration,
            MaxDurationSeconds = _maxDuration,
            Queue = string.IsNullOrEmpty(_selectedQueue) ? null : _selectedQueue,
            Tags = _selectedTags.ToList(),
            RecurringJobId = string.IsNullOrEmpty(_selectedRecurringJobId) ? null : _selectedRecurringJobId,
            ExceptionFingerprint = string.IsNullOrEmpty(_selectedFingerprint) ? null : _selectedFingerprint,
            ArgumentsQuery = string.IsNullOrWhiteSpace(_argumentsQuery) ? null : _argumentsQuery.Trim(),
            // Content search: only active when text >= 3 chars AND at least one scope checkbox is ticked
            ContentQuery = IsContentSearchActive() ? _contentQuery.Trim() : null,
            SearchStackTrace = _searchStackTrace,
            SearchConsoleOutput = _searchConsoleOutput
        };

        _sentArgumentsQuery = request.ArgumentsQuery;
        _sentContentQuery = request.ContentQuery;
        OnFilterChanged.InvokeAsync(request);
    }

    private bool HasValidationErrors()
    {
        return _dateRangeError is not null || _durationError is not null;
    }

    /// <summary>
    /// Content search is active when: textbox has >= 3 chars AND at least one scope checkbox is ticked.
    /// </summary>
    private bool IsContentSearchActive()
    {
        return !string.IsNullOrWhiteSpace(_contentQuery)
            && _contentQuery.Trim().Length >= 3
            && (_searchStackTrace || _searchConsoleOutput);
    }

    private static string GetTagStyle(string tag)
    {
        var hash = (uint)tag.GetHashCode(StringComparison.OrdinalIgnoreCase);
        var hue = hash % 360;
        return $"background-color: hsl({hue}, 55%, 82%); color: hsl({hue}, 70%, 25%); border: 1px solid hsl({hue}, 45%, 72%);";
    }
}
