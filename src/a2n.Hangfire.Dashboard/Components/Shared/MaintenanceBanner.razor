@inject QueueOperationsStateCache StateCache
@inject DashboardUIOptions Options
@inject DashboardPolling Polling
@inject NavigationManager Navigation
@using a2n.Hangfire.Dashboard.Services
@implements IDisposable

@if (_state is not null && _state.MaintenanceMode)
{
    <div class="hf-maintenance-banner" role="alert" aria-live="polite">
        <div class="hf-maintenance-banner-icon" aria-hidden="true">
            <i class="bi bi-cone-striped"></i>
        </div>
        <div class="hf-maintenance-banner-body">
            <strong>Maintenance mode active</strong>
            @if (_state.MaintenanceEnabledAtUtc.HasValue)
            {
                <span class="hf-maintenance-banner-meta">
                    — enabled @FormatRelative(_state.MaintenanceEnabledAtUtc.Value)
                    @if (!string.IsNullOrEmpty(_state.MaintenanceEnabledBy))
                    {
                        <text> by @_state.MaintenanceEnabledBy</text>
                    }
                </span>
            }
            @if (!string.IsNullOrEmpty(_state.MaintenanceReason))
            {
                <div class="hf-maintenance-banner-reason">@_state.MaintenanceReason</div>
            }
            <div class="hf-maintenance-banner-help">
                All workers are skipping job execution and rescheduling jobs back into the queue.
            </div>
        </div>
        @if (!Options.IsReadOnly && Options.QueueOperations.Enabled)
        {
            <a href="queues" class="btn btn-sm btn-warning hf-maintenance-banner-action">
                Manage →
            </a>
        }
    </div>
}

@code {
    private QueueOperationsState _state;
    private DashboardPoller _poller;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();

        // On failure the banner keeps its last known state while the loop backs off.
        _poller = Polling.Start(nameof(MaintenanceBanner), Polling.Options.PageRefreshInterval, _ => InvokeAsync(async () =>
        {
            await Refresh();
            StateHasChanged();
        }));
    }

    private async Task Refresh()
    {
        _state = await StateCache.GetAsync();
    }

    private static string FormatRelative(DateTime utcTime)
    {
        var diff = DateTime.UtcNow - utcTime;
        return diff.TotalSeconds switch
        {
            < 60 => $"{(int)diff.TotalSeconds}s ago",
            < 3600 => $"{(int)diff.TotalMinutes}m ago",
            < 86400 => $"{(int)diff.TotalHours}h ago",
            _ => $"{(int)diff.TotalDays}d ago"
        };
    }

    public void Dispose()
    {
        _poller?.Dispose();
    }
}
