@using a2n.Hangfire.Dashboard.Services
@inject ConsoleDataReader ConsoleReader
@implements IDisposable

@if (_displayLines is not null && _displayLines.Count > 0)
{
    <div class="console-viewer">
        <div class="console-header">
            <span class="console-title">Console Output</span>
            <span class="console-count">@_displayLines.Count lines</span>
            @if (IsLive)
            {
                <span class="console-live-indicator">
                    <span class="console-live-dot"></span> Live
                </span>
            }
        </div>
        <div class="console-body">
            @foreach (var line in _displayLines)
            {
                @if (line.IsProgressBar)
                {
                    <div class="console-line console-line--progress">
                        <span class="console-time">@FormatTimeOffset(line.TimeOffset)</span>
                        <div class="console-progress">
                            <div class="console-progress-bar" style="width: @(line.ProgressValue ?? 0)%"></div>
                            <span class="console-progress-text">
                                @if (!string.IsNullOrEmpty(line.ProgressName))
                                {
                                    @line.ProgressName @(": ")
                                }
                                @($"{line.ProgressValue:F0}%")
                            </span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="console-line" style="@GetLineStyle(line)">
                        <span class="console-time">@FormatTimeOffset(line.TimeOffset)</span>
                        <span class="console-text">@((MarkupString)LinkifyText(line.Message))</span>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public string JobId { get; set; }
    [Parameter] public DateTime? StartedAt { get; set; }

    /// <summary>
    /// When true, polls for new console lines every 2 seconds (for Processing jobs).
    /// </summary>
    [Parameter] public bool IsLive { get; set; }

    private IReadOnlyList<ConsoleLineDto> _lines;
    private List<ConsoleLineDto> _displayLines;
    private Timer _liveTimer;

    protected override async Task OnParametersSetAsync()
    {
        if (JobId is not null && StartedAt.HasValue)
        {
            await Task.Run(() =>
            {
                _lines = ConsoleReader.GetLines(JobId, StartedAt.Value);
                _displayLines = BuildDisplayLines(_lines);
            });
        }

        // Start or stop live polling based on IsLive parameter
        if (IsLive && _liveTimer is null)
        {
            _liveTimer = new Timer(OnLiveTick, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        }
        else if (!IsLive && _liveTimer is not null)
        {
            _liveTimer.Dispose();
            _liveTimer = null;
        }
    }

    private async void OnLiveTick(object state)
    {
        if (JobId is null || !StartedAt.HasValue) return;

        try
        {
            var newLines = ConsoleReader.GetLines(JobId, StartedAt.Value);
            if (newLines is not null && (_lines is null || newLines.Count != _lines.Count))
            {
                _lines = newLines;
                _displayLines = BuildDisplayLines(_lines);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { /* ignore errors during polling */ }
    }

    /// <summary>
    /// Collapses progress bar updates: for each unique ProgressId, only the latest value is kept.
    /// The progress bar is rendered at the position of its first occurrence.
    /// </summary>
    private static List<ConsoleLineDto> BuildDisplayLines(IReadOnlyList<ConsoleLineDto> lines)
    {
        if (lines is null || lines.Count == 0)
            return [];

        var result = new List<ConsoleLineDto>();
        // Track latest progress value per ProgressId
        var progressLatest = new Dictionary<string, ConsoleLineDto>();
        // Track which progress IDs we've already placed in result
        var progressPlaced = new HashSet<string>();

        // First pass: find the latest value for each progress bar
        foreach (var line in lines)
        {
            if (line.IsProgressBar && line.ProgressId is not null)
            {
                progressLatest[line.ProgressId] = line;
            }
        }

        // Second pass: build display list, placing progress bar at first occurrence
        foreach (var line in lines)
        {
            if (line.IsProgressBar && line.ProgressId is not null)
            {
                if (!progressPlaced.Contains(line.ProgressId))
                {
                    // Place the latest value at the first occurrence position
                    result.Add(progressLatest[line.ProgressId]);
                    progressPlaced.Add(line.ProgressId);
                }
                // Skip subsequent updates for the same progress bar
            }
            else
            {
                result.Add(line);
            }
        }

        return result;
    }

    private static string FormatTimeOffset(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalMinutes >= 1
            ? $"+{(int)ts.TotalMinutes}m{ts.Seconds:D2}s"
            : $"+{ts.TotalSeconds:F1}s";
    }

    private static string GetLineStyle(ConsoleLineDto line)
    {
        return line.TextColor is not null ? $"color: {line.TextColor}" : null;
    }

    private static readonly System.Text.RegularExpressions.Regex UrlRegex = new(
        @"(https?://[^\s<>""']+)",
        System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string LinkifyText(string text)
    {
        // Match URLs in raw text first, then encode non-URL parts
        var matches = UrlRegex.Matches(text);
        if (matches.Count == 0)
            return System.Net.WebUtility.HtmlEncode(text);

        var sb = new System.Text.StringBuilder();
        var lastIndex = 0;

        foreach (System.Text.RegularExpressions.Match match in matches)
        {
            // Encode text before the URL
            if (match.Index > lastIndex)
                sb.Append(System.Net.WebUtility.HtmlEncode(text[lastIndex..match.Index]));

            // Render the URL as a link (encode the display text, use raw URL for href)
            var url = match.Value;
            sb.Append($"<a href=\"{System.Net.WebUtility.HtmlEncode(url)}\" target=\"_blank\" rel=\"nofollow\" class=\"console-link\">{System.Net.WebUtility.HtmlEncode(url)}</a>");
            lastIndex = match.Index + match.Length;
        }

        // Encode remaining text after last URL
        if (lastIndex < text.Length)
            sb.Append(System.Net.WebUtility.HtmlEncode(text[lastIndex..]));

        return sb.ToString();
    }

    public void Dispose()
    {
        _liveTimer?.Dispose();
    }
}
