@if (TotalCount > PageSize)
{
    <nav class="d-flex align-items-center justify-content-between flex-wrap gap-2 py-2">
        <small class="text-body-secondary">
            Showing @(From + 1)–@Math.Min(From + PageSize, TotalCount) of @TotalCount
        </small>
        <ul class="pagination pagination-sm mb-0">
            <li class="@GetPageItemClass(CurrentPage <= 1)">
                <button class="page-link" @onclick="GoFirst">&laquo;</button>
            </li>
            <li class="@GetPageItemClass(CurrentPage <= 1)">
                <button class="page-link" @onclick="GoPrev">&lsaquo;</button>
            </li>
            @foreach (var page in GetVisiblePages())
            {
                @if (page == -1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                else
                {
                    <li class="@GetPageItemActiveClass(page)">
                        <button class="page-link" @onclick="() => GoToPage(page)">@(page)</button>
                    </li>
                }
            }
            <li class="@GetPageItemClass(CurrentPage >= TotalPages)">
                <button class="page-link" @onclick="GoNext">&rsaquo;</button>
            </li>
            <li class="@GetPageItemClass(CurrentPage >= TotalPages)">
                <button class="page-link" @onclick="GoLast">&raquo;</button>
            </li>
        </ul>
        <div class="d-flex align-items-center gap-1">
            <select class="form-select form-select-sm" style="width: auto;"
                    value="@PageSize" @onchange="OnPageSizeChanged">
                <option value="10">10</option>
                <option value="20">20</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <small class="text-body-secondary">per page</small>
        </div>
    </nav>
}
else if (TotalCount > 0)
{
    <div class="py-2">
        <small class="text-body-secondary">Showing all @TotalCount items</small>
    </div>
}

@code {
    [Parameter] public long TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; } = 20;
    [Parameter] public int From { get; set; }
    [Parameter] public EventCallback<(int From, int PageSize)> OnPageChanged { get; set; }

    private int CurrentPage => (From / PageSize) + 1;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);

    private string GetPageItemClass(bool isDisabled) =>
        isDisabled ? "page-item disabled" : "page-item";

    private string GetPageItemActiveClass(int page) =>
        page == CurrentPage ? "page-item active" : "page-item";

    private async Task GoToPage(int page)
    {
        var newFrom = (page - 1) * PageSize;
        await OnPageChanged.InvokeAsync((newFrom, PageSize));
    }

    private Task GoFirst() => GoToPage(1);
    private Task GoPrev() => GoToPage(Math.Max(1, CurrentPage - 1));
    private Task GoNext() => GoToPage(Math.Min(TotalPages, CurrentPage + 1));
    private Task GoLast() => GoToPage(TotalPages);

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        var newSize = int.Parse(e.Value?.ToString() ?? "20");
        await OnPageChanged.InvokeAsync((0, newSize));
    }

    private IEnumerable<int> GetVisiblePages()
    {
        const int maxVisible = 7;
        var pages = new List<int>();

        if (TotalPages <= maxVisible)
        {
            for (var i = 1; i <= TotalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            var start = Math.Max(2, CurrentPage - 2);
            var end = Math.Min(TotalPages - 1, CurrentPage + 2);

            if (start > 2) pages.Add(-1); // ellipsis
            for (var i = start; i <= end; i++) pages.Add(i);
            if (end < TotalPages - 1) pages.Add(-1); // ellipsis
            pages.Add(TotalPages);
        }

        return pages;
    }
}
