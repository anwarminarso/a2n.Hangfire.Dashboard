@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject DashboardUIOptions Options
@implements IDisposable

<div class="d-flex vh-100 overflow-hidden">
    <!-- Sidebar: fixed di desktop, hidden di mobile -->
    <aside class="d-none d-lg-flex flex-column flex-shrink-0 hf-sidebar"
           style="width: 240px; overflow-y: auto;" id="sidebar">
        <NavMenu />
    </aside>

    <!-- Offcanvas sidebar untuk mobile -->
    <div class="offcanvas offcanvas-start hf-sidebar" tabindex="-1" id="mobileSidebar">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" style="color: var(--hf-nav-brand-color);">@Options.DashboardTitle</h5>
            <button type="button" class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <NavMenu />
        </div>
    </div>

    <!-- Main content area -->
    <div class="flex-grow-1 d-flex flex-column overflow-hidden">
        <header class="navbar bg-body border-bottom px-3 flex-shrink-0">
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-link d-lg-none p-1"
                        data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <h1 class="navbar-text fw-semibold fs-6 mb-0">@_pageTitle</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (!_isSearchPage)
                {
                    <div class="d-none d-md-block">
                        <SearchBar />
                    </div>
                }
                @if (Options.AppPath is not null)
                {
                    <a href="@Options.AppPath" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-left"></i>
                        <span class="d-none d-md-inline ms-1">Back to Site</span>
                    </a>
                }
                <ThemeToggle />
            </div>
        </header>

        <main class="flex-grow-1 overflow-auto p-3 p-lg-4">
            @Body
        </main>

        <FooterInfo />
    </div>
</div>

@code {
    private string _pageTitle = "Dashboard";
    private bool _isSearchPage;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        UpdatePageTitle(Navigation.Uri);
    }

    private void OnLocationChanged(object sender, LocationChangedEventArgs e)
    {
        UpdatePageTitle(e.Location);
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageTitle(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();

        // Remove path base if present
        var basePath = Navigation.BaseUri.TrimEnd('/');
        if (!string.IsNullOrEmpty(basePath))
        {
            var baseUri = new Uri(basePath);
            var baseAbsPath = baseUri.AbsolutePath.TrimEnd('/');
            if (path.StartsWith(baseAbsPath))
                path = path[baseAbsPath.Length..];
        }

        _isSearchPage = path == "/search";

        _pageTitle = path switch
        {
            "" or "/" => "Dashboard",
            "/jobs/enqueued" => "Enqueued Jobs",
            "/jobs/processing" => "Processing Jobs",
            "/jobs/scheduled" => "Scheduled Jobs",
            "/jobs/succeeded" => "Succeeded Jobs",
            "/jobs/failed" => "Failed Jobs",
            "/jobs/deleted" => "Deleted Jobs",
            "/jobs/awaiting" => "Awaiting Jobs",
            "/recurring" => "Recurring Jobs",
            "/servers" => "Servers",
            "/retries" => "Retries",
            "/tags" => "Tags",
            "/search" => "Search",
            _ when path.StartsWith("/jobs/details/") => $"Job #{path.Split('/').Last()}",
            _ when path.StartsWith("/recurring/") => "Recurring Job Editor",
            _ => "Hangfire Dashboard"
        };
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
