@using a2n.Hangfire.Dashboard.Interfaces
@using Microsoft.Extensions.DependencyInjection
@inject HangfireMonitorService Monitor
@inject TagsDataReader TagsReader
@inject IServiceProvider ServiceProvider
@implements IDisposable

<nav class="hf-nav">
    <!-- Brand -->
    <div class="hf-nav-brand">
        <div class="hf-nav-brand-icon">
            <i class="bi bi-fire"></i>
        </div>
        <span class="hf-nav-brand-text">Hangfire</span>
    </div>

    <!-- Dashboard (standalone, no group label) -->
    <div class="hf-nav-section">
        <NavLink class="hf-nav-item" href="" Match="NavLinkMatch.All">
            <i class="bi bi-grid hf-nav-icon"></i>
            <span>Dashboard</span>
        </NavLink>
    </div>

    <!-- Jobs group (spacing-only separation) -->
    <div class="hf-nav-section">
        <NavLink class="hf-nav-item" href="jobs/enqueued">
            <i class="bi bi-inbox hf-nav-icon"></i>
            <span>Enqueued</span>
            @if (_stats?.Enqueued > 0)
            {
                <span class="hf-nav-counter">@_stats.Enqueued</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/processing">
            <i class="bi bi-gear hf-nav-icon"></i>
            <span>Processing</span>
            @if (_stats?.Processing > 0)
            {
                <span class="hf-nav-counter">@_stats.Processing</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/scheduled">
            <i class="bi bi-clock hf-nav-icon"></i>
            <span>Scheduled</span>
            @if (_stats?.Scheduled > 0)
            {
                <span class="hf-nav-counter">@_stats.Scheduled</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/succeeded">
            <i class="bi bi-check-circle hf-nav-icon"></i>
            <span>Succeeded</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/failed">
            <i class="bi bi-x-circle hf-nav-icon"></i>
            <span>Failed</span>
            @if (_stats?.Failed > 0)
            {
                <span class="hf-nav-counter hf-nav-counter--alert">@_stats.Failed</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/deleted">
            <i class="bi bi-trash hf-nav-icon"></i>
            <span>Deleted</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/awaiting">
            <i class="bi bi-hourglass-split hf-nav-icon"></i>
            <span>Awaiting</span>
        </NavLink>
    </div>

    <!-- Management group (spacing-only separation) -->
    <div class="hf-nav-section">
        <NavLink class="hf-nav-item" href="recurring">
            <i class="bi bi-arrow-repeat hf-nav-icon"></i>
            <span>Recurring</span>
            @if (_stats?.Recurring > 0)
            {
                <span class="hf-nav-counter">@_stats.Recurring</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="servers">
            <i class="bi bi-hdd-stack hf-nav-icon"></i>
            <span>Servers</span>
            @if (_stats?.Servers > 0)
            {
                <span class="hf-nav-counter">@_stats.Servers</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="retries">
            <i class="bi bi-arrow-counterclockwise hf-nav-icon"></i>
            <span>Retries</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="tags">
            <i class="bi bi-tag hf-nav-icon"></i>
            <span>Tags</span>
            @if (_tagsCount > 0)
            {
                <span class="hf-nav-counter">@_tagsCount</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="search">
            <i class="bi bi-search hf-nav-icon"></i>
            <span>Search</span>
        </NavLink>
    </div>

    <!-- Analytics group (only shown when IStorageMetricsProvider is registered) -->
    @if (_analyticsAvailable)
    {
        <div class="hf-nav-section">
            <div class="hf-nav-section-header">Analytics</div>
            <NavLink class="hf-nav-item" href="analytics" Match="NavLinkMatch.All">
                <i class="bi bi-graph-up hf-nav-icon"></i>
                <span>Overview</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/performance">
                <i class="bi bi-speedometer2 hf-nav-icon"></i>
                <span>Performance</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/failures">
                <i class="bi bi-x-circle hf-nav-icon"></i>
                <span>Failures</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/queues">
                <i class="bi bi-inbox hf-nav-icon"></i>
                <span>Queues</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/recurring">
                <i class="bi bi-arrow-repeat hf-nav-icon"></i>
                <span>Recurring</span>
            </NavLink>
        </div>
    }
</nav>

@code {
    private StatisticsDto _stats;
    private long _tagsCount;
    private bool _analyticsAvailable;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        _analyticsAvailable = ServiceProvider.GetService<IStorageMetricsProvider>() != null;

        await LoadStats();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var stats = Monitor.GetStatistics();
                var tagsCount = TagsReader.GetTagsCount();
                await InvokeAsync(() =>
                {
                    _stats = stats;
                    _tagsCount = tagsCount;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadStats()
    {
        await Task.Run(() =>
        {
            _stats = Monitor.GetStatistics();
            _tagsCount = TagsReader.GetTagsCount();
        });
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
