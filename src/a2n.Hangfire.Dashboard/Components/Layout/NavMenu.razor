@using a2n.Hangfire.Dashboard.Interfaces
@using a2n.Hangfire.Dashboard.Services
@using Microsoft.Extensions.DependencyInjection
@inject DashboardMetricsFeed MetricsFeed
@inject TagsDataReader TagsReader
@inject ThrottlingDetectionCache ThrottlingDetection
@inject QueueOperationsStateCache StateCache
@inject MetricsQueryCache QueryCache
@inject DashboardPolling Polling
@inject IServiceProvider ServiceProvider
@inject DashboardUIOptions Options
@implements IDisposable

<nav class="hf-nav">
    <!-- Brand -->
    <div class="hf-nav-brand">
        <div class="hf-nav-brand-icon">
            <i class="bi bi-fire"></i>
        </div>
        <span class="hf-nav-brand-text">@Options.DashboardTitle</span>
    </div>

    <!-- Dashboard (standalone, no group label) -->
    <div class="hf-nav-section">
        <NavLink class="hf-nav-item" href="" Match="NavLinkMatch.All" title="Dashboard">
            <i class="bi bi-grid hf-nav-icon"></i>
            <span>Dashboard</span>
        </NavLink>
    </div>

    <!-- Jobs -->
    <div class="hf-nav-section">
        <NavMenuGroup Title="Jobs" GroupId="jobs" ExpandPaths="@_jobsExpandPaths">
        <NavLink class="hf-nav-item" href="jobs/enqueued" title="Enqueued">
            <i class="bi bi-inbox hf-nav-icon"></i>
            <span>Enqueued</span>
            @if (_stats?.Enqueued > 0)
            {
                <span class="hf-nav-counter">@_stats.Enqueued</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/processing" title="Processing">
            <i class="bi bi-gear hf-nav-icon"></i>
            <span>Processing</span>
            @if (_stats?.Processing > 0)
            {
                <span class="hf-nav-counter">@_stats.Processing</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/scheduled" title="Scheduled">
            <i class="bi bi-clock hf-nav-icon"></i>
            <span>Scheduled</span>
            @if (_stats?.Scheduled > 0)
            {
                <span class="hf-nav-counter">@_stats.Scheduled</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/succeeded" title="Succeeded">
            <i class="bi bi-check-circle hf-nav-icon"></i>
            <span>Succeeded</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/failed" title="Failed">
            <i class="bi bi-x-circle hf-nav-icon"></i>
            <span>Failed</span>
            @if (_stats?.Failed > 0)
            {
                <span class="hf-nav-counter hf-nav-counter--alert">@_stats.Failed</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/deleted" title="Deleted">
            <i class="bi bi-trash hf-nav-icon"></i>
            <span>Deleted</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/awaiting" title="Awaiting">
            <i class="bi bi-hourglass-split hf-nav-icon"></i>
            <span>Awaiting</span>
        </NavLink>
        </NavMenuGroup>
    </div>

    <!-- Management -->
    <div class="hf-nav-section">
        <NavMenuGroup Title="Management" GroupId="management" ExpandPaths="@_managementExpandPaths">
        <NavLink class="hf-nav-item" href="recurring" title="Recurring">
            <i class="bi bi-arrow-repeat hf-nav-icon"></i>
            <span>Recurring</span>
            @if (_stats?.Recurring > 0)
            {
                <span class="hf-nav-counter">@_stats.Recurring</span>
            }
        </NavLink>
        @if (Options.Heatmap.Enabled)
        {
            <NavLink class="hf-nav-item" href="heatmap" title="Schedule Heatmap">
                <i class="bi bi-grid-3x3 hf-nav-icon"></i>
                <span>Schedule Heatmap</span>
            </NavLink>
        }
        <NavLink class="hf-nav-item" href="servers" title="Servers">
            <i class="bi bi-hdd-stack hf-nav-icon"></i>
            <span>Servers</span>
            @if (_stats?.Servers > 0)
            {
                <span class="hf-nav-counter">@_stats.Servers</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="queues" title="Queues">
            <i class="bi bi-collection hf-nav-icon"></i>
            <span>Queues</span>
            @if (_pausedQueueCount > 0)
            {
                <span class="hf-nav-counter hf-nav-counter--alert">@_pausedQueueCount</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="retries" title="Retries">
            <i class="bi bi-arrow-counterclockwise hf-nav-icon"></i>
            <span>Retries</span>
        </NavLink>
        @if (_hasThrottling)
        {
            <NavLink class="hf-nav-item" href="throttling" title="Throttling">
                <i class="bi bi-sliders hf-nav-icon"></i>
                <span>Throttling</span>
            </NavLink>
        }
        <NavLink class="hf-nav-item" href="tags" title="Tags">
            <i class="bi bi-tag hf-nav-icon"></i>
            <span>Tags</span>
            @if (_tagsCount > 0)
            {
                <span class="hf-nav-counter">@_tagsCount</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="search" title="Search">
            <i class="bi bi-search hf-nav-icon"></i>
            <span>Search</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="audit" title="Audit Log">
            <i class="bi bi-clipboard-check hf-nav-icon"></i>
            <span>Audit Log</span>
        </NavLink>
        </NavMenuGroup>
    </div>

    <!-- Analytics (only when IStorageMetricsProvider is registered) -->
    @if (_analyticsAvailable)
    {
        <div class="hf-nav-section">
            <NavMenuGroup Title="Analytics" GroupId="analytics" ExpandPaths="@_analyticsExpandPaths">
            <NavLink class="hf-nav-item" href="analytics" Match="NavLinkMatch.All" title="Overview">
                <i class="bi bi-graph-up hf-nav-icon"></i>
                <span>Overview</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/performance" title="Performance">
                <i class="bi bi-speedometer2 hf-nav-icon"></i>
                <span>Performance</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/failures" title="Failures">
                <i class="bi bi-x-circle hf-nav-icon"></i>
                <span>Failures</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/queues" title="Queues">
                <i class="bi bi-inbox hf-nav-icon"></i>
                <span>Queues</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/recurring" title="Recurring">
                <i class="bi bi-arrow-repeat hf-nav-icon"></i>
                <span>Recurring</span>
            </NavLink>
            </NavMenuGroup>
        </div>
    }
</nav>

@code {
    private static readonly string[] _jobsExpandPaths = { "jobs" };
    private static readonly string[] _managementExpandPaths = { "recurring", "heatmap", "servers", "queues", "retries", "tags", "search", "audit" };
    private static readonly string[] _analyticsExpandPaths = { "analytics" };

    private StatisticsDto _stats;
    private long _tagsCount;
    private bool _hasThrottling;
    private int _pausedQueueCount;
    private bool _analyticsAvailable;
    private IDisposable _metricsSubscription;
    private DashboardPoller _slowPoller;

    protected override async Task OnInitializedAsync()
    {
        _analyticsAvailable = ServiceProvider.GetService<IStorageMetricsProvider>() != null;

        await LoadStats();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // OnAfterRender never runs during prerendering, so subscriptions and timers are only
        // set up for the interactive circuit.
        if (!firstRender) return;

        // Counters come from the in-process metrics feed (one shared storage read per interval for
        // all tabs) instead of a per-circuit GetStatistics() poll.
        _metricsSubscription ??= MetricsFeed.SubscribeMetrics(snapshot => InvokeAsync(() =>
        {
            _stats = snapshot.Statistics;
            StateHasChanged();
        }));

        // Tags count and paused-queue count aren't part of the metrics broadcast and change rarely.
        // Refresh them on a slow loop. Both reads are shared across tabs (the tags count through
        // MetricsQueryCache, the paused count through QueueOperationsStateCache), so this is cheap
        // regardless of how many tabs are open.
        _slowPoller ??= Polling.Start(nameof(NavMenu), Polling.Options.SlowPageRefreshInterval, async ct =>
        {
            var tagsCount = await GetTagsCountAsync(ct);
            var ops = await StateCache.GetAsync();
            var paused = ops.MaintenanceMode ? 0 : ops.PausedQueues.Count;
            await InvokeAsync(() =>
            {
                _tagsCount = tagsCount;
                _pausedQueueCount = paused;
                StateHasChanged();
            });
        });
    }

    private Task<long> GetTagsCountAsync(CancellationToken ct) => QueryCache.GetOrCreateAsync(
        "nav:tags-count", c => Polling.ReadAsync(() => TagsReader.GetTagsCount(), c), ct, snapshot: true);

    private async Task LoadStats()
    {
        var stats = (await MetricsFeed.GetMetricsAsync()).Statistics;
        var tagsCount = await GetTagsCountAsync(CancellationToken.None);
        // Only computed when not yet detected: the nav item appears once the host application
        // starts writing Hangfire.Throttling data and stays visible for the circuit's lifetime.
        // The read is shared across circuits, so installations without the package don't repeat it.
        var hasThrottling = _hasThrottling || await ThrottlingDetection.GetAsync();
        var ops = await StateCache.GetAsync();
        _stats = stats;
        _tagsCount = tagsCount;
        _hasThrottling = hasThrottling;
        _pausedQueueCount = ops.MaintenanceMode ? 0 : ops.PausedQueues.Count;
    }

    public void Dispose()
    {
        _metricsSubscription?.Dispose();
        _slowPoller?.Dispose();
    }
}
