@inject HangfireMonitorService Monitor
@inject TagsDataReader TagsReader
@implements IDisposable

<nav class="nav flex-column p-2">
    <!-- Brand -->
    <div class="d-flex align-items-center gap-2 px-3 py-2 mb-3">
        <i class="bi bi-fire text-warning fs-5"></i>
        <span class="fw-bold text-white">Hangfire</span>
    </div>

    <!-- Section: Overview -->
    <small class="text-uppercase text-secondary px-3 mb-1 fw-semibold"
           style="font-size: 0.65rem; letter-spacing: 0.05em;">Overview</small>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="" Match="NavLinkMatch.All">
        <i class="bi bi-grid"></i>
        <span>Dashboard</span>
    </NavLink>

    <!-- Section: Jobs -->
    <small class="text-uppercase text-secondary px-3 mt-3 mb-1 fw-semibold"
           style="font-size: 0.65rem; letter-spacing: 0.05em;">Jobs</small>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/enqueued">
        <i class="bi bi-inbox"></i>
        <span>Enqueued</span>
        @if (_stats?.Enqueued > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Enqueued</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/processing">
        <i class="bi bi-gear"></i>
        <span>Processing</span>
        @if (_stats?.Processing > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Processing</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/scheduled">
        <i class="bi bi-clock"></i>
        <span>Scheduled</span>
        @if (_stats?.Scheduled > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Scheduled</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/succeeded">
        <i class="bi bi-check-circle"></i>
        <span>Succeeded</span>
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/failed">
        <i class="bi bi-x-circle"></i>
        <span>Failed</span>
        @if (_stats?.Failed > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Failed</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/deleted">
        <i class="bi bi-trash"></i>
        <span>Deleted</span>
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="jobs/awaiting">
        <i class="bi bi-hourglass-split"></i>
        <span>Awaiting</span>
    </NavLink>

    <!-- Section: Management -->
    <small class="text-uppercase text-secondary px-3 mt-3 mb-1 fw-semibold"
           style="font-size: 0.65rem; letter-spacing: 0.05em;">Management</small>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="recurring">
        <i class="bi bi-arrow-repeat"></i>
        <span>Recurring</span>
        @if (_stats?.Recurring > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Recurring</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="servers">
        <i class="bi bi-hdd-stack"></i>
        <span>Servers</span>
        @if (_stats?.Servers > 0)
        {
            <span class="badge bg-primary ms-auto">@_stats.Servers</span>
        }
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="retries">
        <i class="bi bi-arrow-counterclockwise"></i>
        <span>Retries</span>
    </NavLink>
    <NavLink class="nav-link d-flex align-items-center gap-2 rounded px-3 py-2 text-secondary-emphasis"
             href="tags">
        <i class="bi bi-tag"></i>
        <span>Tags</span>
        @if (_tagsCount > 0)
        {
            <span class="badge bg-primary ms-auto">@_tagsCount</span>
        }
    </NavLink>
</nav>

@code {
    private StatisticsDto _stats;
    private long _tagsCount;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var stats = Monitor.GetStatistics();
                var tagsCount = TagsReader.GetTagsCount();
                await InvokeAsync(() =>
                {
                    _stats = stats;
                    _tagsCount = tagsCount;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadStats()
    {
        await Task.Run(() =>
        {
            _stats = Monitor.GetStatistics();
            _tagsCount = TagsReader.GetTagsCount();
        });
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
