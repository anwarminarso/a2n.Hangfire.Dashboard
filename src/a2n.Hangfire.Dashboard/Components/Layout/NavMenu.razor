@using a2n.Hangfire.Dashboard.Interfaces
@using a2n.Hangfire.Dashboard.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.DependencyInjection
@inject HangfireMonitorService Monitor
@inject TagsDataReader TagsReader
@inject QueueOperationsStateCache StateCache
@inject IServiceProvider ServiceProvider
@inject NavigationManager Navigation
@inject DashboardUIOptions Options
@implements IAsyncDisposable

<nav class="hf-nav">
    <!-- Brand -->
    <div class="hf-nav-brand">
        <div class="hf-nav-brand-icon">
            <i class="bi bi-fire"></i>
        </div>
        <span class="hf-nav-brand-text">@Options.DashboardTitle</span>
    </div>

    <!-- Dashboard (standalone, no group label) -->
    <div class="hf-nav-section">
        <NavLink class="hf-nav-item" href="" Match="NavLinkMatch.All">
            <i class="bi bi-grid hf-nav-icon"></i>
            <span>Dashboard</span>
        </NavLink>
    </div>

    <!-- Jobs -->
    <div class="hf-nav-section">
        <NavMenuGroup Title="Jobs" GroupId="jobs" ExpandPaths="@_jobsExpandPaths">
        <NavLink class="hf-nav-item" href="jobs/enqueued">
            <i class="bi bi-inbox hf-nav-icon"></i>
            <span>Enqueued</span>
            @if (_stats?.Enqueued > 0)
            {
                <span class="hf-nav-counter">@_stats.Enqueued</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/processing">
            <i class="bi bi-gear hf-nav-icon"></i>
            <span>Processing</span>
            @if (_stats?.Processing > 0)
            {
                <span class="hf-nav-counter">@_stats.Processing</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/scheduled">
            <i class="bi bi-clock hf-nav-icon"></i>
            <span>Scheduled</span>
            @if (_stats?.Scheduled > 0)
            {
                <span class="hf-nav-counter">@_stats.Scheduled</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/succeeded">
            <i class="bi bi-check-circle hf-nav-icon"></i>
            <span>Succeeded</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/failed">
            <i class="bi bi-x-circle hf-nav-icon"></i>
            <span>Failed</span>
            @if (_stats?.Failed > 0)
            {
                <span class="hf-nav-counter hf-nav-counter--alert">@_stats.Failed</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/deleted">
            <i class="bi bi-trash hf-nav-icon"></i>
            <span>Deleted</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="jobs/awaiting">
            <i class="bi bi-hourglass-split hf-nav-icon"></i>
            <span>Awaiting</span>
        </NavLink>
        </NavMenuGroup>
    </div>

    <!-- Management -->
    <div class="hf-nav-section">
        <NavMenuGroup Title="Management" GroupId="management" ExpandPaths="@_managementExpandPaths">
        <NavLink class="hf-nav-item" href="recurring">
            <i class="bi bi-arrow-repeat hf-nav-icon"></i>
            <span>Recurring</span>
            @if (_stats?.Recurring > 0)
            {
                <span class="hf-nav-counter">@_stats.Recurring</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="servers">
            <i class="bi bi-hdd-stack hf-nav-icon"></i>
            <span>Servers</span>
            @if (_stats?.Servers > 0)
            {
                <span class="hf-nav-counter">@_stats.Servers</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="queues">
            <i class="bi bi-collection hf-nav-icon"></i>
            <span>Queues</span>
            @if (_pausedQueueCount > 0)
            {
                <span class="hf-nav-counter hf-nav-counter--alert">@_pausedQueueCount</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="retries">
            <i class="bi bi-arrow-counterclockwise hf-nav-icon"></i>
            <span>Retries</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="tags">
            <i class="bi bi-tag hf-nav-icon"></i>
            <span>Tags</span>
            @if (_tagsCount > 0)
            {
                <span class="hf-nav-counter">@_tagsCount</span>
            }
        </NavLink>
        <NavLink class="hf-nav-item" href="search">
            <i class="bi bi-search hf-nav-icon"></i>
            <span>Search</span>
        </NavLink>
        <NavLink class="hf-nav-item" href="audit">
            <i class="bi bi-clipboard-check hf-nav-icon"></i>
            <span>Audit Log</span>
        </NavLink>
        </NavMenuGroup>
    </div>

    <!-- Analytics (only when IStorageMetricsProvider is registered) -->
    @if (_analyticsAvailable)
    {
        <div class="hf-nav-section">
            <NavMenuGroup Title="Analytics" GroupId="analytics" ExpandPaths="@_analyticsExpandPaths">
            <NavLink class="hf-nav-item" href="analytics" Match="NavLinkMatch.All">
                <i class="bi bi-graph-up hf-nav-icon"></i>
                <span>Overview</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/performance">
                <i class="bi bi-speedometer2 hf-nav-icon"></i>
                <span>Performance</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/failures">
                <i class="bi bi-x-circle hf-nav-icon"></i>
                <span>Failures</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/queues">
                <i class="bi bi-inbox hf-nav-icon"></i>
                <span>Queues</span>
            </NavLink>
            <NavLink class="hf-nav-item" href="analytics/recurring">
                <i class="bi bi-arrow-repeat hf-nav-icon"></i>
                <span>Recurring</span>
            </NavLink>
            </NavMenuGroup>
        </div>
    }
</nav>

@code {
    private static readonly string[] _jobsExpandPaths = { "jobs" };
    private static readonly string[] _managementExpandPaths = { "recurring", "servers", "queues", "retries", "tags", "search", "audit" };
    private static readonly string[] _analyticsExpandPaths = { "analytics" };

    private StatisticsDto _stats;
    private long _tagsCount;
    private int _pausedQueueCount;
    private bool _analyticsAvailable;
    private HubConnection _hubConnection;
    private Timer _fallbackTimer;
    private Timer _slowTimer;

    protected override async Task OnInitializedAsync()
    {
        _analyticsAvailable = ServiceProvider.GetService<IStorageMetricsProvider>() != null;

        await LoadStats();

        // Stats come from the centralized SignalR metrics broadcast (the same stream the Home page
        // and MetricsBroadcastService use) rather than a per-circuit GetStatistics() poll. This
        // avoids multiplying storage load by the number of open tabs.
        _hubConnection = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri("hubs/dashboard"))
            .WithAutomaticReconnect()
            .Build();

        _hubConnection.On<Dictionary<string, object>>("MetricsUpdated", async metrics =>
        {
            await InvokeAsync(() =>
            {
                ApplyMetrics(metrics);
                StateHasChanged();
            });
        });

        try
        {
            await _hubConnection.StartAsync();
            await _hubConnection.InvokeAsync("SubscribeToMetrics");
        }
        catch
        {
            // SignalR unavailable — fall back to a lightweight stats poll.
            _fallbackTimer = new Timer(async _ =>
            {
                try
                {
                    var stats = await Task.Run(() => Monitor.GetStatistics());
                    await InvokeAsync(() => { _stats = stats; StateHasChanged(); });
                }
                catch { }
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }

        // Tags count and paused-queue count aren't part of the metrics broadcast and change rarely.
        // Refresh them on a slow timer; the paused count reads the shared (cached) state, so this is
        // cheap regardless of how many tabs are open.
        _slowTimer = new Timer(async _ =>
        {
            try
            {
                var tagsCount = await Task.Run(() => TagsReader.GetTagsCount());
                var ops = await StateCache.GetAsync();
                var paused = ops.MaintenanceMode ? 0 : ops.PausedQueues.Count;
                await InvokeAsync(() =>
                {
                    _tagsCount = tagsCount;
                    _pausedQueueCount = paused;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private void ApplyMetrics(Dictionary<string, object> metrics)
    {
        _stats ??= new StatisticsDto();
        _stats.Enqueued = GetLong(metrics, "enqueued");
        _stats.Processing = GetLong(metrics, "processing");
        _stats.Scheduled = GetLong(metrics, "scheduled");
        _stats.Failed = GetLong(metrics, "failed");
        _stats.Recurring = GetLong(metrics, "recurring");
        _stats.Servers = GetLong(metrics, "servers");
    }

    private static long GetLong(Dictionary<string, object> metrics, string key)
    {
        if (!metrics.TryGetValue(key, out var value) || value is null) return 0;
        if (value is System.Text.Json.JsonElement json)
            return json.TryGetInt64(out var l) ? l : 0;
        return Convert.ToInt64(value);
    }

    private async Task LoadStats()
    {
        var stats = await Task.Run(() => Monitor.GetStatistics());
        var tagsCount = await Task.Run(() => TagsReader.GetTagsCount());
        var ops = await StateCache.GetAsync();
        _stats = stats;
        _tagsCount = tagsCount;
        _pausedQueueCount = ops.MaintenanceMode ? 0 : ops.PausedQueues.Count;
    }

    public async ValueTask DisposeAsync()
    {
        _fallbackTimer?.Dispose();
        _slowTimer?.Dispose();
        if (_hubConnection is not null)
        {
            try { await _hubConnection.DisposeAsync(); }
            catch { }
        }
    }
}
