@inject HangfireMonitorService Monitor
@inject TagsDataReader TagsReader
@implements IDisposable

<nav class="nav-menu">
    <div class="nav-brand">
        <span class="brand-icon">@Icons.Flame</span>
        <span class="brand-text">Hangfire</span>
    </div>

    <div class="nav-section">
        <span class="nav-section-title">Overview</span>
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
            <span class="nav-icon">@Icons.Dashboard</span>
            <span class="nav-label">Dashboard</span>
        </NavLink>
    </div>

    <div class="nav-section">
        <span class="nav-section-title">Jobs</span>
        <NavLink class="nav-item" href="jobs/enqueued">
            <span class="nav-icon">@Icons.Inbox</span>
            <span class="nav-label">Enqueued</span>
            @if (_stats?.Enqueued > 0)
            {
                <span class="nav-badge nav-badge--info">@_stats.Enqueued</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="jobs/processing">
            <span class="nav-icon">@Icons.Cog</span>
            <span class="nav-label">Processing</span>
            @if (_stats?.Processing > 0)
            {
                <span class="nav-badge nav-badge--warning">@_stats.Processing</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="jobs/scheduled">
            <span class="nav-icon">@Icons.Clock</span>
            <span class="nav-label">Scheduled</span>
            @if (_stats?.Scheduled > 0)
            {
                <span class="nav-badge">@_stats.Scheduled</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="jobs/succeeded">
            <span class="nav-icon">@Icons.CheckCircle</span>
            <span class="nav-label">Succeeded</span>
        </NavLink>
        <NavLink class="nav-item" href="jobs/failed">
            <span class="nav-icon">@Icons.XCircle</span>
            <span class="nav-label">Failed</span>
            @if (_stats?.Failed > 0)
            {
                <span class="nav-badge nav-badge--danger">@_stats.Failed</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="jobs/deleted">
            <span class="nav-icon">@Icons.Trash2</span>
            <span class="nav-label">Deleted</span>
        </NavLink>
        <NavLink class="nav-item" href="jobs/awaiting">
            <span class="nav-icon">@Icons.Hourglass</span>
            <span class="nav-label">Awaiting</span>
        </NavLink>
    </div>

    <div class="nav-section">
        <span class="nav-section-title">Management</span>
        <NavLink class="nav-item" href="recurring">
            <span class="nav-icon">@Icons.Repeat</span>
            <span class="nav-label">Recurring</span>
            @if (_stats?.Recurring > 0)
            {
                <span class="nav-badge">@_stats.Recurring</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="servers">
            <span class="nav-icon">@Icons.Server</span>
            <span class="nav-label">Servers</span>
            @if (_stats?.Servers > 0)
            {
                <span class="nav-badge">@_stats.Servers</span>
            }
        </NavLink>
        <NavLink class="nav-item" href="retries">
            <span class="nav-icon">@Icons.RotateCcw</span>
            <span class="nav-label">Retries</span>
        </NavLink>
        <NavLink class="nav-item" href="tags">
            <span class="nav-icon">@Icons.Tag</span>
            <span class="nav-label">Tags</span>
            @if (_tagsCount > 0)
            {
                <span class="nav-badge">@_tagsCount</span>
            }
        </NavLink>
    </div>
</nav>

@code {
    private StatisticsDto _stats;
    private long _tagsCount;
    private Timer _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();

        _refreshTimer = new Timer(async _ =>
        {
            try
            {
                var stats = Monitor.GetStatistics();
                var tagsCount = TagsReader.GetTagsCount();
                await InvokeAsync(() =>
                {
                    _stats = stats;
                    _tagsCount = tagsCount;
                    StateHasChanged();
                });
            }
            catch { }
        }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadStats()
    {
        await Task.Run(() =>
        {
            _stats = Monitor.GetStatistics();
            _tagsCount = TagsReader.GetTagsCount();
        });
    }

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
