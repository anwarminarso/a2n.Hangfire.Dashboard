<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>a2n.Hangfire.Dashboard.OpenTelemetry</RootNamespace>
    <PackageId>a2n.Hangfire.Dashboard.OpenTelemetry</PackageId>
    <Description>OpenTelemetry trace-linking integration for a2n.Hangfire.Dashboard. Captures the ambient W3C traceparent when a job is enqueued and restores it as a child execution span via a named ActivitySource, so enqueue-to-execute appears as a single distributed trace. Opt-in; does not reference the core dashboard package.</Description>
    <PackageTags>hangfire;dashboard;opentelemetry;otel;tracing;distributed-tracing;traceparent;w3c;activitysource;aspnetcore;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.*" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.*" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.*" Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked copy of the core W3C traceparent codec so both sides agree on the wire format,
         without taking a reference on the core dashboard package (Req 15.4). -->
    <Compile Include="..\a2n.Hangfire.Dashboard\Internal\W3CTraceParent.cs" Link="Internal\W3CTraceParent.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
