<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hangfire.Tags</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>Drop-in replacement for Hangfire.Tags — adds tagging support to Hangfire jobs. Features auto-tagging via attributes, runtime tag management, tag cloud visualization, and search by tag. Storage-agnostic (works with any Hangfire storage provider). Same namespace and API as the original — just swap the NuGet package.</Description>
    <PackageId>a2n.Hangfire.Tags</PackageId>
    <PackageTags>hangfire;tags;tagging;background-jobs;job-management;search;filtering;categorization;aspnetcore;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
