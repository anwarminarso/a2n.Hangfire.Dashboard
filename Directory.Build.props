<Project>
  <PropertyGroup>
    <Version>2.2.1</Version>
    <Authors>a2n</Authors>
    <RepositoryUrl>https://github.com/anwarminarso/a2n.Hangfire.Dashboard</RepositoryUrl>
    <PackageProjectUrl>https://github.com/anwarminarso/a2n.Hangfire.Dashboard</PackageProjectUrl>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Force Newtonsoft.Json to a non-vulnerable version (transitive from Hangfire.Core) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.*" />
  </ItemGroup>
</Project>
